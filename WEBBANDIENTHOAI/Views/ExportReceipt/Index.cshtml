@model WEBBANDIENTHOAI.Repository.Admin.PagedResult<WEBBANDIENTHOAI.Models.ExportReceipt>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản Lý Phiếu Xuất Kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#10b981",
                        "background-light": "#f0fdf4",
                        "text-light-primary": "#065f46",
                        "text-light-secondary": "#059669",
                        "surface-light": "#d1fae5"
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Inter', sans-serif !important;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                background: white !important;
            }
        }
    </style>
}

<div class="relative min-h-screen w-full bg-background-light">
    <main class="w-full p-6 lg:p-8">
        <div class="w-full max-w-full mx-auto">
            <!-- Page Header -->
            <div class="flex flex-wrap justify-between gap-4 mb-8">
                <div class="flex flex-col gap-2">
                    <p class="text-text-light-primary text-4xl font-black leading-tight tracking-[-0.033em]">
                        📦 Quản Lý Phiếu Xuất Kho
                    </p>
                    <p class="text-text-light-secondary text-base font-normal leading-normal">
                        Xem và quản lý các phiếu xuất kho hàng. Tổng cộng: <strong>@Model.TotalCount</strong> phiếu
                    </p>
                </div>
                <div class="flex gap-2">
                    <a href="@Url.Action("Index", "Order")"
                       class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-blue-500 text-white gap-2 text-sm font-bold leading-normal hover:bg-blue-600 transition-colors">
                        <span class="material-symbols-outlined text-base">arrow_back</span>
                        <span class="truncate">Quay lại Đơn hàng</span>
                    </a>
                    <button onclick="window.print()"
                            class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-surface-light text-text-light-primary gap-2 text-sm font-bold leading-normal hover:bg-surface-light/80 transition-colors">
                        <span class="material-symbols-outlined text-base">download</span>
                        <span class="truncate">Xuất Excel</span>
                    </button>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-primary uppercase mb-1">Tổng Phiếu</p>
                            <p class="text-2xl font-black text-text-light-primary">@Model.TotalCount</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-gray-300">inventory_2</span>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-blue-600 uppercase mb-1">Tổng Số Lượng</p>
                            <p class="text-2xl font-black text-text-light-primary">@Model.Items.Sum(e => e.TotalQuantity)</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-gray-300">shopping_cart</span>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-green-600 uppercase mb-1">Tổng Giá Trị</p>
                            <p class="text-xl font-black text-text-light-primary">@Model.Items.Sum(e => e.TotalValue).ToString("N0")đ</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-gray-300">payments</span>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-purple-600 uppercase mb-1">Hôm Nay</p>
                            <p class="text-2xl font-black text-text-light-primary">
                                @Model.Items.Count(e => e.ExportDate.Date == DateTime.Now.Date)
                            </p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-gray-300">today</span>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="mt-8 p-4 bg-white rounded-xl shadow-sm border border-surface-light">
                <form method="get" class="flex flex-wrap items-center gap-4">
                    <input type="hidden" name="__RequestVerificationToken" value="@tokenSet.RequestToken" />
                    <div class="flex-grow md:flex-grow-0 min-w-[250px]">
                        <input name="search" value="@ViewBag.Search"
                               class="form-input w-full rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary"
                               placeholder="Tìm theo mã phiếu, khách hàng..." />
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-text-light-primary">Từ</label>
                        <input class="form-input rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary"
                               name="fromDate" type="date" value="@ViewBag.FromDate" />
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-text-light-primary">Đến</label>
                        <input class="form-input rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary"
                               name="toDate" type="date" value="@ViewBag.ToDate" />
                    </div>
                    <div class="flex-grow md:flex-grow-0">
                        <select name="sortBy" class="form-select w-full md:w-auto rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary">
                            <option value="newest" selected="@(ViewBag.SortBy == "newest")">Mới nhất</option>
                            <option value="oldest" selected="@(ViewBag.SortBy == "oldest")">Cũ nhất</option>
                            <option value="highest" selected="@(ViewBag.SortBy == "highest")">Giá trị cao nhất</option>
                        </select>
                    </div>
                    <button type="submit" class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-5 bg-primary text-white text-sm font-bold leading-normal hover:bg-primary/90 transition-colors">
                        <span class="truncate">Áp dụng</span>
                    </button>
                </form>
            </div>

            <!-- Export Receipts Table -->
            <div class="mt-6 bg-white rounded-xl shadow-sm border border-surface-light overflow-hidden">
                <div class="overflow-y-auto max-h-[55vh]">
                    <div class="overflow-x-auto">
                        @if (!Model.Items.Any())
                        {
                            <div class="text-center py-12">
                                <span class="material-symbols-outlined text-6xl text-gray-300 mb-3">inventory_2</span>
                                <h5 class="text-xl font-semibold text-gray-500 mb-2">Chưa có phiếu xuất nào</h5>
                                <p class="text-text-light-secondary">Phiếu xuất kho sẽ được tạo tự động khi xuất hàng từ đơn hàng</p>
                            </div>
                        }
                        else
                        {
                            <table class="w-full text-sm text-left text-text-light-secondary">
                                <thead class="text-xs text-text-light-secondary uppercase bg-background-light sticky top-0">
                                    <tr>
                                        <th class="px-6 py-3">Mã Phiếu</th>
                                        <th class="px-6 py-3">Ngày Xuất</th>
                                        <th class="px-6 py-3">Khách Hàng</th>
                                        <th class="px-6 py-3">Đơn Hàng</th>
                                        <th class="px-6 py-3 text-center">Số Lượng</th>
                                        <th class="px-6 py-3 text-right">Giá Trị</th>
                                        <th class="px-6 py-3">Người Tạo</th>
                                        <th class="px-6 py-3 text-right">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var receipt in Model.Items)
                                    {
                                        <tr class="bg-white border-b hover:bg-surface-light/50">
                                            <td class="px-6 py-4 font-bold text-primary whitespace-nowrap">
                                                @receipt.ReceiptNumber
                                            </td>
                                            <td class="px-6 py-4">
                                                @receipt.ExportDate.ToString("dd/MM/yyyy")
                                                <br />
                                                <small class="text-text-light-secondary">@receipt.ExportDate.ToString("HH:mm")</small>
                                            </td>
                                            <td class="px-6 py-4 font-medium">
                                                @(receipt.Customer?.FullName ?? "N/A")
                                            </td>
                                            <td class="px-6 py-4">
                                                @if (receipt.OrderId.HasValue)
                                                {
                                                    <a href="@Url.Action("Index", "Order", new { search = receipt.OrderId })"
                                                       class="text-blue-600 hover:underline font-semibold">
                                                        #@receipt.OrderId
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-400">---</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-flex items-center justify-center w-10 h-10 bg-blue-100 text-blue-800 font-bold rounded-full">
                                                    @receipt.TotalQuantity
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right font-bold text-green-600">
                                                @receipt.TotalValue.ToString("N0")đ
                                            </td>
                                            <td class="px-6 py-4 text-sm">
                                                @(receipt.CreatedByUser?.FullName ?? "N/A")
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <button onclick="openExportDetailsModal(@receipt.ExportReceiptId)"
                                                        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-semibold hover:bg-primary/90 transition-colors">
                                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                                    Chi tiết
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="mt-6 flex justify-center items-center gap-2">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-sortBy="@ViewBag.SortBy"
                           class="px-4 py-2 rounded-lg bg-white border border-surface-light text-text-light-primary hover:bg-surface-light">
                            Trước
                        </a>
                    }

                    <span class="px-4 py-2 text-text-light-primary font-medium">
                        Trang @ViewBag.CurrentPage / @Model.TotalPages
                    </span>

                    @if (ViewBag.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-sortBy="@ViewBag.SortBy"
                           class="px-4 py-2 rounded-lg bg-white border border-surface-light text-text-light-primary hover:bg-surface-light">
                            Sau
                        </a>
                    }
                </div>
            }
        </div>
    </main>
</div>

<!-- ================== MODAL POPUP CHI TIẾT PHIẾU XUẤT ================== -->
<div id="exportDetailsModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-5xl mx-auto transform transition-all duration-300" id="exportDetailsContent">
            <!-- Header màu XANH LÁ -->
            <div class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-t-2xl p-6">
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-white text-4xl">receipt_long</span>
                        <div>
                            <h3 class="text-2xl font-bold text-white">Chi Tiết Phiếu Xuất Kho</h3>
                            <p class="text-green-100 text-sm" id="exportReceiptNumber">Mã phiếu: ---</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeExportDetailsModal()" class="text-white hover:bg-white/20 rounded-full p-2 transition-all">
                        <span class="material-symbols-outlined text-3xl">close</span>
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="p-6 max-h-[70vh] overflow-y-auto">
                <!-- Loading State -->
                <div id="exportDetailsLoading" class="text-center py-12">
                    <svg class="animate-spin h-12 w-12 text-green-500 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="text-text-light-secondary">Đang tải dữ liệu...</p>
                </div>

                <!-- Content Container -->
                <div id="exportDetailsContainer" class="hidden">
                    <!-- Thông tin -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <!-- Khách hàng -->
                        <div class="bg-green-50 rounded-xl p-5 border-l-4 border-green-500">
                            <h3 class="font-bold text-lg text-gray-800 mb-3 flex items-center gap-2">
                                <span class="material-symbols-outlined text-green-600">person</span>
                                Khách Hàng
                            </h3>
                            <div class="space-y-2 text-sm">
                                <p><span class="text-gray-600">Họ tên:</span> <span class="font-semibold" id="exportCustomerName">---</span></p>
                                <p><span class="text-gray-600">SĐT:</span> <span class="font-semibold" id="exportCustomerPhone">---</span></p>
                                <p><span class="text-gray-600">Email:</span> <span class="font-semibold" id="exportCustomerEmail">---</span></p>
                            </div>
                        </div>

                        <!-- Thông tin phiếu -->
                        <div class="bg-blue-50 rounded-xl p-5 border-l-4 border-blue-500">
                            <h3 class="font-bold text-lg text-gray-800 mb-3 flex items-center gap-2">
                                <span class="material-symbols-outlined text-blue-600">description</span>
                                Thông Tin Phiếu
                            </h3>
                            <div class="space-y-2 text-sm">
                                <p><span class="text-gray-600">Đơn hàng:</span> <span class="font-semibold" id="exportOrderLink">---</span></p>
                                <p><span class="text-gray-600">Ngày xuất:</span> <span class="font-semibold" id="exportDate">---</span></p>
                                <p><span class="text-gray-600">Người tạo:</span> <span class="font-semibold" id="exportCreatedBy">---</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Ghi chú -->
                    <div id="exportNotesSection" class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-6 hidden">
                        <div class="flex gap-2">
                            <span class="material-symbols-outlined text-yellow-700">note</span>
                            <div>
                                <p class="font-semibold text-yellow-900 mb-1">Ghi chú</p>
                                <p class="text-sm text-yellow-800" id="exportNotes">---</p>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div class="bg-white rounded-xl border-2 border-surface-light mb-6">
                        <div class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-5 py-3 rounded-t-xl">
                            <h4 class="font-bold text-lg flex items-center gap-2">
                                <span class="material-symbols-outlined">inventory_2</span>
                                Sản Phẩm Xuất Kho
                            </h4>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-green-50 text-green-800">
                                    <tr>
                                        <th class="px-4 py-3 text-left">STT</th>
                                        <th class="px-4 py-3 text-left">Mã Kho</th>
                                        <th class="px-4 py-3 text-left">Sản Phẩm</th>
                                        <th class="px-4 py-3 text-center">SL</th>
                                        <th class="px-4 py-3 text-right">Đơn Giá</th>
                                        <th class="px-4 py-3 text-right">Thành Tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="exportProductsList" class="divide-y divide-surface-light">
                                    <!-- Products will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tổng kết -->
                    <div class="bg-gradient-to-br from-green-50 to-emerald-100 rounded-xl p-6 border-2 border-green-300">
                        <div class="space-y-3">
                            <div class="flex justify-between items-center text-lg">
                                <span class="font-semibold text-gray-700">Tổng số lượng:</span>
                                <span class="font-bold text-gray-900" id="exportTotalQty">0</span>
                            </div>
                            <div class="flex justify-between items-center text-2xl border-t-2 border-green-300 pt-3">
                                <span class="font-bold text-green-900 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-3xl">paid</span>
                                    Tổng giá trị:
                                </span>
                                <span class="font-black text-green-700" id="exportTotalValue">0đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="no-print bg-surface-light px-6 py-4 rounded-b-2xl flex justify-end gap-3">
                <button type="button" onclick="printExportReceipt()"
                        class="px-6 py-3 rounded-xl bg-blue-500 text-white font-semibold hover:bg-blue-600 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined">print</span>
                    In phiếu
                </button>
                <button type="button" onclick="closeExportDetailsModal()"
                        class="px-6 py-3 rounded-xl bg-gray-500 text-white font-semibold hover:bg-gray-600 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined">close</span>
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Mở modal chi tiết phiếu xuất
    async function openExportDetailsModal(exportReceiptId) {
        const modal = document.getElementById('exportDetailsModal');
        const loading = document.getElementById('exportDetailsLoading');
        const content = document.getElementById('exportDetailsContainer');

        // Hiện modal
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Reset state
        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            // ✅ GỌI ĐÚNG API ENDPOINT
            const response = await fetch(`/Admin/ExportReceipt/GetDetails/${exportReceiptId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const receipt = await response.json();

            // Kiểm tra nếu có lỗi từ server
            if (receipt.success === false) {
                throw new Error(receipt.message || 'Không thể tải dữ liệu');
            }

            // Cập nhật thông tin header
            document.getElementById('exportReceiptNumber').textContent = `Mã phiếu: ${receipt.receiptNumber}`;

            // Thông tin khách hàng
            document.getElementById('exportCustomerName').textContent = receipt.customer?.fullName || 'N/A';
            document.getElementById('exportCustomerPhone').textContent = receipt.customer?.phone || 'N/A';
            document.getElementById('exportCustomerEmail').textContent = receipt.customer?.email || 'N/A';

            // Thông tin đơn hàng
            if (receipt.orderId) {
                document.getElementById('exportOrderLink').innerHTML = `<a href="/Admin/Order?search=${receipt.orderId}" class="text-blue-600 hover:underline">#${receipt.orderId}</a>`;
            } else {
                document.getElementById('exportOrderLink').textContent = 'N/A';
            }

            // Ngày xuất và người tạo
            document.getElementById('exportDate').textContent = new Date(receipt.exportDate).toLocaleString('vi-VN');
            document.getElementById('exportCreatedBy').textContent = receipt.createdByUser?.fullName || 'N/A';

            // Ghi chú (nếu có)
            const notesSection = document.getElementById('exportNotesSection');
            if (receipt.notes && receipt.notes.trim() !== '') {
                notesSection.classList.remove('hidden');
                document.getElementById('exportNotes').textContent = receipt.notes;
            } else {
                notesSection.classList.add('hidden');
            }

            // Render danh sách sản phẩm
            const productsList = document.getElementById('exportProductsList');
            if (receipt.exportReceiptDetails && receipt.exportReceiptDetails.length > 0) {
                let stt = 1;
                productsList.innerHTML = receipt.exportReceiptDetails.map(item => `
                    <tr class="hover:bg-green-50">
                        <td class="px-4 py-3 font-semibold">${stt++}</td>
                        <td class="px-4 py-3">
                            <span class="font-mono text-xs bg-gray-100 px-2 py-1 rounded">${item.stockCode || 'N/A'}</span>
                        </td>
                        <td class="px-4 py-3">
                            <p class="font-semibold text-gray-800">${item.snapshotName || 'N/A'}</p>
                            <p class="text-xs text-gray-500">SKU: ${item.snapshotSKU || 'N/A'}</p>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center justify-center w-10 h-10 bg-green-500 text-white font-bold rounded-full">
                                ${item.quantity}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right font-semibold">${item.unitPrice.toLocaleString('vi-VN')}đ</td>
                        <td class="px-4 py-3 text-right font-bold text-green-600">${item.totalPrice.toLocaleString('vi-VN')}đ</td>
                    </tr>
                `).join('');
            } else {
                productsList.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">Không có sản phẩm</td></tr>';
            }

            // Tổng kết
            document.getElementById('exportTotalQty').textContent = `${receipt.totalQuantity} sản phẩm`;
            document.getElementById('exportTotalValue').textContent = receipt.totalValue.toLocaleString('vi-VN') + 'đ';

            // Hiện content, ẩn loading
            loading.classList.add('hidden');
            content.classList.remove('hidden');

        } catch (error) {
            console.error('Error loading export details:', error);

            // Hiện thông báo lỗi
            loading.innerHTML = `
                <div class="text-center py-8">
                    <span class="material-symbols-outlined text-6xl text-red-500 mb-3">error</span>
                    <h5 class="text-xl font-semibold text-red-600 mb-2">Có lỗi xảy ra</h5>
                    <p class="text-text-light-secondary mb-4">${error.message}</p>
                    <button onclick="closeExportDetailsModal()"
                            class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Đóng
                    </button>
                </div>
            `;
        }
    }

    // Đóng modal
    function closeExportDetailsModal() {
        const modal = document.getElementById('exportDetailsModal');
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // In phiếu xuất
    function printExportReceipt() {
        window.print();
    }

    // Click outside để đóng modal
    document.getElementById('exportDetailsModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeExportDetailsModal();
        }
    });

    // Nhấn ESC để đóng modal
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {   
            const modal = document.getElementById('exportDetailsModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeExportDetailsModal();
            }
        }
    });
</script>