@model WEBBANDIENTHOAI.Repository.Admin.PagedResult<WEBBANDIENTHOAI.Models.ExportReceipt>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản Lý Phiếu Xuất Kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
}

<div class="category-management">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Quản lý Phiếu Xuất Kho</h1>
                <p class="text-sm text-gray-500 mt-1">Xem và quản lý các phiếu xuất kho hàng. Tổng cộng: <strong>@Model.TotalCount</strong> phiếu</p>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="bg-transparent p-0 mb-6">
        <form method="get" class="flex flex-wrap gap-4 items-center">
            <input type="hidden" name="__RequestVerificationToken" value="@tokenSet.RequestToken" />
            
            <div class="relative flex-1 min-w-[250px]">
                <span class="material-symbols-outlined absolute left-0 top-1/2 -translate-y-1/2 text-gray-400">search</span>
                <input name="search" value="@ViewBag.Search" placeholder="Tìm mã phiếu, khách hàng..." 
                       class="w-full pl-8 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 text-black" />
            </div>

            <div class="flex items-center gap-2">
                <label class="text-sm font-semibold text-gray-700">Từ</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" 
                       class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black focus:outline-none focus:border-emerald-500" />
            </div>

            <div class="flex items-center gap-2">
                <label class="text-sm font-semibold text-gray-700">Đến</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" 
                       class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black focus:outline-none focus:border-emerald-500" />
            </div>

            <select name="sortBy" class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black focus:outline-none focus:border-emerald-500">
                <option value="newest" selected="@(ViewBag.SortBy == "newest")">Mới nhất</option>
                <option value="oldest" selected="@(ViewBag.SortBy == "oldest")">Cũ nhất</option>
                <option value="highest" selected="@(ViewBag.SortBy == "highest")">Giá trị cao nhất</option>
            </select>

            <button type="submit" class="px-6 py-2 bg-gray-800 text-white rounded text-xs font-bold hover:bg-black transition-colors tracking-widest uppercase">
                Áp dụng
            </button>
        </form>
    </div>

    <!-- Main Content -->
    <div class="bg-white border border-gray-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-300" id="exportReceiptTable">
                <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mã Phiếu</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Ngày Xuất</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Khách Hàng</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Đơn Hàng</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-center border-r border-gray-300">Số Lượng</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-right border-r border-gray-300">Giá Trị</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Người Tạo</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-right">Hành Động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">inventory_2</span>
                                <p>Không tìm thấy phiếu xuất kho nào.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var receipt in Model.Items)
                        {
                            <tr class="export-receipt-row border-b border-gray-300 hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 border-r border-gray-300">
                                    <span class="font-bold text-emerald-700">#@receipt.ReceiptNumber</span>
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">
                                    <div class="font-semibold">@receipt.ExportDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-xs text-gray-500">@receipt.ExportDate.ToString("HH:mm")</div>
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-black font-medium">
                                    @(receipt.Customer?.FullName ?? "N/A")
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">
                                    @if (receipt.OrderId.HasValue)
                                    {
                                        <a href="@Url.Action("Index", "Order", new { search = receipt.OrderId })"
                                           class="text-blue-600 hover:underline font-semibold">
                                            #@receipt.OrderId
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">---</span>
                                    }
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-center">
                                    <span class="inline-flex items-center justify-center px-3 py-1 bg-blue-100 text-blue-800 font-bold rounded text-sm">
                                        @receipt.TotalQuantity
                                    </span>
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-right text-black font-bold">
                                    @receipt.TotalValue.ToString("N0")đ
                                </td>
                                <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">
                                    @(receipt.CreatedByUser?.FullName ?? "N/A")
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" onclick="openExportDetailsModal(@receipt.ExportReceiptId)"
                                            class="p-1 px-2 text-emerald-700 bg-emerald-100 hover:bg-emerald-200 border border-emerald-300 rounded text-xs font-bold uppercase transition-colors">
                                        Xem
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-8 flex justify-center items-center gap-4 py-4 border-t border-gray-200">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-fromDate="@ViewBag.FromDate"
                   asp-route-toDate="@ViewBag.ToDate"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                    Trước
                </a>
            }

            <div class="flex items-center gap-1">
                <span class="text-lg font-black text-gray-900">@ViewBag.CurrentPage</span>
                <span class="text-sm font-bold text-gray-400">/</span>
                <span class="text-sm font-bold text-gray-400">@Model.TotalPages</span>
            </div>

            @if (ViewBag.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-fromDate="@ViewBag.FromDate"
                   asp-route-toDate="@ViewBag.ToDate"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                    Sau
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                </a>
            }
        </div>
    }
</div>
        </div>
    </main>
</div>

<!-- ================== MODAL POPUP CHI TIẾT PHIẾU XUẤT ================== -->
<div id="exportDetailsModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white border border-gray-300 rounded-lg shadow-lg w-full max-w-4xl mx-auto" id="exportDetailsContent">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center bg-gray-100">
                <h3 class="text-lg font-bold text-gray-900">Chi Tiết Phiếu Xuất Kho</h3>
                <button type="button" onclick="closeExportDetailsModal()" class="text-gray-500 hover:text-gray-700 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Content -->
            <div class="p-6 max-h-[70vh] overflow-y-auto">
                <!-- Loading State -->
                <div id="exportDetailsLoading" class="text-center py-12">
                    <svg class="animate-spin h-12 w-12 text-gray-400 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="text-gray-500">Đang tải dữ liệu...</p>
                </div>

                <!-- Content Container -->
                <div id="exportDetailsContainer" class="hidden">
                    <!-- Thông tin: 2 cột -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <!-- Khách hàng -->
                        <div class="bg-gray-50 border border-gray-200 rounded p-4">
                            <h4 class="font-bold text-gray-900 mb-3">Khách Hàng</h4>
                            <div class="space-y-2 text-sm">
                                <p><span class="text-gray-600">Họ tên:</span> <span class="font-semibold text-black" id="exportCustomerName">---</span></p>
                                <p><span class="text-gray-600">SĐT:</span> <span class="font-semibold text-black" id="exportCustomerPhone">---</span></p>
                                <p><span class="text-gray-600">Email:</span> <span class="font-semibold text-black" id="exportCustomerEmail">---</span></p>
                            </div>
                        </div>

                        <!-- Thông tin phiếu -->
                        <div class="bg-gray-50 border border-gray-200 rounded p-4">
                            <h4 class="font-bold text-gray-900 mb-3">Thông Tin Phiếu</h4>
                            <div class="space-y-2 text-sm">
                                <p><span class="text-gray-600">Mã phiếu:</span> <span class="font-semibold text-black" id="exportReceiptNumber">---</span></p>
                                <p><span class="text-gray-600">Đơn hàng:</span> <span class="font-semibold text-black" id="exportOrderLink">---</span></p>
                                <p><span class="text-gray-600">Ngày xuất:</span> <span class="font-semibold text-black" id="exportDate">---</span></p>
                                <p><span class="text-gray-600">Người tạo:</span> <span class="font-semibold text-black" id="exportCreatedBy">---</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Ghi chú -->
                    <div id="exportNotesSection" class="bg-yellow-50 border border-yellow-200 rounded p-4 mb-6 hidden">
                        <p class="font-semibold text-yellow-900 mb-2">Ghi chú</p>
                        <p class="text-sm text-gray-800" id="exportNotes">---</p>
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div class="mb-6">
                        <h4 class="font-bold text-gray-900 mb-3">Sản Phẩm Xuất Kho</h4>
                        <div class="border border-gray-300 overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-100 border-b border-gray-300">
                                    <tr>
                                        <th class="px-4 py-3 text-left text-xs font-bold text-black uppercase">STT</th>
                                        <th class="px-4 py-3 text-left text-xs font-bold text-black uppercase">Mã Kho</th>
                                        <th class="px-4 py-3 text-left text-xs font-bold text-black uppercase">Sản Phẩm</th>
                                        <th class="px-4 py-3 text-center text-xs font-bold text-black uppercase">SL</th>
                                        <th class="px-4 py-3 text-right text-xs font-bold text-black uppercase">Đơn Giá</th>
                                        <th class="px-4 py-3 text-right text-xs font-bold text-black uppercase">Thành Tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="exportProductsList" class="divide-y divide-gray-200">
                                    <!-- Products will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tổng kết -->
                    <div class="bg-gray-50 border border-gray-200 rounded p-4">
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-700 font-semibold">Tổng số lượng:</span>
                                <span class="font-bold text-black text-lg" id="exportTotalQty">0</span>
                            </div>
                            <div class="flex justify-between items-center border-t border-gray-300 pt-3">
                                <span class="font-bold text-gray-900">Tổng giá trị:</span>
                                <span class="font-bold text-black text-lg" id="exportTotalValue">0đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="no-print px-6 py-4 border-t border-gray-200 bg-gray-50 flex justify-end gap-3">
                <button type="button" onclick="printExportReceipt()"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">print</span>
                    In
                </button>
                <button type="button" onclick="closeExportDetailsModal()"
                        class="px-4 py-2 bg-gray-400 hover:bg-gray-500 text-white text-sm font-bold rounded transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">close</span>
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Mở modal chi tiết phiếu xuất
    async function openExportDetailsModal(exportReceiptId) {
        const modal = document.getElementById('exportDetailsModal');
        const loading = document.getElementById('exportDetailsLoading');
        const content = document.getElementById('exportDetailsContainer');

        // Hiện modal
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Reset state
        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            // ✅ GỌI ĐÚNG API ENDPOINT
            const response = await fetch(`/Admin/ExportReceipt/GetDetails/${exportReceiptId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const receipt = await response.json();

            // Kiểm tra nếu có lỗi từ server
            if (receipt.success === false) {
                throw new Error(receipt.message || 'Không thể tải dữ liệu');
            }

            // Cập nhật thông tin header
            document.getElementById('exportReceiptNumber').textContent = `Mã phiếu: ${receipt.receiptNumber}`;

            // Thông tin khách hàng
            document.getElementById('exportCustomerName').textContent = receipt.customer?.fullName || 'N/A';
            document.getElementById('exportCustomerPhone').textContent = receipt.customer?.phone || 'N/A';
            document.getElementById('exportCustomerEmail').textContent = receipt.customer?.email || 'N/A';

            // Thông tin đơn hàng
            if (receipt.orderId) {
                document.getElementById('exportOrderLink').innerHTML = `<a href="/Admin/Order?search=${receipt.orderId}" class="text-blue-600 hover:underline">#${receipt.orderId}</a>`;
            } else {
                document.getElementById('exportOrderLink').textContent = 'N/A';
            }

            // Ngày xuất và người tạo
            document.getElementById('exportDate').textContent = new Date(receipt.exportDate).toLocaleString('vi-VN');
            document.getElementById('exportCreatedBy').textContent = receipt.createdByUser?.fullName || 'N/A';

            // Ghi chú (nếu có)
            const notesSection = document.getElementById('exportNotesSection');
            if (receipt.notes && receipt.notes.trim() !== '') {
                notesSection.classList.remove('hidden');
                document.getElementById('exportNotes').textContent = receipt.notes;
            } else {
                notesSection.classList.add('hidden');
            }

            // Render danh sách sản phẩm
            const productsList = document.getElementById('exportProductsList');
            if (receipt.exportReceiptDetails && receipt.exportReceiptDetails.length > 0) {
                let stt = 1;
                productsList.innerHTML = receipt.exportReceiptDetails.map(item => `
                    <tr class="hover:bg-green-50">
                        <td class="px-4 py-3 font-semibold">${stt++}</td>
                        <td class="px-4 py-3">
                            <span class="font-mono text-xs bg-gray-100 px-2 py-1 rounded">${item.stockCode || 'N/A'}</span>
                        </td>
                        <td class="px-4 py-3">
                            <p class="font-semibold text-gray-800">${item.snapshotName || 'N/A'}</p>
                            <p class="text-xs text-gray-500">SKU: ${item.snapshotSKU || 'N/A'}</p>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center justify-center w-10 h-10 bg-green-500 text-white font-bold rounded-full">
                                ${item.quantity}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right font-semibold">${item.unitPrice.toLocaleString('vi-VN')}đ</td>
                        <td class="px-4 py-3 text-right font-bold text-green-600">${item.totalPrice.toLocaleString('vi-VN')}đ</td>
                    </tr>
                `).join('');
            } else {
                productsList.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">Không có sản phẩm</td></tr>';
            }

            // Tổng kết
            document.getElementById('exportTotalQty').textContent = `${receipt.totalQuantity} sản phẩm`;
            document.getElementById('exportTotalValue').textContent = receipt.totalValue.toLocaleString('vi-VN') + 'đ';

            // Hiện content, ẩn loading
            loading.classList.add('hidden');
            content.classList.remove('hidden');

        } catch (error) {
            console.error('Error loading export details:', error);

            // Hiện thông báo lỗi
            loading.innerHTML = `
                <div class="text-center py-8">
                    <span class="material-symbols-outlined text-6xl text-red-500 mb-3">error</span>
                    <h5 class="text-xl font-semibold text-red-600 mb-2">Có lỗi xảy ra</h5>
                    <p class="text-text-light-secondary mb-4">${error.message}</p>
                    <button onclick="closeExportDetailsModal()"
                            class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Đóng
                    </button>
                </div>
            `;
        }
    }

    // Đóng modal
    function closeExportDetailsModal() {
        const modal = document.getElementById('exportDetailsModal');
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // In phiếu xuất
    function printExportReceipt() {
        window.print();
    }

    // Click outside để đóng modal
    document.getElementById('exportDetailsModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeExportDetailsModal();
        }
    });

    // Nhấn ESC để đóng modal
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {   
            const modal = document.getElementById('exportDetailsModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeExportDetailsModal();
            }
        }
    });
</script>