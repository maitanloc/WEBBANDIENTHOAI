@model WEBBANDIENTHOAI.Models.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Đặt lại mật khẩu — FOXMOBILE</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/reset-password.css" />
</head>

<body>
    <!-- Thông báo Success/Error -->
    @if (ViewBag.Success != null)
    {
        <div class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">check_circle</span>
                <span>@ViewBag.Success</span>
            </div>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">error</span>
                <span>@ViewBag.Error</span>
            </div>
        </div>
    }

    <div class="flex min-h-screen items-center justify-center p-6">
        <div class="w-full max-w-4xl card rounded-2xl shadow-2xl blur-bg overflow-hidden">
            <div class="md:flex">
                <!-- LEFT INFO -->
                <aside class="side-info md:w-1/2 p-8 bg-white/40 backdrop-blur-sm border-r border-white/40 relative">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-3 mb-3">
                            <span class="material-symbols-outlined text-3xl text-primary">storefront</span>
                            <h3 class="text-2xl font-bold">Fox Mobile</h3>
                        </div>
                        <p class="text-sm text-gray-700/80">Mua bán điện thoại, laptop, TV &amp; phụ kiện — an toàn, chuyên nghiệp.</p>
                    </div>

                    <div class="mt-6 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">password</span></div>
                            <div>
                                <div class="font-semibold">Mật khẩu mới</div>
                                <div class="text-sm text-gray-600/80">Đặt mật khẩu mạnh và an toàn</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">check_circle</span></div>
                            <div>
                                <div class="font-semibold">Xác nhận mật khẩu</div>
                                <div class="text-sm text-gray-600/80">Nhập lại mật khẩu để xác nhận</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">security</span></div>
                            <div>
                                <div class="font-semibold">Bảo mật</div>
                                <div class="text-sm text-gray-600/80">Mật khẩu được mã hóa an toàn</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto text-xs text-gray-600/70 pt-4">© 2024 FOXMOBILE</div>

                   
                </aside>

                <!-- RIGHT: RESET PASSWORD -->
                <main class="relative md:w-1/2 p-6 sm:p-8">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h1 class="text-2xl font-extrabold text-gray-900">Đặt lại mật khẩu</h1>
                            <p class="text-sm text-gray-600/90">Tạo mật khẩu mới cho tài khoản</p>
                        </div>

                        <a href="@Url.Action("Login", "Account")" class="px-4 py-2 rounded-md border border-gray-300 text-sm hover:bg-gray-50 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">arrow_back</span>
                            Đăng nhập
                        </a>
                    </div>

                    <div class="bg-white/60 backdrop-blur-sm rounded-xl p-6">
                        <form asp-controller="Account" asp-action="ResetPassword" method="post">
                            @Html.AntiForgeryToken()

                            <!-- SỬA: Sử dụng asp-for thay vì name và value -->
                            <input type="hidden" asp-for="Token" />

                            <div class="mb-4">
                                <label class="block text-sm font-medium mb-2" asp-for="NewPassword">Mật khẩu mới</label>
                                <div class="flex gap-2">
                                    <input asp-for="NewPassword" type="password" required
                                           class="flex-1 rounded-l-lg border border-gray-200 px-4 py-3 focus:ring-2 focus:ring-primary/30"
                                           placeholder="Ít nhất 8 ký tự" />
                                    <button type="button" id="toggleNewPassword" class="rounded-r-lg border border-gray-200 px-3 py-2 bg-white/50">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-red-500 text-sm mt-1 block"></span>
                                <div class="mt-2 pw-meter">
                                    <div id="passwordBar" class="pw-bar"></div>
                                </div>
                                <div class="text-xs text-gray-500 mt-1">Độ mạnh: <span id="passwordText" class="font-medium">—</span></div>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-medium mb-2" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                                <div class="flex gap-2">
                                    <input asp-for="ConfirmPassword" type="password" required
                                           class="flex-1 rounded-l-lg border border-gray-200 px-4 py-3 focus:ring-2 focus:ring-primary/30"
                                           placeholder="Nhập lại mật khẩu" />
                                    <button type="button" id="toggleConfirmPassword" class="rounded-r-lg border border-gray-200 px-3 py-2 bg-white/50">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 block"></span>
                                <div id="passwordMatch" class="text-xs mt-1"></div>
                            </div>

                            <button type="submit" class="w-full rounded-lg bg-primary py-3 text-white font-bold shadow-sm hover:shadow-md transition mb-4">
                                Đặt lại mật khẩu
                            </button>

                            <div class="text-center">
                                <p class="text-sm text-gray-600">
                                    Quay lại
                                    <a href="@Url.Action("Login", "Account")" class="text-primary font-semibold">trang đăng nhập</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Script tự động ẩn thông báo và xử lý password -->
    <script>
        setTimeout(() => {
            const notifications = document.querySelectorAll('.fixed.top-4');
            notifications.forEach(notification => {
                notification.style.transition = 'opacity 0.5s ease';
                notification.style.opacity = '0';
                setTimeout(() => notification.remove(), 500);
            });
        }, 5000);

        // Password strength meter
        function setupPasswordMeter(inputId, barId, labelId) {
            const input = document.getElementById(inputId);
            const bar = document.getElementById(barId);
            const label = document.getElementById(labelId);

            if (!input || !bar || !label) return;

            input.addEventListener('input', () => {
                const v = input.value || "";
                let score = 0;
                if (v.length >= 8) score++;
                if (/[A-Z]/.test(v)) score++;
                if (/[0-9]/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;

                bar.style.width = ((score / 4) * 100) + '%';

                const colors = ['bg-red-500', 'bg-orange-500', 'bg-yellow-500', 'bg-green-500', 'bg-emerald-500'];
                const labels = ['Rất yếu', 'Yếu', 'Trung bình', 'Mạnh', 'Rất mạnh'];

                bar.className = `pw-bar ${colors[score]}`;
                label.textContent = labels[score];
            });
        }

        // Password match checker
        function setupPasswordMatch() {
            // SỬA: Sử dụng id đúng (NewPassword, ConfirmPassword)
            const newPass = document.getElementById('NewPassword');
            const confirmPass = document.getElementById('ConfirmPassword');
            const matchText = document.getElementById('passwordMatch');

            function checkMatch() {
                if (newPass && confirmPass && newPass.value && confirmPass.value) {
                    if (newPass.value === confirmPass.value) {
                        matchText.innerHTML = '<span class="text-green-600">✓ Mật khẩu khớp</span>';
                    } else {
                        matchText.innerHTML = '<span class="text-red-600">✗ Mật khẩu không khớp</span>';
                    }
                } else {
                    matchText.innerHTML = '';
                }
            }

            if (newPass) newPass.addEventListener('input', checkMatch);
            if (confirmPass) confirmPass.addEventListener('input', checkMatch);
        }

        // Toggle password visibility
        function setupTogglePassword(buttonId, inputId) {
            const btn = document.getElementById(buttonId);
            const input = document.getElementById(inputId);

            if (!btn || !input) return;

            btn.addEventListener('click', () => {
                input.type = input.type === 'password' ? 'text' : 'password';
                const icon = btn.querySelector('.material-symbols-outlined');
                if (icon) {
                    icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
                }
            });
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            // SỬA: Sử dụng id đúng
            setupPasswordMeter('NewPassword', 'passwordBar', 'passwordText');
            setupPasswordMatch();
            setupTogglePassword('toggleNewPassword', 'NewPassword');
            setupTogglePassword('toggleConfirmPassword', 'ConfirmPassword');
        });
    </script>
</body>
</html>