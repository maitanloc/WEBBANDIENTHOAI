@model WEBBANDIENTHOAI.Models.ForgotPasswordModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Quên mật khẩu — FOXMOBILE</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/forgot-password.css" />
</head>

<body>
    <!-- Thông báo Success/Error -->
    @if (ViewBag.Success != null)
    {
        <div class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">check_circle</span>
                <span>@ViewBag.Success</span>
            </div>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">error</span>
                <span>@ViewBag.Error</span>
            </div>
        </div>
    }

    <div class="flex min-h-screen items-center justify-center p-6">
        <div class="w-full max-w-4xl card rounded-2xl shadow-2xl blur-bg overflow-hidden">
            <div class="md:flex">
                <!-- LEFT INFO -->
                <aside class="side-info md:w-1/2 p-8 bg-white/40 backdrop-blur-sm border-r border-white/40 relative">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-3 mb-3">
                            <span class="material-symbols-outlined text-3xl text-primary">storefront</span>
                            <h3 class="text-2xl font-bold">Fox Mobile</h3>
                        </div>
                        <p class="text-sm text-gray-700/80">Mua bán điện thoại, laptop, TV &amp; phụ kiện — an toàn, chuyên nghiệp.</p>
                    </div>

                    <div class="mt-6 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">lock_reset</span></div>
                            <div>
                                <div class="font-semibold">Khôi phục mật khẩu</div>
                                <div class="text-sm text-gray-600/80">Bảo mật an toàn với OTP</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">mail</span></div>
                            <div>
                                <div class="font-semibold">Gửi mã OTP</div>
                                <div class="text-sm text-gray-600/80">Mã xác thực sẽ được gửi qua email</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-full bg-primary/10 p-2"><span class="material-symbols-outlined text-primary">shield</span></div>
                            <div>
                                <div class="font-semibold">Bảo mật</div>
                                <div class="text-sm text-gray-600/80">Mã OTP có hiệu lực trong 10 phút</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto text-xs text-gray-600/70 pt-4">© 2024 FOXMOBILE</div>

                  
                </aside>

                <!-- RIGHT: FORGOT PASSWORD -->
                <main class="relative md:w-1/2 p-6 sm:p-8">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h1 class="text-2xl font-extrabold text-gray-900">Quên mật khẩu</h1>
                            <p class="text-sm text-gray-600/90">Nhập email để nhận mã OTP</p>
                        </div>

                        <a href="@Url.Action("Login", "Account")" class="px-4 py-2 rounded-md border border-gray-300 text-sm hover:bg-gray-50 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">arrow_back</span>
                            Quay lại
                        </a>
                    </div>

                    <div class="bg-white/60 backdrop-blur-sm rounded-xl p-6">
                        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-6">
                                <label class="block text-sm font-medium mb-2" asp-for="EmailOrPhone">Email đăng ký</label>
                                <input asp-for="EmailOrPhone" type="text"
                                       class="w-full rounded-lg border border-gray-200 px-4 py-3 focus:ring-2 focus:ring-primary/30"
                                       placeholder="Nhập email đã đăng ký tài khoản" />
                                <span asp-validation-for="EmailOrPhone" class="text-red-500 text-sm"></span>
                                <p class="text-xs text-gray-500 mt-2">Mã OTP sẽ được gửi đến email này</p>
                            </div>

                            <button type="submit" class="w-full rounded-lg bg-primary py-3 text-white font-bold shadow-sm hover:shadow-md transition mb-4">
                                Gửi mã OTP
                            </button>

                            <div class="text-center">
                                <p class="text-sm text-gray-600">
                                    Nhớ mật khẩu?
                                    <a href="@Url.Action("Login", "Account")" class="text-primary font-semibold">Đăng nhập ngay</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Script tự động ẩn thông báo -->
    <script>
        setTimeout(() => {
            const notifications = document.querySelectorAll('.fixed.top-4');
            notifications.forEach(notification => {
                notification.style.transition = 'opacity 0.5s ease';
                notification.style.opacity = '0';
                setTimeout(() => notification.remove(), 500);
            });
        }, 5000);
    </script>
</body>
</html>