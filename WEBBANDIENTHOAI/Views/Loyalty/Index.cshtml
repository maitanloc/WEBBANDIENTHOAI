@model dynamic
@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "Điểm Thưởng & Khách Hàng Thân Thiết";

    WEBBANDIENTHOAI.Models.Customer customer = ViewBag.Customer;
    IEnumerable<WEBBANDIENTHOAI.Models.UserPointHistory> history = ViewBag.History;
    IEnumerable<WEBBANDIENTHOAI.Models.CustomerTier> tiers = ViewBag.Tiers;
    WEBBANDIENTHOAI.Models.CustomerTier nextTier = ViewBag.NextTier;
}

<div class="font-display bg-background-light dark:bg-background-dark min-h-screen">

    <main class="layout-container flex h-full grow flex-col">
        <div class="px-4 sm:px-6 lg:px-10 flex flex-1 justify-center py-5 md:py-10">
            <div class="flex w-full max-w-6xl flex-col gap-8 md:flex-row">

                <!-- SIDEBAR -->
                <aside class="flex-shrink-0 md:w-64 lg:w-72">
                    <div class="sticky top-28 flex flex-col justify-between rounded-xl bg-card-light dark:bg-card-dark p-4 shadow-sm border border-border-light dark:border-border-dark sidebar-scrollable max-h-[calc(100vh-140px)]">

                        <div class="flex flex-col gap-6">

                            <!-- USER INFO -->
                            <div class="flex items-center gap-4">
                                <div id="sidebar-avatar" class="size-12 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white text-xl font-semibold">
                                    @(customer.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>

                                <div class="flex flex-col">
                                    <h1 id="sidebar-fullname" class="text-text-light dark:text-text-dark text-base font-semibold leading-normal">
                                        @customer.FullName
                                    </h1>
                                    <p class="text-subtext-light dark:text-subtext-dark text-sm font-normal leading-normal">
                                        @customer.Email
                                    </p>
                                </div>
                            </div>

                            <!-- LOYALTY INFO -->
                            <div class="flex min-w-[158px] flex-1 flex-col gap-2 rounded-lg p-4 bg-background-light dark:bg-background-dark border border-border-light dark:border-border-dark">
                                <p class="text-subtext-light dark:text-subtext-dark text-sm font-medium leading-normal">Hạng hiện tại</p>
                                <div class="flex items-center justify-between mb-2">
                                    <h4 class="text-text-light dark:text-text-dark text-lg font-bold">@(customer.Tier?.TierName ?? "Thành viên")</h4>
                                    <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">
                                        Đặc quyền x@(customer.Tier?.BonusMultiplier ?? 1.0m) điểm
                                    </span>
                                </div>
                                <p class="text-subtext-light dark:text-subtext-dark text-sm font-medium leading-normal mt-2">Điểm F-Point</p>
                                <p class="text-warning tracking-light text-2xl font-bold leading-tight flex items-center gap-2">
                                    <i class="fas fa-coins"></i> @customer.LoyaltyPoints.ToString("N0")
                                </p>
                            </div>

                            <!-- MENU -->
                            <div class="flex flex-col gap-1">
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-text-light dark:text-text-dark hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors" href="/Info/ThongTinKH">
                                    <span class="material-symbols-outlined text-xl">person</span>
                                    <p class="text-sm font-medium leading-normal">Thông tin tài khoản</p>
                                </a>
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary/10 dark:bg-primary/20 text-primary" href="/Loyalty">
                                    <i class="fas fa-gem text-xl w-6"></i>
                                    <p class="text-sm font-semibold leading-normal">Tổng quan điểm thưởng</p>
                                </a>
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-text-light dark:text-text-dark hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors" href="/Loyalty/MyVouchers">
                                    <i class="fas fa-ticket-alt text-xl w-6"></i>
                                    <p class="text-sm font-medium leading-normal">Kho Voucher của tôi</p>
                                </a>
                            </div>

                        </div>
                    </div>
                </aside>

                <!-- MAIN CONTENT -->
                <div class="flex-1 flex flex-col gap-8">
                    
                    <div class="flex flex-wrap justify-between gap-3">
                        <div class="flex flex-col gap-1">
                            <p class="text-text-light dark:text-text-dark text-3xl font-bold">Điểm Thưởng & Khách Hàng Thân Thiết</p>
                            <p class="text-subtext-light dark:text-subtext-dark text-base">Theo dõi điểm thưởng, hạng thành viên và lịch sử tích điểm.</p>
                        </div>
                    </div>

                    <!-- Tier Progress -->
                    <div class="rounded-xl border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark p-6 shadow-sm">
                        <h2 class="text-text-light dark:text-text-dark text-lg font-semibold leading-tight mb-5">Tiến trình thăng hạng</h2>

                        @if (nextTier != null)
                        {
                            var currentTierMin = customer.Tier?.MinSpending ?? 0m;
                            var spendingNeeded = nextTier.MinSpending - customer.TotalSpent;
                            
                            // Tránh chia cho 0 nếu data seed lỗi
                            decimal range = nextTier.MinSpending - currentTierMin;
                            double progress = range > 0 
                                ? (double)(100m * (customer.TotalSpent - currentTierMin) / range)
                                : 100.0;

                            if (progress < 0) progress = 0; if (progress > 100) progress = 100;

                            <div class="flex justify-between mb-2">
                                <span class="text-sm font-semibold text-primary">@(customer.Tier?.TierName ?? "Thành viên")</span>
                                <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">@nextTier.TierName</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5 mb-3">
                                <div class="bg-yellow-400 h-2.5 rounded-full" style="width: @progress%"></div>
                            </div>
                            <p class="text-sm text-subtext-light dark:text-subtext-dark">Chi tiêu thêm <strong class="text-primary">@spendingNeeded.ToString("N0")đ</strong> để lên hạng <strong>@nextTier.TierName</strong></p>
                        }
                        else
                        {
                            <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400 border border-green-200 dark:border-green-800" role="alert">
                                <span class="font-medium"><i class="fas fa-trophy mr-2"></i> Chúc mừng!</span> Bạn đang ở hạng cao nhất. Tận hưởng đặc quyền ưu tiên!
                            </div>
                        }

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                            @foreach (var t in tiers)
                            {
                                <div class="rounded-xl border p-4 text-center @(t.TierId == customer.TierId ? "border-primary bg-primary/5 dark:bg-primary/10 shadow-sm" : "border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark")">
                                    <h3 class="font-bold text-base mb-1 @(t.TierId == customer.TierId ? "text-primary" : "text-text-light dark:text-text-dark")">@t.TierName</h3>
                                    <p class="text-xs text-subtext-light dark:text-subtext-dark mb-2">≥ @t.MinSpending.ToString("N0")đ</p>
                                    <span class="inline-block px-2 text-[10px] py-1 bg-white dark:bg-gray-800 border border-border-light dark:border-border-dark rounded text-text-light dark:text-text-dark">Đặc quyền x@t.BonusMultiplier</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- History -->
                    <div class="rounded-xl border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark p-6 shadow-sm overflow-hidden">
                        <h2 class="text-text-light dark:text-text-dark text-lg font-semibold leading-tight mb-5">Lịch sử giao dịch điểm</h2>
                        
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 rounded-t-lg">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 rounded-tl-lg">Thời gian</th>
                                        <th scope="col" class="px-6 py-3">Nội dung</th>
                                        <th scope="col" class="px-6 py-3 rounded-tr-lg text-right">Điểm</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in history)
                                    {
                                        <tr class="bg-card-light dark:bg-card-dark border-b border-border-light dark:border-border-dark hover:bg-gray-50 dark:hover:bg-gray-800">
                                            <td class="px-6 py-4 whitespace-nowrap">@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="px-6 py-4">@h.Reason</td>
                                            <td class="px-6 py-4 text-right font-bold @(h.Points >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                                @(h.Points >= 0 ? "+" : "")@h.Points.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                    @if (!history.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                                <i class="fas fa-history text-3xl mb-3 opacity-50 block"></i>
                                                Chưa có giao dịch điểm nào.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
</div>
