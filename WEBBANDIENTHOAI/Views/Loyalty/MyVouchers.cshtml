@model IEnumerable<WEBBANDIENTHOAI.Models.UserVoucher>
@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "Kho Voucher của tôi";
    WEBBANDIENTHOAI.Models.Customer customer = ViewBag.Customer;
}

<div class="font-display bg-background-light dark:bg-background-dark min-h-screen">

    <main class="layout-container flex h-full grow flex-col">
        <div class="px-4 sm:px-6 lg:px-10 flex flex-1 justify-center py-5 md:py-10">
            <div class="flex w-full max-w-6xl flex-col gap-8 md:flex-row">

                <!-- SIDEBAR -->
                <aside class="flex-shrink-0 md:w-64 lg:w-72">
                    <div class="sticky top-28 flex flex-col justify-between rounded-xl bg-card-light dark:bg-card-dark p-4 shadow-sm border border-border-light dark:border-border-dark sidebar-scrollable max-h-[calc(100vh-140px)]">

                        <div class="flex flex-col gap-6">

                            <!-- USER INFO -->
                            <div class="flex items-center gap-4">
                                <div id="sidebar-avatar" class="size-12 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white text-xl font-semibold">
                                    @(customer.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>

                                <div class="flex flex-col">
                                    <h1 id="sidebar-fullname" class="text-text-light dark:text-text-dark text-base font-semibold leading-normal">
                                        @customer.FullName
                                    </h1>
                                    <p class="text-subtext-light dark:text-subtext-dark text-sm font-normal leading-normal">
                                        @customer.Email
                                    </p>
                                </div>
                            </div>

                            <!-- LOYALTY INFO -->
                            <div class="flex min-w-[158px] flex-1 flex-col gap-2 rounded-lg p-4 bg-background-light dark:bg-background-dark border border-border-light dark:border-border-dark">
                                <p class="text-subtext-light dark:text-subtext-dark text-sm font-medium leading-normal">Điểm F-Point</p>
                                <p class="text-warning tracking-light text-2xl font-bold leading-tight flex items-center gap-2">
                                    <i class="fas fa-coins text-yellow-500"></i> @customer.LoyaltyPoints.ToString("N0")
                                </p>
                            </div>

                            <!-- MENU -->
                            <div class="flex flex-col gap-1">
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-text-light dark:text-text-dark hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors" href="/Info/ThongTinKH">
                                    <span class="material-symbols-outlined text-xl">person</span>
                                    <p class="text-sm font-medium leading-normal">Thông tin tài khoản</p>
                                </a>
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-text-light dark:text-text-dark hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors" href="/Loyalty">
                                    <i class="fas fa-gem text-xl w-6"></i>
                                    <p class="text-sm font-medium leading-normal">Tổng quan điểm thưởng</p>
                                </a>
                                <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary/10 dark:bg-primary/20 text-primary" href="/Loyalty/MyVouchers">
                                    <i class="fas fa-ticket-alt text-xl w-6"></i>
                                    <p class="text-sm font-semibold leading-normal">Kho Voucher của tôi</p>
                                </a>
                            </div>

                        </div>
                    </div>
                </aside>

                <!-- MAIN CONTENT -->
                <div class="flex-1 flex flex-col gap-8">
                    
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-col gap-1">
                            <p class="text-text-light dark:text-text-dark text-3xl font-bold">Voucher của tôi (@Model.Count())</p>
                            <p class="text-subtext-light dark:text-subtext-dark text-base">Quản lý và sử dụng các mã giảm giá bạn đang có.</p>
                        </div>
                        <a href="/HomeCarts" class="flex items-center gap-2 rounded-lg bg-primary text-white px-5 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity shadow-sm">
                            <i class="fas fa-shopping-cart"></i> Đến giỏ hàng
                        </a>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var uv in Model)
                        {
                            var v = uv.Voucher;
                            <div class="flex flex-row rounded-xl overflow-hidden border-2 border-dashed border-yellow-400 bg-card-light dark:bg-card-dark shadow-sm hover:-translate-y-1 hover:shadow-md transition-all">
                                <!-- Trái: Icon & Discount -->
                                <div class="flex flex-col items-center justify-center bg-yellow-50 dark:bg-yellow-900/20 border-r-2 border-dashed border-yellow-400 p-4 w-1/3 min-w-[100px]">
                                    <i class="fas fa-ticket-alt text-yellow-500 text-3xl mb-2"></i>
                                    @if (v.DiscountType == WEBBANDIENTHOAI.Models.DiscountType.Percent) {
                                        <h5 class="font-bold text-red-600 text-xl">@v.Value%</h5>
                                    } else {
                                        <h5 class="font-bold text-red-600 text-xl">@(v.Value/1000)K</h5>
                                    }
                                </div>
                                <!-- Phải: Nội dung voucher -->
                                <div class="flex flex-col justify-between p-4 w-2/3">
                                    <div>
                                        <div class="flex justify-between items-start mb-1">
                                            <span class="inline-block px-2 py-0.5 bg-gray-800 text-white text-xs font-mono rounded">@v.Code</span>
                                        </div>
                                        <p class="font-semibold text-text-light dark:text-text-dark text-sm mb-1 line-clamp-2" title="@v.Description">@v.Description</p>
                                        <p class="text-xs text-subtext-light dark:text-subtext-dark mb-2">Đơn tối thiểu @v.MinOrderValue.ToString("N0")đ</p>
                                    </div>
                                    <div class="flex justify-between items-end">
                                        <div class="text-red-500 text-xs font-semibold flex items-center gap-1">
                                            <i class="far fa-clock"></i> Hạn: @v.EndDate.ToLocalTime().ToString("dd/MM/yyyy")
                                        </div>
                                        <button class="text-xs bg-primary/10 text-primary hover:bg-primary hover:text-white px-3 py-1.5 rounded-md transition-colors font-semibold" onclick="copyCode('@v.Code')">SAO CHÉP</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="col-span-full py-16 flex flex-col items-center justify-center bg-card-light dark:bg-card-dark rounded-xl border border-border-light dark:border-border-dark shadow-sm">
                            <i class="fas fa-box-open text-gray-300 dark:text-gray-600 text-6xl mb-4"></i>
                            <h5 class="text-lg font-bold text-text-light dark:text-text-dark mb-2">Kho Voucher trống</h5>
                            <p class="text-subtext-light dark:text-subtext-dark text-sm max-w-md text-center mb-6">Bạn chưa có mã giảm giá nào. Hãy mua sắm để tích lũy điểm và đổi nhận ưu đãi nhé!</p>
                            <a href="/Product" class="rounded-lg border border-primary text-primary hover:bg-primary hover:text-white px-6 py-2.5 font-semibold transition-colors">Mua sắm ngay</a>
                        </div>
                    }

                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        function copyCode(code) {
            navigator.clipboard.writeText(code).then(() => {
                alert(`Đã sao chép mã voucher: ${code}`);
            }).catch(err => {
                console.error('Copy failed', err);
            });
        }
    </script>
}
