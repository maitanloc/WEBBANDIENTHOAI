                        Hủy
                    </button>
                    <button type="button" id="modal-confirm-btn" class="inline-flex justify-center rounded-lg border border-transparent bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700 focus-ring">
                        Đăng Xuất
                    </button>
                </div>
            </div>
        </div>

@section Scripts {
    <script>
        // Quick Actions dropdown: accessible + smooth animation (open class toggles CSS animation)
        (function(){
          const root = document.getElementById('quick-root');
          const btn = document.getElementById('quick-actions-btn');
          const menu = document.getElementById('quick-dropdown');
          if (!btn || !menu || !root) return;

          const items = Array.from(menu.querySelectorAll('[role="menuitem"]'));
          let open = false;

          function openMenu() {
            open = true;
            root.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
            setTimeout(()=> items[0]?.focus(), 140);
          }
          function closeMenu(restore = true) {
            open = false;
            root.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
            if (restore) btn.focus();
          }

          btn.addEventListener('click', (e) => { e.stopPropagation(); open? closeMenu() : openMenu(); });
          document.addEventListener('click', (e) => { if (!root.contains(e.target) && open) closeMenu(); });

          document.addEventListener('keydown', (e) => {
            if (!open && (document.activeElement === btn) && e.key === 'ArrowDown') { e.preventDefault(); openMenu(); return; }
            if (!open) return;
            if (e.key === 'Escape'){ e.preventDefault(); closeMenu(); return; }
            const idx = items.indexOf(document.activeElement);
            if (e.key === 'ArrowDown'){ e.preventDefault(); items[(idx+1) % items.length]?.focus(); }
            else if (e.key === 'ArrowUp'){ e.preventDefault(); items[(idx-1 + items.length) % items.length]?.focus(); }
            else if (e.key === 'Home'){ e.preventDefault(); items[0]?.focus(); }
            else if (e.key === 'End'){ e.preventDefault(); items[items.length-1]?.focus(); }
          });

          // placeholder handlers
          document.getElementById('qa-nhapkho')?.addEventListener('click', ()=> alert('Quick: Nhập kho'));
          document.getElementById('qa-xuatkho')?.addEventListener('click', ()=> alert('Quick: Xuất kho'));
          document.getElementById('qa-add-product')?.addEventListener('click', ()=> alert('Quick: Thêm sản phẩm'));
          document.getElementById('qa-import')?.addEventListener('click', ()=> alert('Quick: Import Excel'));
          document.getElementById('qa-export')?.addEventListener('click', ()=> alert('Quick: Export báo cáo'));

          // toolbar buttons
          document.getElementById('btn-nhapkho')?.addEventListener('click', ()=> alert('Mở form Nhập kho (modal)'));
          document.getElementById('btn-xuatkho')?.addEventListener('click', ()=> alert('Mở form Xuất kho (modal)'));
          document.getElementById('btn-add-product')?.addEventListener('click', ()=> alert('Mở form Thêm sản phẩm'));
        })();

        // Simple nav active management
        (function(){
          const nav = document.getElementById('main-nav');
          if(!nav) return;
          nav.addEventListener('click', (e) => {
            const a = e.target.closest('a.nav-link');
            if(!a) return;
            nav.querySelectorAll('a.nav-link').forEach(el => el.classList.remove('nav-link--active'), el.removeAttribute('aria-current'));
            a.classList.add('nav-link--active'); a.setAttribute('aria-current','page');
            e.preventDefault();
          });
        })();

        // Logout Modal Logic (Logic mới cho Custom Pop-up)
        (function(){
          const modal = document.getElementById('logout-modal');
          const modalContent = document.getElementById('logout-modal-content');
          const confirmBtn = document.getElementById('modal-confirm-btn');
          const cancelBtn = document.getElementById('modal-cancel-btn');

          // Hàm mở modal
          window.openLogoutModal = function() {
            modal.classList.remove('hidden');

            // Dùng setTimeout nhỏ để kích hoạt transition CSS sau khi hiển thị (từ hidden sang flex)
            setTimeout(() => {
              modal.classList.add('opacity-100');
              modalContent.classList.remove('scale-95', 'opacity-0');
              modalContent.classList.add('scale-100', 'opacity-100');
              confirmBtn.focus(); // Tập trung vào nút xác nhận để người dùng có thể thao tác bằng bàn phím
            }, 10);
          };

          // Hàm đóng modal
          function closeLogoutModal() {
            // Thiết lập transition để đóng mượt mà
            modal.classList.remove('opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            modalContent.classList.remove('scale-100', 'opacity-100');

            // Ẩn hoàn toàn sau khi transition kết thúc (300ms)
            setTimeout(() => {
              modal.classList.add('hidden');
              document.getElementById("nav-logout").focus(); // Trả lại focus về nút logout ban đầu
            }, 300);
          }

          // Event: Click nút Đăng Xuất trong modal (Thực hiện hành động)
          confirmBtn.addEventListener('click', () => {
            window.location.href = "/Account/Logout"; // Chuyển hướng
          });

          // Event: Click nút Hủy trong modal (Đóng modal)
          cancelBtn.addEventListener('click', closeLogoutModal);

          // Event: Click bên ngoài modal (backdrop) để đóng
          modal.addEventListener('click', (e) => {
            if (e.target === modal) {
              closeLogoutModal();
            }
          });

          // Event: Nhấn Escape để đóng modal
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
              closeLogoutModal();
            }
          });
        })();
    </script>
}