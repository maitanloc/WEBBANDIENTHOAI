@model WEBBANDIENTHOAI.ViewModels.AdminDashboardViewModel
@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Trang Chủ — Admin";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="space-y-8 p-6 sm:p-8 lg:p-10">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-black">Trang Chủ</h1>
      <p class="text-gray-500 mt-1">Chào mừng bạn đã quay trở lại</p>
    </div>
    <div class="flex gap-3 items-center">
      <a class="btn panel-link" data-url="@Url.Action("AddProduct","Admin")" href="@Url.Action("AddProduct","Admin")">Thêm sản phẩm</a>
    </div>
  </div>

  <!-- KPI -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="p-4 bg-white rounded shadow">
      <div class="text-sm text-gray-500">Doanh thu</div>
      <div class="text-xl font-bold">@String.Format(new CultureInfo("vi-VN"), "{0:C0}", Model.TotalRevenue)</div>
    </div>
    <div class="p-4 bg-white rounded shadow">
      <div class="text-sm text-gray-500">Hôm nay</div>
      <div class="text-xl font-bold">@String.Format(new CultureInfo("vi-VN"), "{0:C0}", Model.TodayRevenue)</div>
    </div>
    <div class="p-4 bg-white rounded shadow">
      <div class="text-sm text-gray-500">Đơn mới</div>
      <div class="text-xl font-bold">@Model.NewOrdersCount</div>
    </div>
    <div class="p-4 bg-white rounded shadow">
      <div class="text-sm text-gray-500">Sắp hết</div>
      <div class="text-xl font-bold">@Model.LowStockCount</div>
    </div>
  </section>

  <!-- Recent orders + charts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-semibold mb-3">Doanh thu (7 ngày)</h3>
      <canvas id="revenueChart" height="140"></canvas>
    </div>

    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-semibold mb-3">Đơn gần đây</h3>
      <table class="w-full text-sm">
        <thead><tr><th>Mã</th><th>KH</th><th>Ngày</th><th class="text-right">Tổng</th></tr></thead>
        <tbody>
          @if (Model.RecentOrders != null && Model.RecentOrders.Any())
          {
              foreach(var o in Model.RecentOrders)
              {
                  <tr>
                    <td>@o.OrderCode</td>
                    <td>@o.StaffOrCustomer</td>
                    <td>@o.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-right">@String.Format(new CultureInfo("vi-VN"), "{0:C0}", o.Total)</td>
                  </tr>
              }
          }
          else
          {
              <tr><td colspan="4" class="text-center text-gray-500">Không có đơn gần đây</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
