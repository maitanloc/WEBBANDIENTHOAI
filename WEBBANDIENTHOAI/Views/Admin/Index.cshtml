@model WEBBANDIENTHOAI.ViewModels.AdminDashboardViewModel
@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard — Quản Trị Hệ Thống";
}

<div class="space-y-6">
    <!-- 1. Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Tổng Quan</h1>
            <p class="text-gray-500 text-sm mt-1">Chào mừng quay trở lại, đây là tình hình kinh doanh hôm nay.</p>
        </div>
        <div class="flex items-center gap-3">
             <span class="text-sm font-medium text-gray-500 bg-white px-3 py-2 rounded-lg border shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-base">calendar_today</span>
                @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    <!-- 2. KPI Cards Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Revenue Card -->
        <div class="bg-white rounded-xl shadow-sm border border-orange-100 p-5 hover:shadow-md transition-shadow relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-10">
                <span class="material-symbols-outlined text-6xl text-orange-500">payments</span>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-medium text-gray-500">Tổng Doanh Thu</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-2">
                    @String.Format(new CultureInfo("vi-VN"), "{0:C0}", Model.TotalRevenue)
                </h3>
                <div class="mt-4 flex items-center text-sm text-green-600">
                    <span class="material-symbols-outlined text-base mr-1">trending_up</span>
                    <span class="font-medium">Tích lũy</span>
                </div>
            </div>
        </div>

        <!-- Today Revenue Card -->
        <div class="bg-white rounded-xl shadow-sm border border-blue-50 p-5 hover:shadow-md transition-shadow relative overflow-hidden">
             <div class="absolute top-0 right-0 p-4 opacity-10">
                <span class="material-symbols-outlined text-6xl text-blue-500">today</span>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-medium text-gray-500">Doanh Thu Hôm Nay</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-2">
                    @String.Format(new CultureInfo("vi-VN"), "{0:C0}", Model.TodayRevenue)
                </h3>
                 <div class="mt-4 flex items-center text-sm text-blue-600">
                    <span class="material-symbols-outlined text-base mr-1">schedule</span>
                    <span class="font-medium">Cập nhật: @DateTime.Now.ToString("HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="bg-white rounded-xl shadow-sm border border-purple-50 p-5 hover:shadow-md transition-shadow relative overflow-hidden">
             <div class="absolute top-0 right-0 p-4 opacity-10">
                <span class="material-symbols-outlined text-6xl text-purple-500">shopping_bag</span>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-medium text-gray-500">Đơn Hàng Mới</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-2">
                    @Model.NewOrdersCount
                </h3>
                <div class="mt-4 flex items-center text-sm text-purple-600">
                    <span class="material-symbols-outlined text-base mr-1">hourglass_empty</span>
                    <span class="font-medium">Chờ xử lý</span>
                </div>
            </div>
        </div>

        <!-- Low Stock Card -->
        <div class="bg-white rounded-xl shadow-sm border border-red-50 p-5 hover:shadow-md transition-shadow relative overflow-hidden">
             <div class="absolute top-0 right-0 p-4 opacity-10">
                <span class="material-symbols-outlined text-6xl text-red-500">warning</span>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-medium text-gray-500">Cảnh Báo Kho</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-2">
                    @Model.LowStockCount
                </h3>
                 <div class="mt-4 flex items-center text-sm text-red-600">
                    <span class="material-symbols-outlined text-base mr-1">inventory_2</span>
                    <span class="font-medium">Sản phẩm sắp hết</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Chart (Takes 2/3 width on large screens) -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-5">
            <div class="flex justify-between items-center mb-6">
                <h3 class="font-bold text-gray-800 text-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-500">bar_chart</span>
                    Biểu Đồ Doanh Thu
                </h3>
                <div class="text-sm text-gray-500 bg-gray-50 px-3 py-1 rounded-full border">
                    7 ngày qua
                </div>
            </div>
            <div class="relative h-80 w-full">
                 <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Right Column: Recent Orders (Takes 1/3 width) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col h-full">
            <div class="p-5 border-b border-gray-100 flex justify-between items-center">
                <h3 class="font-bold text-gray-800 text-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-green-500">receipt_long</span>
                    Đơn Gần Đây
                </h3>
                <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="text-sm text-orange-500 hover:text-orange-600 font-medium hover:underline panel-link" data-loader="true">Xem tất cả</a>
            </div>
            <div class="flex-1 overflow-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-gray-500 font-medium sticky top-0">
                        <tr>
                            <th class="px-5 py-3">Mã & Tổng Tiền</th>
                            <th class="px-5 py-3 text-right">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                        {
                            foreach(var o in Model.RecentOrders)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-gray-800">@o.OrderCode</span>
                                            <span class="text-xs text-gray-400">• @o.OrderDate.ToString("dd/MM")</span>
                                        </div>
                                        <div class="text-orange-600 font-bold mt-1">
                                            @String.Format(new CultureInfo("vi-VN"), "{0:C0}", o.Total)
                                        </div>
                                         <div class="text-xs text-gray-500 mt-0.5 truncate max-w-[150px]" title="@o.StaffOrCustomer">
                                            <span class="material-symbols-outlined text-[10px] align-middle mr-0.5">person</span>
                                            @o.StaffOrCustomer
                                        </div>
                                    </td>
                                    <td class="px-5 py-3 text-right align-top">
                                        @if(o.Status.Contains("Pending") || o.Status.Contains("Chờ"))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                                                @o.Status
                                            </span>
                                        }
                                        else if (o.Status.Contains("Completed") || o.Status.Contains("Hoàn thành"))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                                @o.Status
                                            </span>
                                        }
                                        else if (o.Status.Contains("Cancel") || o.Status.Contains("Hủy"))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                                @o.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                                                @o.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                             <tr>
                                <td colspan="2" class="px-5 py-10 text-center text-gray-500">
                                    <div class="flex flex-col items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-4xl text-gray-300">inbox</span>
                                        <p>Chưa có đơn hàng nào</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('revenueChart');
            
            if (ctx) {
                 const chartData = {
                    labels: @Json.Serialize(Model.RevenueByDayLabels),
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: @Json.Serialize(Model.RevenueByDay),
                        borderColor: '#f97316', // Orange-500 (Fox Mobile Brand)
                        backgroundColor: 'rgba(249, 115, 22, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#f97316',
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true
                    }]
                };

                new Chart(ctx, {
                    type: 'line',
                    data: chartData,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                backgroundColor: 'rgba(255, 255, 255, 0.95)',
                                titleColor: '#1f2937',
                                bodyColor: '#4b5563',
                                borderColor: '#e5e7eb',
                                borderWidth: 1,
                                padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed.y !== null) {
                                            label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: '#f3f4f6',
                                    drawBorder: false
                                },
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return value / 1000000 + 'M';
                                        if (value >= 1000) return value / 1000 + 'k';
                                        return value;
                                    },
                                    font: {
                                        size: 11
                                    },
                                    color: '#9ca3af'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    font: {
                                        size: 11
                                    },
                                    color: '#9ca3af'
                                }
                            }
                        },
                        interaction: {
                            mode: 'nearest',
                            axis: 'x',
                            intersect: false
                        }
                    }
                });
            }
        });
    </script>
}
