        <div id="logout-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-gray-900 bg-opacity-50 transition-opacity duration-300" aria-modal="true" role="dialog" aria-labelledby="modal-title">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm m-4 transform transition-all duration-300 scale-95 opacity-0" id="logout-modal-content">
                <div class="p-6 text-center">
                    <img src="@(Url.Content("~/images/hỏi đăng xuất.png"))" alt="Hỏi đăng xuất" class="mx-auto mb-6 w-28 h-auto" />

                    <div class="flex items-center justify-center">
