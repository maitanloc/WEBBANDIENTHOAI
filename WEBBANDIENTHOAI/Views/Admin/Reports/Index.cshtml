@model WEBBANDIENTHOAI.Models.ViewModels.DashboardViewModel
@{
      ViewData["Title"] = "Dashboard Báo Cáo";
      Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
      <!-- Tailwind is already included in Layout -->
}

<div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900">Dashboard Tổng Quan</h1>
      <p class="text-sm text-gray-500 mt-1">Tổng hợp số liệu kinh doanh trong 30 ngày qua.</p>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined">payments</span>
            </div>
            <div>
                  <p class="text-sm font-semibold text-gray-500">Doanh thu tổng</p>
                  <h3 class="text-2xl font-bold text-gray-900">@Model.TotalRevenue.ToString("N0")đ</h3>
            </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined">shopping_bag</span>
            </div>
            <div>
                  <p class="text-sm font-semibold text-gray-500">Tổng đơn hàng</p>
                  <h3 class="text-2xl font-bold text-gray-900">@Model.TotalOrders</h3>
            </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined">inventory_2</span>
            </div>
            <div>
                  <p class="text-sm font-semibold text-gray-500">Sản phẩm</p>
                  <h3 class="text-2xl font-bold text-gray-900">@Model.TotalProducts</h3>
            </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined">group</span>
            </div>
            <div>
                  <p class="text-sm font-semibold text-gray-500">Khách hàng</p>
                  <h3 class="text-2xl font-bold text-gray-900">@Model.TotalCustomers</h3>
            </div>
      </div>
</div>

<!-- Main Chart Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
      <!-- Chart -->
      <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div class="flex items-center justify-between mb-6">
                  <h3 class="font-bold text-gray-900">Biểu đồ doanh thu (30 ngày)</h3>
                  <a href="/Admin/Reports/Revenue" class="text-sm text-blue-600 hover:text-blue-700 font-semibold">Xem
                        chi tiết &rarr;</a>
            </div>
            <div class="aspect-w-16 aspect-h-9 h-[300px]">
                  <canvas id="revenueChart"></canvas>
            </div>
      </div>

      <!-- Quick Links / Recent Activity -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-gray-900 mb-4">Đơn hàng mới nhất</h3>
            <div class="space-y-4">
                  @foreach (var order in Model.RecentOrders)
                  {
                        <div class="flex items-center justify-between pb-3 border-b border-gray-50 last:border-0 last:pb-0">
                              <div>
                                    <p class="text-sm font-bold text-gray-900">Đơn #@order.OrderId</p>
                                    <p class="text-xs text-gray-500">@order.Customer?.FullName •
                                          @order.OrderDate.ToString("dd/MM")</p>
                              </div>
                              <div class="text-right">
                                    <p class="text-sm font-bold text-emerald-600">@order.Total.ToString("N0")đ</p>
                                    <span
                                          class="text-[10px] px-2 py-1 bg-gray-100 text-gray-600 rounded-full font-bold">@order.OrderStatus?.StatusName</span>
                              </div>
                        </div>
                  }
            </div>
            <div class="mt-6 pt-4 border-t border-gray-100">
                  <a href="/Admin/Order"
                        class="block text-center text-sm font-semibold text-gray-600 hover:text-gray-900">Quản lý tất cả
                        đơn hàng</a>
            </div>
      </div>
</div>

<!-- Detailed Reports Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <a href="/Admin/Reports/Revenue"
            class="bg-gradient-to-br from-blue-500 to-blue-600 p-6 rounded-2xl shadow-lg text-white hover:shadow-xl transition-all group">
            <div class="flex justify-between items-start mb-4">
                  <span class="material-symbols-outlined text-3xl opacity-80">analytics</span>
                  <span
                        class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
            </div>
            <h3 class="font-bold text-lg">Báo cáo Doanh thu</h3>
            <p class="text-sm text-blue-100 mt-1">Chi tiết doanh thu theo thời gian</p>
      </a>

      <a href="/Admin/Reports/Products"
            class="bg-gradient-to-br from-emerald-500 to-emerald-600 p-6 rounded-2xl shadow-lg text-white hover:shadow-xl transition-all group">
            <div class="flex justify-between items-start mb-4">
                  <span class="material-symbols-outlined text-3xl opacity-80">inventory</span>
                  <span
                        class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
            </div>
            <h3 class="font-bold text-lg">Báo cáo Sản phẩm</h3>
            <p class="text-sm text-emerald-100 mt-1">Top bán chạy & Tồn kho</p>
      </a>

      <a href="/Admin/Reports/Inventory"
            class="bg-gradient-to-br from-purple-500 to-purple-600 p-6 rounded-2xl shadow-lg text-white hover:shadow-xl transition-all group">
            <div class="flex justify-between items-start mb-4">
                  <span class="material-symbols-outlined text-3xl opacity-80">warehouse</span>
                  <span
                        class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
            </div>
            <h3 class="font-bold text-lg">Báo cáo Kho hàng</h3>
            <p class="text-sm text-purple-100 mt-1">Giá trị tồn kho & Vị trí</p>
      </a>

      <a href="/Admin/Reports/Customers"
            class="bg-gradient-to-br from-orange-500 to-orange-600 p-6 rounded-2xl shadow-lg text-white hover:shadow-xl transition-all group">
            <div class="flex justify-between items-start mb-4">
                  <span class="material-symbols-outlined text-3xl opacity-80">person_search</span>
                  <span
                        class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
            </div>
            <h3 class="font-bold text-lg">Báo cáo Khách hàng</h3>
            <p class="text-sm text-orange-100 mt-1">Top khách hàng & Phân tích</p>
      </a>
</div>

@section Scripts {
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
            // Data from Controller
            const labels = @Html.Raw(Json.Serialize(Model.RevenueChart.Select(x => x.Date)));
            const data = @Html.Raw(Json.Serialize(Model.RevenueChart.Select(x => x.Revenue)));

            const ctx = document.getElementById('revenueChart');
            if (ctx) {
                  new Chart(ctx, {
                        type: 'line',
                        data: {
                              labels: labels,
                              datasets: [{
                                    label: 'Doanh thu (VNĐ)',
                                    data: data,
                                    borderColor: '#2563eb',
                                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                                    fill: true,
                                    tension: 0.4,
                                    borderWidth: 2,
                                    pointBackgroundColor: '#ffffff',
                                    pointBorderColor: '#2563eb',
                                    pointRadius: 4
                              }]
                        },
                        options: {
                              responsive: true,
                              maintainAspectRatio: false,
                              plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                          callbacks: {
                                                label: function (context) {
                                                      return context.parsed.y.toLocaleString('vi-VN') + 'đ';
                                                }
                                          }
                                    }
                              },
                              scales: {
                                    y: {
                                          beginAtZero: true,
                                          grid: { borderDash: [2, 4], color: '#f3f4f6' },
                                          ticks: {
                                                callback: function (value) {
                                                      return value.toLocaleString('vi-VN') + 'đ';
                                                }
                                          }
                                    },
                                    x: {
                                          grid: { display: false }
                                    }
                              }
                        }
                  });
            }
      </script>
}