@model WEBBANDIENTHOAI.Models.ViewModels.ProductReportViewModel
@{
      ViewData["Title"] = "Báo Cáo Sản Phẩm";
      Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
            <h1 class="text-2xl font-bold text-gray-900">Báo Cáo Sản Phẩm</h1>
            <p class="text-sm text-gray-500 mt-1">Dữ liệu từ @Model.StartDate.ToString("dd/MM/yyyy") đến
                  @Model.EndDate.ToString("dd/MM/yyyy")</p>
            </div>

            <!-- Filter Form -->
            <form method="get"
                  class="flex flex-wrap items-center gap-2 bg-white p-2 rounded-xl shadow-sm border border-gray-100">
                  <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-500 pl-2">Từ:</span>
                        <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")"
                               class="border-gray-200 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500">
                  </div>
                  <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-500">Đến:</span>
                        <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")"
                               class="border-gray-200 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500">
                  </div>
                  <button type="submit"
                          class="bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors">
                        Lọc
                  </button>
                  <a href="/Admin/Reports/Products"
                     class="text-gray-500 hover:text-gray-700 px-3 py-2 text-sm font-medium">Đặt lại</a>
            </form>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

            <!-- Top Best Sellers -->
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
                  <div class="px-6 py-4 border-b border-gray-100 bg-emerald-50/50 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                              <span class="material-symbols-outlined text-emerald-600">trending_up</span>
                              <h3 class="font-bold text-gray-900">Top 10 Bán Chạy Nhất (Trong kỳ)</h3>
                        </div>
                  </div>
                  <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                              <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                                    <tr>
                                          <th class="px-6 py-3">Sản phẩm</th>
                                          <th class="px-6 py-3 text-center">Đã bán</th>
                                          <th class="px-6 py-3 text-right">Doanh thu</th>
                                    </tr>
                              </thead>
                              <tbody class="divide-y divide-gray-100">
                                    @if (Model.BestSellers.Any())
                                    {
                                          var rank = 1;
                                          foreach (var item in Model.BestSellers)
                                          {
                                                <tr class="hover:bg-gray-50">
                                                      <td class="px-6 py-4">
                                                            <div class="flex items-center gap-3">
                                                                  <span
                                                                  class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-100 text-xs font-bold text-gray-600">@rank</span>
                                                                  <div>
                                                                        <p class="font-medium text-gray-900 line-clamp-1">@item.Name</p>
                                                                        <p class="text-xs text-gray-500">SKU: @item.SKU</p>
                                                                  </div>
                                                            </div>
                                                      </td>
                                                      <td class="px-6 py-4 text-center font-bold">@item.UnitsSold</td>
                                                      <td class="px-6 py-4 text-right text-emerald-600 font-semibold">
                                                            @item.RevenueGenerated.ToString("N0")đ</td>
                                                      </tr>
                                                      rank++;
                                                }
                                          }
                              else
                                          {
                                                <tr>
                                                      <td colspan="3" class="px-6 py-8 text-center text-gray-500">Chưa có dữ liệu bán
                                                            hàng.</td>
                                                      </tr>
                                                }
                                          </tbody>
                                    </table>
                              </div>
                        </div>

                        <!-- Low Stock Alerts -->
                        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
                              <div class="px-6 py-4 border-b border-gray-100 bg-red-50/50 flex justify-between items-center">
                                    <div class="flex items-center gap-2">
                                          <span class="material-symbols-outlined text-red-600">warning</span>
                                          <h3 class="font-bold text-gray-900">Cảnh Báo Sắp Hết Hàng</h3>
                                    </div>
                              </div>
                              <div class="overflow-x-auto">
                                    <table class="w-full text-sm text-left">
                                          <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                                                <tr>
                                                      <th class="px-6 py-3">Sản phẩm</th>
                                                      <th class="px-6 py-3 text-center">Hiện có</th>
                                                      <th class="px-6 py-3 text-center">Định mức</th>
                                                      <th class="px-6 py-3 text-center">Trạng thái</th>
                                                </tr>
                                          </thead>
                                          <tbody class="divide-y divide-gray-100">
                                                @if (Model.LowStockItems.Any())
                                                {
                                                      foreach (var item in Model.LowStockItems)
                                                      {
                                                            <tr class="hover:bg-gray-50">
                                                                  <td class="px-6 py-4">
                                                                        <p class="font-medium text-gray-900 line-clamp-1">@item.Name</p>
                                                                        <p class="text-xs text-gray-500">Mã kho: @item.StockCode</p>
                                                                  </td>
                                                                  <td
                                                                        class="px-6 py-4 text-center font-bold @(item.CurrentQuantity == 0 ? "text-red-600" : "text-orange-600")">
                                                                        @item.CurrentQuantity
                                                                  </td>
                                                                  <td class="px-6 py-4 text-center text-gray-500">@item.MinimumQuantity</td>
                                                                  <td class="px-6 py-4 text-center">
                                                                        @if (item.CurrentQuantity == 0)
                                                                        {
                                                                              <span
                                                                                    class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-600">Hết
                                                                                    hàng</span>
                                                                              }
                                                      else
                                                                              {
                                                                                    <span
                                                                                          class="px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-600">Sắp
                                                                                          hết</span>
                                                                                    }
                                                                              </td>
                                                                        </tr>
                                                                  }
                                                            }
                              else
                                                            {
                                                                  <tr>
                                                                        <td colspan="4" class="px-6 py-8 text-center text-gray-500">Kho hàng ổn định, không
                                                                              có cảnh báo.</td>
                                                                        </tr>
                                                                  }
                                                            </tbody>
                                                      </table>
                                                </div>
                                          </div>
                                    </div>