@model IEnumerable<WEBBANDIENTHOAI.Models.User>
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var u in Model)
    {
        <tr>
            <td>@u.UserId</td>
            <td>@u.Username</td>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@(u.Role?.RoleName ?? "Staff")</td>
            <td>@(u.IsActive ? "Active" : "Locked")</td>
            <td>
                <form asp-controller="Admin" asp-action="ToggleActive" method="post" style="display:inline">
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <button class="btn.ghost" type="submit">Toggle</button>
                </form>
                <form asp-controller="Admin" asp-action="DeleteUser" method="post" style="display:inline" onsubmit="return confirm('Xác nhận xóa?')">
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <button class="btn ghost" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
