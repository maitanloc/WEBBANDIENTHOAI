@model IEnumerable<WEBBANDIENTHOAI.Models.Role>

@{
    ViewData["Title"] = "Quản lý Vai trò";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex min-h-screen">
    <main class="flex-1 p-6 md:p-10">
        <div class="max-w-7xl mx-auto">
            <!-- Breadcrumb -->
            <div class="flex flex-wrap gap-2 mb-4">
                <a class="text-text-muted-light dark:text-text-muted-dark text-sm font-medium leading-normal hover:text-primary" href="/">Home</a>
                <span class="text-text-muted-light dark:text-text-muted-dark text-sm font-medium leading-normal">/</span>
                <a class="text-text-muted-light dark:text-text-muted-dark text-sm font-medium leading-normal hover:text-primary" href="/Admin">Admin</a>
                <span class="text-text-muted-light dark:text-text-muted-dark text-sm font-medium leading-normal">/</span>
                <span class="text-text-light dark:text-text-dark text-sm font-medium leading-normal">Roles</span>
            </div>

            <!-- Header -->
            <div class="flex flex-wrap justify-between gap-4 items-center mb-6">
                <div class="flex flex-col gap-1">
                    <h1 class="text-text-light dark:text-text-dark text-3xl font-bold leading-tight tracking-tight">Quản lý Vai trò</h1>
                    <p class="text-text-muted-light dark:text-text-muted-dark text-base font-normal leading-normal">Manage user roles and permissions for the application.</p>
                </div>
                <button id="addRoleBtn" class="flex cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#f27f0d] text-white gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-4 hover:opacity-90 transition-opacity shadow-sm">
                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">add</span>
                    <span class="truncate">Thêm mới</span>
                </button>
            </div>

            <!-- Messages -->
            <div id="messageContainer" class="mb-4"></div>

            <!-- Table Container -->
            <div class="bg-card-light dark:bg-card-dark rounded-xl shadow-sm border border-border-light dark:border-border-dark overflow-hidden">
                <!-- Search and Filter -->
                <div class="p-4 border-b border-border-light dark:border-border-dark flex flex-wrap items-center justify-between gap-4">
                    <div class="flex-1 min-w-[280px]">
                        <label class="flex flex-col w-full">
                            <div class="relative flex w-full flex-1 items-center">
                                <div class="absolute left-0 pl-3 text-text-muted-light dark:text-text-muted-dark pointer-events-none">
                                    <span class="material-symbols-outlined text-xl">search</span>
                                </div>
                                <input id="searchInput" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark h-10 placeholder:text-text-muted-light dark:placeholder:text-text-muted-dark pl-10 pr-4 text-sm font-normal leading-normal" placeholder="Search by role name or description..." />
                            </div>
                        </label>
                    </div>
                    <div class="flex gap-2">
                        <button class="flex cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-primary/20 text-primary gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-4 hover:bg-primary/30 transition-colors">
                            <span class="material-symbols-outlined text-lg">filter_list</span>
                            <span class="truncate">Filter</span>
                        </button>
                    </div>
                </div>

                <!-- Roles Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-background-light dark:bg-background-dark text-xs text-text-muted-light dark:text-text-muted-dark uppercase tracking-wider">
                            <tr>
                                <th class="p-4" scope="col">
                                    <div class="flex items-center">
                                        <input class="w-4 h-4 text-primary bg-gray-100 border-gray-300 rounded focus:ring-primary dark:focus:ring-primary dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" id="checkbox-all" type="checkbox" />
                                        <label class="sr-only" for="checkbox-all">checkbox</label>
                                    </div>
                                </th>
                                <th class="px-6 py-3" scope="col">ID</th>
                                <th class="px-6 py-3" scope="col">Tên vai trò</th>
                                <th class="px-6 py-3" scope="col">Mô tả</th>
                                <th class="px-6 py-3 text-right" scope="col">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="rolesTableBody">
                            @foreach (var role in Model)
                            {
                                <tr class="border-b border-border-light dark:border-border-dark hover:bg-primary/5 dark:hover:bg-primary/10 transition-colors">
                                    <td class="w-4 p-4">
                                        <div class="flex items-center">
                                            <input class="w-4 h-4 text-primary bg-gray-100 border-gray-300 rounded focus:ring-primary dark:focus:ring-primary dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600 role-checkbox" type="checkbox" data-id="@role.RoleId" />
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-medium text-text-muted-light dark:text-text-muted-dark">@role.RoleId</td>
                                    <th class="px-6 py-4 font-medium text-text-light dark:text-text-dark whitespace-nowrap" scope="row">@role.RoleName</th>
                                    <td class="px-6 py-4 text-text-muted-light dark:text-text-muted-dark">@role.Description</td>
                                    <td class="px-6 py-4 text-right flex justify-end gap-2">
                                        <button class="edit-btn p-2 rounded-md hover:bg-primary/20 text-text-muted-light dark:text-text-muted-dark hover:text-primary transition-colors" data-id="@role.RoleId">
                                            <span class="material-symbols-outlined text-lg">edit</span>
                                        </button>
                                        <button class="delete-btn p-2 rounded-md hover:bg-red-500/20 text-text-muted-light dark:text-text-muted-dark hover:text-red-500 transition-colors" data-id="@role.RoleId">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Role Modal -->
<div id="roleModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-lg mx-4 overflow-hidden transform transition-all duration-300 scale-95 opacity-0" id="modalContent">
        <div class="p-6 border-b border-border-light dark:border-border-dark flex justify-between items-center">
            <h3 id="modalTitle" class="text-xl font-bold text-text-light dark:text-text-dark">Thêm vai trò mới</h3>
            <button type="button" id="closeModalBtn" class="text-text-muted-light dark:text-text-muted-dark hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
        <form id="roleForm" class="p-6 space-y-6">
            <input type="hidden" id="RoleId" name="RoleId" value="0" />
            @Html.AntiForgeryToken()

            <div>
                <label for="RoleName" class="block text-sm font-medium text-text-light dark:text-text-dark mb-2">Tên vai trò</label>
                <input type="text" id="RoleName" name="RoleName"
                       class="w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-lg bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary shadow-sm transition-all duration-200"
                       required maxlength="50" placeholder="Nhập tên vai trò...">
                <div id="roleNameError" class="text-red-500 text-sm mt-2 hidden"></div>
            </div>

            <div>
                <label for="Description" class="block text-sm font-medium text-text-light dark:text-text-dark mb-2">Mô tả</label>
                <textarea id="Description" name="Description" rows="4"
                          class="w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-lg bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary shadow-sm transition-all duration-200 resize-none"
                          maxlength="250" placeholder="Nhập mô tả vai trò..."></textarea>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" id="cancelBtn" class="px-6 py-3 text-sm font-medium text-text-muted-light dark:text-text-muted-dark bg-background-light dark:bg-background-dark border border-border-light dark:border-border-dark rounded-lg hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-200 shadow-sm">
                    Hủy
                </button>
                <button type="submit" id="saveBtn" class="px-6 py-3 bg-[#f27f0d] text-white text-sm font-medium rounded-lg hover:opacity-90 transition-all duration-200 shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">save</span>
                    Lưu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-md mx-4">
        <div class="p-6 border-b border-border-light dark:border-border-dark">
            <h3 class="text-xl font-bold text-text-light dark:text-text-dark">Xác nhận xóa</h3>
        </div>
        <div class="p-6">
            <p class="text-text-light dark:text-text-dark mb-6">Bạn có chắc chắn muốn xóa vai trò này?</p>
            <div class="flex justify-end gap-3">
                <button type="button" id="cancelDeleteBtn" class="px-4 py-2 text-sm font-medium text-text-muted-light dark:text-text-muted-dark hover:text-text-light dark:hover:text-text-dark transition-colors">
                    Hủy
                </button>
                <button type="button" id="confirmDeleteBtn" class="px-4 py-2 bg-[#f27f0d] text-white text-sm font-medium rounded-lg hover:opacity-90 transition-opacity">
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRoleId = 0;

        // Show message
        function showMessage(message, type = 'success') {
            const container = document.getElementById('messageContainer');
            const bgColor = type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700';

            container.innerHTML = `
                <div class="${bgColor} border px-4 py-3 rounded relative" role="alert">
                    <span class="block sm:inline">${message}</span>
                </div>
            `;

            setTimeout(() => {
                container.innerHTML = '';
            }, 5000);
        }

        // Modal functions
        function showModal() {
            const modal = document.getElementById('roleModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function hideModal() {
            const modal = document.getElementById('roleModal');
            const content = document.getElementById('modalContent');
            content.classList.add('scale-95', 'opacity-0');
            content.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('roleForm').reset();
                document.getElementById('RoleId').value = '0';
                document.getElementById('modalTitle').textContent = 'Thêm vai trò mới';
                document.getElementById('roleNameError').classList.add('hidden');
            }, 300);
        }

        function showDeleteModal() {
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function hideDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            currentRoleId = 0;
        }

        // Event Listeners
        document.getElementById('addRoleBtn').addEventListener('click', () => {
            showModal();
        });

        document.getElementById('cancelBtn').addEventListener('click', hideModal);
        document.getElementById('closeModalBtn').addEventListener('click', hideModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', hideDeleteModal);

        // Edit buttons
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const roleId = this.getAttribute('data-id');
                await loadRoleData(roleId);
            });
        });

        // Delete buttons
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                currentRoleId = this.getAttribute('data-id');
                showDeleteModal();
            });
        });

        // Select all checkbox
        document.getElementById('checkbox-all').addEventListener('change', function(e) {
            const checkboxes = document.querySelectorAll('.role-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
        });

        // Load role data for editing
        async function loadRoleData(roleId) {
            try {
                console.log('Loading role data for ID:', roleId); // Debug log

                const response = await fetch(`/Role/GetRole?id=${roleId}`);
                const result = await response.json();

                console.log('API Response:', result); // Debug log

                if (result.success) {
                    console.log('Role data:', result.data); // Debug log
                    console.log('RoleName:', result.data.RoleName); // Debug log

        document.getElementById('RoleId').value = result.data.roleId;
        document.getElementById('RoleName').value = result.data.roleName; // Đã sửa
        document.getElementById('Description').value = result.data.description || '';
                    document.getElementById('modalTitle').textContent = 'Sửa vai trò';
                    showModal();
                } else {
                    showMessage(result.message, 'error');
                }
            } catch (error) {
                console.error('Error loading role data:', error); // Debug log
                showMessage('Có lỗi xảy ra khi tải dữ liệu', 'error');
            }
        }

        // Form submission
        document.getElementById('roleForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const roleId = document.getElementById('RoleId').value;
            const url = roleId === '0' ? '/Role/Create' : `/Role/Edit?id=${roleId}`;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (result.success) {
                    showMessage(result.message, 'success');
                    hideModal();
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    if (result.message.includes('Tên vai trò đã tồn tại')) {
                        document.getElementById('roleNameError').textContent = result.message;
                        document.getElementById('roleNameError').classList.remove('hidden');
                    } else {
                        showMessage(result.message, 'error');
                    }
                }
            } catch (error) {
                showMessage('Có lỗi xảy ra khi lưu dữ liệu', 'error');
            }
        });

        // Delete confirmation
        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!currentRoleId) return;

            try {
                const formData = new FormData();
                formData.append('id', currentRoleId);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('/Role/Delete', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showMessage(result.message, 'success');
                    hideDeleteModal();
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showMessage(result.message, 'error');
                    hideDeleteModal();
                }
            } catch (error) {
                showMessage('Có lỗi xảy ra khi xóa', 'error');
                hideDeleteModal();
            }
        });

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#rolesTableBody tr');

            rows.forEach(row => {
                const roleName = row.querySelector('th').textContent.toLowerCase();
                const description = row.querySelector('td:nth-child(4)').textContent.toLowerCase();

                if (roleName.includes(searchTerm) || description.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}