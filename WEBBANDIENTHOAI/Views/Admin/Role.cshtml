@model IEnumerable<WEBBANDIENTHOAI.Models.Role>

@{
    ViewData["Title"] = "Quản lý Vai trò";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

<div class="relative flex min-h-screen w-full flex-col bg-white">
    <div class="flex h-full w-full">
        <main class="w-full flex-1 overflow-y-auto">
            <div class="container mx-auto px-6 py-8">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex flex-col gap-1">
                        <h1 class="text-gray-900 text-3xl font-bold leading-tight tracking-tight">
                            Quản lý Vai trò
                        </h1>
                        <p class="text-gray-600 text-base font-normal leading-normal">
                            Xem, thêm, sửa và xóa vai trò người dùng trong hệ thống.
                        </p>
                    </div>
                    <button id="addRoleBtn"
                            class="flex min-w-[84px] cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg h-10 px-4 bg-[#f27f0d] text-white shadow-sm transition-all hover:bg-[#d66e00] focus:outline-none focus:ring-2 focus:ring-[#f27f0d]/50 focus:ring-offset-2 text-sm font-bold leading-normal tracking-[0.015em]">
                        <span class="material-symbols-outlined">add</span>
                        <span class="truncate">Thêm Vai trò</span>
                    </button>
                </div>

                <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <div class="flex-1">
                        <label class="flex flex-col min-w-40 h-12 w-full md:max-w-md">
                            <div class="flex w-full flex-1 items-stretch rounded-lg h-full shadow-sm">
                                <div class="text-gray-500 flex border border-r-0 border-gray-300 bg-white items-center justify-center pl-4 rounded-l-lg">
                                    <span class="material-symbols-outlined text-2xl">search</span>
                                </div>
                                <input id="searchInput"
                                       class="flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-gray-900 focus:outline-0 focus:ring-2 focus:ring-[#f27f0d]/50 border border-l-0 border-gray-300 bg-white h-full placeholder:text-gray-400 px-4 pl-2 text-base font-normal leading-normal"
                                       placeholder="Tìm kiếm theo tên vai trò..." value="" />
                            </div>
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="flex gap-2">
                            <button class="flex h-12 shrink-0 items-center justify-center gap-x-2 rounded-lg border border-gray-300 bg-white px-4 shadow-sm transition-colors hover:bg-gray-50">
                                <span class="material-symbols-outlined text-gray-700">filter_list</span>
                                <p class="text-gray-700 text-sm font-medium leading-normal">
                                    Bộ lọc
                                </p>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="messageContainer" class="mt-4"></div>

                <div class="mt-6 flow-root">
                    <div class="-mx-6 -my-2 overflow-x-auto">
                        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                            <div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="relative py-3.5 pl-4 pr-3 text-left sm:pl-6" scope="col">
                                                <input id="checkbox-all"
                                                       class="absolute left-4 top-1/2 -mt-2 h-4 w-4 rounded border-gray-300 text-[#f27f0d] focus:ring-[#f27f0d]"
                                                       type="checkbox" />
                                            </th>
                                            <th class="py-3.5 pl-3 pr-3 text-left text-sm font-bold text-gray-900" scope="col">ID</th>
                                            <th class="py-3.5 pl-4 pr-3 text-left text-sm font-bold text-gray-900" scope="col">Tên vai trò</th>
                                            <th class="px-3 py-3.5 text-left text-sm font-bold text-gray-900" scope="col">Mô tả</th>
                                            <th class="px-3 py-3.5 text-center text-sm font-bold text-gray-900" scope="col">Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody id="rolesTableBody" class="divide-y divide-gray-200 bg-white">
                                        @foreach (var role in Model)
                                        {
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td class="relative py-4 pl-4 pr-3 text-sm sm:pl-6">
                                                    <input class="role-checkbox absolute left-4 top-1/2 -mt-2 h-4 w-4 rounded border-gray-300 text-[#f27f0d] focus:ring-[#f27f0d]"
                                                           type="checkbox" data-id="@role.RoleId" />
                                                </td>
                                                <td class="whitespace-nowrap py-4 pl-3 pr-3 text-sm font-medium text-gray-600">
                                                    #@role.RoleId
                                                </td>
                                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm">
                                                    <div class="flex items-center">
                                                        <div class="h-10 w-10 flex-shrink-0 bg-gray-100 rounded-full flex items-center justify-center text-gray-500">
                                                            <span class="material-symbols-outlined">badge</span>
                                                        </div>
                                                        <div class="ml-4">
                                                            <div class="font-bold text-gray-900">@role.RoleName</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-3 py-4 text-sm text-gray-600">
                                                    @(role.Description ?? "Không có mô tả")
                                                </td>
                                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-center text-sm font-medium sm:pr-6">
                                                    <div class="flex items-center justify-center gap-2">
                                                        <button class="edit-btn flex h-8 w-8 items-center justify-center rounded-md text-gray-500 transition-colors hover:bg-gray-100 hover:text-[#f27f0d]"
                                                                data-id="@role.RoleId">
                                                            <span class="material-symbols-outlined text-xl">edit</span>
                                                        </button>
                                                        <button class="delete-btn flex h-8 w-8 items-center justify-center rounded-md text-gray-500 transition-colors hover:bg-red-50 hover:text-red-500"
                                                                data-id="@role.RoleId">
                                                            <span class="material-symbols-outlined text-xl">delete</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Role Modal -->
<div id="roleModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-lg mx-4 overflow-hidden transform transition-all duration-300 scale-95 opacity-0" id="modalContent">
        <div class="p-6 border-b border-gray-200 flex justify-between items-center">
            <h3 id="modalTitle" class="text-xl font-bold text-gray-900">Thêm vai trò mới</h3>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-[#f27f0d] transition-colors">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
        <form id="roleForm" class="p-6 space-y-6">
            <input type="hidden" id="RoleId" name="RoleId" value="0" />
            @Html.AntiForgeryToken()

            <div>
                <label for="RoleName" class="block text-sm font-bold text-gray-700 mb-2">Tên vai trò *</label>
                <input type="text" id="RoleName" name="RoleName"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#f27f0d]/50 focus:border-[#f27f0d] shadow-sm transition-all duration-200"
                       required maxlength="50" placeholder="Nhập tên vai trò...">
                <div id="roleNameError" class="text-red-500 text-sm mt-2 hidden"></div>
            </div>

            <div>
                <label for="Description" class="block text-sm font-bold text-gray-700 mb-2">Mô tả</label>
                <textarea id="Description" name="Description" rows="4"
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#f27f0d]/50 focus:border-[#f27f0d] shadow-sm transition-all duration-200 resize-none"
                          maxlength="250" placeholder="Nhập mô tả vai trò..."></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-4">
                <button type="button" id="cancelBtn" class="px-6 py-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-all duration-200 shadow-sm">
                    Hủy
                </button>
                <button type="submit" id="saveBtn" class="px-6 py-3 bg-[#f27f0d] text-white text-sm font-bold rounded-lg hover:bg-[#d66e00] transition-all duration-200 shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">save</span>
                    Lưu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-md mx-4">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-xl font-bold text-gray-900">Xác nhận xóa</h3>
        </div>
        <div class="p-6">
            <p class="text-gray-900 mb-6">Bạn có chắc chắn muốn xóa vai trò này?</p>
            <div class="flex justify-end gap-3">
                <button type="button" id="cancelDeleteBtn" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
                    Hủy
                </button>
                <button type="button" id="confirmDeleteBtn" class="px-4 py-2 bg-[#f27f0d] text-white text-sm font-bold rounded-lg hover:bg-[#d66e00] transition-opacity">
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRoleId = 0;

        function showMessage(message, type = 'success') {
            const container = document.getElementById('messageContainer');
            const bgColor = type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700';
            container.innerHTML = `<div class="${bgColor} border px-4 py-3 rounded relative" role="alert"><span class="block sm:inline">${message}</span></div>`;
            setTimeout(() => container.innerHTML = '', 5000);
        }

        function showModal() {
            document.getElementById('roleModal').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('modalContent').classList.remove('scale-95', 'opacity-0');
                document.getElementById('modalContent').classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function hideModal() {
            const modal = document.getElementById('roleModal');
            const content = document.getElementById('modalContent');
            content.classList.add('scale-95', 'opacity-0');
            content.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('roleForm').reset();
                document.getElementById('RoleId').value = '0';
                document.getElementById('modalTitle').textContent = 'Thêm vai trò mới';
                document.getElementById('roleNameError').classList.add('hidden');
            }, 300);
        }

        function showDeleteModal() { document.getElementById('deleteModal').classList.remove('hidden'); }
        function hideDeleteModal() { document.getElementById('deleteModal').classList.add('hidden'); currentRoleId = 0; }

        document.getElementById('addRoleBtn').addEventListener('click', showModal);
        document.getElementById('cancelBtn').addEventListener('click', hideModal);
        document.getElementById('closeModalBtn').addEventListener('click', hideModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', hideDeleteModal);

        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const roleId = this.getAttribute('data-id');
                await loadRoleData(roleId);
            });
        });

        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                currentRoleId = this.getAttribute('data-id');
                showDeleteModal();
            });
        });

        document.getElementById('checkbox-all').addEventListener('change', function(e) {
            document.querySelectorAll('.role-checkbox').forEach(cb => cb.checked = e.target.checked);
        });

        async function loadRoleData(roleId) {
            try {
                const response = await fetch(`/Role/GetRole?id=${roleId}`);
                const result = await response.json();

                if (result.success) {
                    document.getElementById('RoleId').value = result.data.roleId;
                    document.getElementById('RoleName').value = result.data.roleName;
                    document.getElementById('Description').value = result.data.description || '';
                    document.getElementById('modalTitle').textContent = 'Sửa vai trò';
                    showModal();
                } else {
                    showMessage(result.message, 'error');
                }
            } catch (error) {
                showMessage('Có lỗi xảy ra khi tải dữ liệu', 'error');
            }
        }

        document.getElementById('roleForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            document.getElementById('roleNameError').classList.add('hidden');

            const formData = new FormData(this);
            const roleId = document.getElementById('RoleId').value;
            const url = roleId === '0' ? '/Role/Create' : `/Role/Edit?id=${roleId}`;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                const result = await response.json();

                if (result.success) {
                    showMessage(result.message, 'success');
                    hideModal();
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    if (result.message.includes('Tên vai trò đã tồn tại')) {
                        document.getElementById('roleNameError').textContent = result.message;
                        document.getElementById('roleNameError').classList.remove('hidden');
                    } else {
                        showMessage(result.message, 'error');
                    }
                }
            } catch (error) {
                showMessage('Có lỗi xảy ra khi lưu dữ liệu', 'error');
            }
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!currentRoleId) return;

            try {
                const formData = new FormData();
                formData.append('id', currentRoleId);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('/Role/Delete', { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    showMessage(result.message, 'success');
                    hideDeleteModal();
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showMessage(result.message, 'error');
                    hideDeleteModal();
                }
            } catch (error) {
                showMessage('Có lỗi xảy ra khi xóa', 'error');
                hideDeleteModal();
            }
        });

        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#rolesTableBody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });
    </script>
}