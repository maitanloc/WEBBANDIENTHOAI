@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h2>Thêm nhân viên</h2>

<form asp-controller="Admin" asp-action="AddStaff" method="post">
    @Html.AntiForgeryToken()
    <div style="max-width:520px">
        <div class="field">
            <input name="username" placeholder="Username" required />
        </div>
        <div class="field">
            <input name="password" type="password" placeholder="Mật khẩu" required />
        </div>
        <div class="field">
            <input name="fullname" placeholder="Họ tên" />
        </div>
        <div class="field">
            <input name="email" placeholder="Email" />
        </div>

        <button class="btn" type="submit">Tạo nhân viên</button>
        <a class="btn ghost" href="@Url.Action("StaffList","Admin")">Quay lại</a>
    </div>
</form>

@if(ViewBag.Error != null) {
    <div class="msg error">@ViewBag.Error</div>
}
