@model IEnumerable<WEBBANDIENTHOAI.Models.Product>

@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "FOXMOBILE - Cửa hàng Điện thoại & Laptop";
}

<!-- Hero Banner Slider -->
<section class="mb-12" data-aos="fade-up">
    <div id="bannerSlider" class="relative w-full h-[480px] overflow-hidden rounded-xl">
        @if (ViewBag.Banners != null)
        {
            foreach (var file in ViewBag.Banners)
            {
                <div class="banner-item absolute inset-0 transition-all duration-[1500ms] opacity-0">
                    <div class="relative w-full h-full bg-cover bg-center"
                         style="background-image: url('/images/banners/@file');">
                        <div class="absolute inset-0 bg-black/40"></div>
                        <div class="relative flex flex-col justify-end p-10 h-full">
                            <h1 class="text-white text-4xl font-black drop-shadow-md">FOX Mobile</h1>
                            <h2 class="text-white/90 text-sm mt-2">
                                Sản Phẩm Nổi Bật
                            </h2>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Default banner if no banners available -->
            <div class="banner-item absolute inset-0 transition-all duration-[1500ms] opacity-1">
                <div class="relative w-full h-full bg-gradient-to-r from-primary to-primary-dark rounded-xl">
                    <div class="absolute inset-0 bg-black/40"></div>
                    <div class="relative flex flex-col justify-center items-center p-10 h-full text-center">
                        <h1 class="text-white text-4xl font-black drop-shadow-md">FOXMOBILE</h1>
                        <h2 class="text-white/90 text-lg mt-2">
                            Thế giới công nghệ cao cấp
                        </h2>
                        <p class="text-white/80 mt-4 max-w-md">
                            Khám phá những sản phẩm công nghệ mới nhất với giá tốt nhất
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Features Section -->
<section class="py-12 bg-white mb-12" data-aos="fade-up">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-orange-50 p-6 rounded-xl text-center hover-lift border border-orange-100">
                <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-shipping-fast text-xl text-white"></i>
                </div>
                <h3 class="font-bold text-lg mb-2 text-gray-800">Giao hàng miễn phí</h3>
                <p class="text-gray-600 text-sm">Cho đơn hàng từ 2 triệu đồng</p>
            </div>
            <div class="bg-orange-50 p-6 rounded-xl text-center hover-lift border border-orange-100">
                <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-shield-alt text-xl text-white"></i>
                </div>
                <h3 class="font-bold text-lg mb-2 text-gray-800">Bảo hành chính hãng</h3>
                <p class="text-gray-600 text-sm">12 tháng tại trung tâm bảo hành</p>
            </div>
            <div class="bg-orange-50 p-6 rounded-xl text-center hover-lift border border-orange-100">
                <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-sync-alt text-xl text-white"></i>
                </div>
                <h3 class="font-bold text-lg mb-2 text-gray-800">Đổi trả dễ dàng</h3>
                <p class="text-gray-600 text-sm">Trong vòng 7 ngày đầu tiên</p>
            </div>
            <div class="bg-orange-50 p-6 rounded-xl text-center hover-lift border border-orange-100">
                <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-headset text-xl text-white"></i>
                </div>
                <h3 class="font-bold text-lg mb-2 text-gray-800">Hỗ trợ 24/7</h3>
                <p class="text-gray-600 text-sm">Tư vấn và giải đáp thắc mắc</p>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="mb-12" data-aos="fade-up">
    <div class="flex justify-center">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full max-w-4xl">
            <a href="/products/smartphones"
               class="flex flex-col items-center gap-4 rounded-xl border-2 border-orange-200 bg-white p-8 hover:shadow-xl text-center hover-lift group transition-all duration-300 hover:border-primary">
                <div class="text-primary group-hover:scale-110 transition-transform duration-300">
                    <i class="fas fa-mobile-alt text-4xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-800 text-xl">Điện thoại</h3>
                    <p class="text-gray-500 text-sm mt-1">Mẫu mới nhất</p>
                </div>
            </a>

            <a href="/products/laptops"
               class="flex flex-col items-center gap-4 rounded-xl border-2 border-orange-200 bg-white p-8 hover:shadow-xl text-center hover-lift group transition-all duration-300 hover:border-primary">
                <div class="text-primary group-hover:scale-110 transition-transform duration-300">
                    <i class="fas fa-laptop text-4xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-800 text-xl">Laptop</h3>
                    <p class="text-gray-500 text-sm mt-1">Hiệu năng cao</p>
                </div>
            </a>
        </div>
    </div>

</section>

<!-- Featured Products Section -->
<section class="mb-12" data-aos="fade-up">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Sản Phẩm Nổi Bật</h2>
        <a href="/products" class="text-primary font-medium hover:text-primary-dark flex items-center text-sm">
            Xem tất cả
            <i class="fas fa-arrow-right ml-2"></i>
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @if (Model != null && Model.Any())
        {
            foreach (var sp in Model)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden group hover:shadow-xl transition-all duration-500 hover-lift">
                    <div class="relative overflow-hidden">
                        @if (sp.PrimaryImage != null)
                        {
                            <img src="@Url.Action("GetProductImage", "HomeUser", new { imageId = sp.PrimaryImage.ImageId })"
                                 class="w-full h-40 object-contain p-2 transition-transform duration-500 group-hover:scale-105 bg-white"
                                 alt="@sp.Name" />
                        }
                        else
                        {
                            <img src="/images/default-product.png"
                                 class="w-full h-40 object-contain p-2 transition-transform duration-500 group-hover:scale-105 bg-white"
                                 alt="@sp.Name" />

                        }

                        <!-- Product Badge -->
                        @if (sp.Price < 5000000)
                        {
                            <div class="absolute top-3 left-3">
                                <span class="bg-gradient-to-r from-primary to-primary-dark text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                                    GIÁ TỐT
                                </span>
                            </div>
                        }

                        <!-- Quick Actions -->
                        <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <button class="w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center hover:bg-gray-50 transition-colors">
                                <i class="fas fa-heart text-gray-600 text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <div class="p-4">
                        <h3 class="font-semibold text-gray-800 text-sm line-clamp-2 mb-2 leading-tight">@sp.Name</h3>

                        @if (!string.IsNullOrEmpty(sp.ShortDescription))
                        {
                            <p class="text-gray-500 text-xs line-clamp-2 mb-3 leading-relaxed">
                                @sp.ShortDescription
                            </p>
                        }

                        <div class="flex items-center justify-between mt-4">
                            <div class="flex flex-col">
                                <span class="text-primary font-bold text-lg">
                                    @String.Format("{0:N0}₫", sp.Price)
                                </span>
                                @if (sp.OldPrice > sp.Price)
                                {
                                    <span class="text-gray-400 text-sm line-through">
                                        @String.Format("{0:N0}₫", sp.OldPrice)
                                    </span>
                                }
                            </div>

                            <!-- SỬA FORM Ở ĐÂY -->
                            <form asp-controller="HomeCarts" asp-action="AddToCart" method="post" class="add-to-cart-form" data-product="@sp.ProductId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@sp.ProductId" />
                                <button type="submit" class="w-10 h-10 bg-gradient-to-r from-primary to-primary-dark text-white rounded-xl flex items-center justify-center hover:shadow-lg transition-all duration-300 transform hover:scale-105 group/btn">
                                    <i class="fas fa-shopping-cart text-sm group-hover/btn:scale-110 transition-transform"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Rating and Reviews -->
                        <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                            <div class="flex items-center space-x-1">
                                <div class="flex text-yellow-400">
                                    <i class="fas fa-star text-xs"></i>
                                    <i class="fas fa-star text-xs"></i>
                                    <i class="fas fa-star text-xs"></i>
                                    <i class="fas fa-star text-xs"></i>
                                    <i class="fas fa-star-half-alt text-xs"></i>
                                </div>
                                <span class="text-gray-500 text-xs ml-1">(128)</span>
                            </div>
                            <span class="text-green-600 text-xs font-medium bg-green-50 px-2 py-1 rounded-full">
                                Còn hàng
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-16">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-box-open text-3xl text-gray-400"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">Không có sản phẩm</h3>
                <p class="text-gray-500 mb-6">Hiện tại không có sản phẩm nào để hiển thị.</p>
                <a href="/products" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-xl hover:bg-primary-dark transition-colors font-medium">
                    <i class="fas fa-store"></i>
                    Khám phá sản phẩm
                </a>
            </div>
        }
    </div>
</section>

<!-- Promotional Banner -->
<section class="mb-12" data-aos="fade-up">
    <div class="bg-gradient-to-r from-primary to-primary-dark rounded-2xl p-8 text-white relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\" 60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Ccircle cx=\"30\" cy=\"30\" r=\"1\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
        </div>

        <div class="relative flex flex-col md:flex-row items-center justify-between">
            <div class="mb-6 md:mb-0 md:mr-8 text-center md:text-left">
                <h2 class="text-2xl md:text-3xl font-bold mb-2">Đăng ký nhận tin khuyến mãi</h2>
                <p class="opacity-90 max-w-md">Nhận thông báo về sản phẩm mới và ưu đãi đặc biệt hàng tuần</p>
            </div>
            <div class="flex w-full md:w-96">
                <input type="email" placeholder="Email của bạn"
                       class="flex-1 px-4 py-3 rounded-l-xl text-gray-800 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50">
                <button class="bg-white text-primary px-6 py-3 rounded-r-xl font-bold hover:bg-gray-100 transition-colors">
                    Đăng ký
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Trust Indicators -->
<section class="py-8 bg-gray-50 rounded-2xl" data-aos="fade-up">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mb-3">
                    <i class="fas fa-shield-alt text-primary text-xl"></i>
                </div>
                <p class="font-semibold text-gray-800">Bảo hành chính hãng</p>
                <p class="text-gray-600 text-sm">12-24 tháng</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mb-3">
                    <i class="fas fa-truck text-primary text-xl"></i>
                </div>
                <p class="font-semibold text-gray-800">Giao hàng toàn quốc</p>
                <p class="text-gray-600 text-sm">Miễn phí từ 2TR</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mb-3">
                    <i class="fas fa-undo-alt text-primary text-xl"></i>
                </div>
                <p class="font-semibold text-gray-800">Đổi trả dễ dàng</p>
                <p class="text-gray-600 text-sm">Trong 7 ngày</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mb-3">
                    <i class="fas fa-headset text-primary text-xl"></i>
                </div>
                <p class="font-semibold text-gray-800">Hỗ trợ 24/7</p>
                <p class="text-gray-600 text-sm">1800 1234</p>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .hover-lift {
            transition: all 0.3s ease;
        }

            .hover-lift:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
            }
    </style>
}

@section Scripts {
    <script>
        // Banner Slider
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize banner slider
            let index = 0;
            const slides = document.querySelectorAll("#bannerSlider .banner-item");

            function showSlide(i) {
                slides.forEach((slide, idx) => {
                    slide.style.opacity = idx === i ? "1" : "0";
                    slide.style.zIndex = idx === i ? "5" : "1";
                });
            }

            if (slides.length > 0) {
                showSlide(index);

                setInterval(() => {
                    index = (index + 1) % slides.length;
                    showSlide(index);
                }, 4000);
            }

            // Add to cart functionality - ĐÃ SỬA
            const addToCartForms = document.querySelectorAll('.add-to-cart-form');
            addToCartForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const productId = this.dataset.product;
                    const button = this.querySelector('button');

                    // Show loading state
                    const originalHTML = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    button.disabled = true;

                    // Gửi request đến server thực tế
                    fetch('/HomeCarts/AddToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: `productId=${productId}&quantity=1`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Show success state
                            button.innerHTML = '<i class="fas fa-check"></i>';
                            button.classList.remove('from-primary', 'to-primary-dark');
                            button.classList.add('bg-green-500');

                            // Update cart count
                            const cartCount = document.querySelector('.cart-count');
                            if (cartCount) {
                                const currentCount = parseInt(cartCount.textContent) || 0;
                                cartCount.textContent = currentCount + 1;
                                cartCount.classList.add('animate-bounce');
                                setTimeout(() => cartCount.classList.remove('animate-bounce'), 1000);
                            }

                            // Show success message
                            showNotification('Đã thêm sản phẩm vào giỏ hàng!', 'success');

                            // Reset button after 2 seconds
                            setTimeout(() => {
                                button.innerHTML = originalHTML;
                                button.classList.remove('bg-green-500');
                                button.classList.add('from-primary', 'to-primary-dark');
                                button.disabled = false;
                            }, 2000);
                        } else {
                            if (data.requireLogin) {
                                if (confirm('Bạn cần đăng nhập để mua hàng. Đến trang đăng nhập?')) {
                                    window.location.href = '/Account/Login';
                                } else {
                                    // Reset button nếu user không muốn login
                                    button.innerHTML = originalHTML;
                                    button.disabled = false;
                                }
                            } else {
                                showNotification(data.message, 'error');
                                button.innerHTML = originalHTML;
                                button.disabled = false;
                            }
                        }
                    })
                    .catch(error => {
                        showNotification('Có lỗi xảy ra khi thêm vào giỏ hàng', 'error');
                        button.innerHTML = originalHTML;
                        button.disabled = false;
                    });
                });
            });

            // Notification function
            function showNotification(message, type = 'info') {
                // Create notification element
                const notification = document.createElement('div');
                notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-xl shadow-lg transform transition-all duration-300 ${
                    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
                }`;
                notification.innerHTML = `
                    <div class="flex items-center gap-3">
                        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                        <span>${message}</span>
                    </div>
                `;

                // Add to page
                document.body.appendChild(notification);

                // Remove after 3 seconds
                setTimeout(() => {
                    notification.style.transform = 'translateX(100%)';
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 300);
                }, 3000);
            }

            // Initialize AOS
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 800,
                    once: true,
                    offset: 100
                });
            }
        });
    </script>
}