@model IEnumerable<WEBBANDIENTHOAI.Models.Product>

@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "Laptop";

    var brands = ViewBag.Brands as List<string>;
    string selectedBrand = Context.Request.Query["brand"];
    string selectedSort = Context.Request.Query["sort"];
}

<div class="max-w-7xl mx-auto px-4 my-10">

    <!-- FORM FILTER & SORT -->
    <form id="filterSortForm" method="get" action="/HomeUser/Laptops" class="bg-white p-4 rounded-xl shadow mb-6 flex flex-wrap gap-4 items-center">

        <!-- BRAND FILTER -->
        <div>
            <label for="brand-select" class="sr-only">Thương hiệu</label>
            <select name="brand" id="brand-select" class="form-select block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                <option value="">Tất cả thương hiệu</option>
                @foreach (var b in brands)
                {
                    <option value="@b" selected="@(selectedBrand == b ? "selected" : null)">@b</option>
                }
            </select>
        </div>

        <!-- SORT FILTER -->
        <div>
            <label for="sort-select" class="sr-only">Sắp xếp</label>
            <select name="sort" id="sort-select" class="form-select block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                <option value="newest" selected="@(selectedSort == "newest" ? "selected" : null)">Mới nhất</option>
                <option value="price_asc" selected="@(selectedSort == "price_asc" ? "selected" : null)">Giá tăng dần</option>
                <option value="price_desc" selected="@(selectedSort == "price_desc" ? "selected" : null)">Giá giảm dần</option>
            </select>
        </div>
    </form>


    <h2 class="text-2xl font-bold text-gray-800 mb-6">
        Laptop mới nhất
    </h2>

    <!-- PRODUCT GRID -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

        @foreach (var sp in Model)
        {
            <a href="@Url.Action("ProductDetails", "HomeUser", new { id = sp.ProductId })"
               class="group bg-white rounded-2xl border shadow-sm hover:shadow-xl transition-all duration-300 p-4 flex flex-col">

                <div class="relative">
                    <img src="@Url.Action("GetProductImage", "HomeUser", new { imageId = sp.PrimaryImage?.ImageId })"
                         class="w-full h-40 object-contain group-hover:scale-105 transition-transform duration-300" />

                    @if (sp.Price < 20000000)
                    {
                        <span class="absolute top-2 left-2 bg-green-500 text-white text-xs px-3 py-1 rounded-full shadow">
                            GIÁ TỐT
                        </span>
                    }
                </div>

                <h3 class="mt-3 font-semibold text-gray-800 line-clamp-2 text-sm min-h-[40px]">
                    @sp.Name
                </h3>

                <div class="mt-2">
                    <span class="text-primary font-bold text-lg">
                        @String.Format("{0:N0}₫", sp.Price)
                    </span>

                    @if (sp.OldPrice > sp.Price)
                    {
                        <span class="text-gray-400 text-sm line-through ml-2">
                            @String.Format("{0:N0}₫", sp.OldPrice)
                        </span>
                    }
                </div>

                <button class="mt-4 w-full bg-primary text-white py-2 rounded-xl font-medium hover:bg-primary-dark transition">
                    Xem chi tiết
                </button>

            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('brand-select').addEventListener('change', function () {
            document.getElementById('filterSortForm').submit();
        });

        document.getElementById('sort-select').addEventListener('change', function () {
            document.getElementById('filterSortForm').submit();
        });
    </script>
}
