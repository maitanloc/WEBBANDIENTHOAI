@model WEBBANDIENTHOAI.ViewModels.ProductDetailsVm

@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = Model.Name + " - FOXMOBILE";
}

<!-- Product Details Section -->
<section class="py-8 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <!-- Breadcrumb -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/HomeUser/Index" class="text-gray-500 hover:text-primary transition-colors">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                <li class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-300 text-xs mx-2"></i>
                    @if (Model.CategoryId == 1) // Smartphone
                    {
                        <a href="/HomeUser/Smartphones" class="text-gray-500 hover:text-primary transition-colors">Điện thoại</a>
                    }
                    else if (Model.CategoryId == 2) // Laptop
                    {
                        <a href="/HomeUser/Laptops" class="text-gray-500 hover:text-primary transition-colors">Laptop</a>
                    }
                    else
                    {
                        <a href="/products" class="text-gray-500 hover:text-primary transition-colors">Sản phẩm</a>
                    }
                </li>
                <li class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-300 text-xs mx-2"></i>
                    <span class="text-gray-800 font-medium">@Model.Name</span>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Image Gallery -->
            <div class="space-y-4">
                <!-- Main Image -->
                <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200">
                    @if (Model.Images.Any())
                    {
                        <img id="mainImage" 
                             src="@Url.Action("GetProductImage", "HomeUser", new { imageId = Model.Images.First().ImageId })" 
                             class="w-full h-96 object-contain transition-opacity duration-300" 
                             alt="@Model.Name" />
                    }
                    else
                    {
                        <img id="mainImage" 
                             src="/images/default-product.png" 
                             class="w-full h-96 object-contain" 
                             alt="@Model.Name" />
                    }
                </div>

            </div>


            <!-- Product Info -->
            <div class="space-y-6">
                <!-- Brand & Name -->
                <div>
                    @if (!string.IsNullOrEmpty(Model.Brand))
                    {
                        <span class="text-primary font-semibold text-lg">@Model.Brand</span>
                    }
                    <h1 class="text-3xl font-bold text-gray-900 mt-2 leading-tight">@Model.Name</h1>
                    
                    <!-- Rating -->
                    <div class="flex items-center space-x-2 mt-3">
                        <div class="flex text-yellow-400">
                            <i class="fas fa-star text-sm"></i>
                            <i class="fas fa-star text-sm"></i>
                            <i class="fas fa-star text-sm"></i>
                            <i class="fas fa-star text-sm"></i>
                            <i class="fas fa-star-half-alt text-sm"></i>
                        </div>
                        <span class="text-gray-500 text-sm">(128 đánh giá)</span>
                        <span class="text-gray-500 text-sm">•</span>
                        <span class="text-gray-500 text-sm">@Model.SKU</span>
                    </div>
                </div>

                <!-- Pricing -->
                <div class="space-y-2">
                    <div class="flex items-center space-x-4">
                        <span class="text-3xl font-bold text-primary">
                            @String.Format("{0:N0}₫", Model.Price)
                        </span>
                        @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
                        {
                            var discountPercent = (int)((Model.OldPrice.Value - Model.Price) / Model.OldPrice.Value * 100);

                            <span class="text-xl text-gray-400 line-through">
                                @String.Format("{0:N0}₫", Model.OldPrice)
                            </span>
                            <span class="bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold">
                                -@discountPercent%
                            </span>
                        }
                    </div>
                    <p class="text-green-600 font-semibold flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        @Model.StatusName
                    </p>
                </div>

                <!-- Short Description -->
                @if (!string.IsNullOrEmpty(Model.ShortDescription))
                {
                    <div class="bg-orange-50 rounded-xl p-4 border border-orange-200">
                        <p class="text-gray-700 text-sm leading-relaxed">@Model.ShortDescription</p>
                    </div>
                }

                <!-- Color & Size Options -->
                <div class="space-y-4">
                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <div>
                            <span class="font-semibold text-gray-800 block mb-2">Màu sắc:</span>
                            <div class="flex space-x-3">
                                <button class="px-4 py-2 bg-primary text-white rounded-lg font-medium border-2 border-primary">
                                    @Model.Color
                                </button>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Size))
                    {
                        <div>
                            <span class="font-semibold text-gray-800 block mb-2">Kích thước:</span>
                            <div class="flex space-x-3">
                                <button class="px-4 py-2 bg-gray-100 text-gray-800 rounded-lg font-medium border-2 border-gray-300 hover:border-primary transition-colors">
                                    @Model.Size
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Add to Cart Section -->
                <div class="space-y-4 pt-4 border-t border-gray-200">
                    <div class="flex items-center space-x-4">
                        <span class="font-semibold text-gray-800">Số lượng:</span>
                        <div class="flex items-center border border-gray-300 rounded-lg bg-white">
                            <button type="button" id="decreaseQty" class="px-4 py-3 text-gray-600 hover:bg-gray-100 transition-colors rounded-l-lg">
                                <i class="fas fa-minus text-xs"></i>
                            </button>
                            <input type="number" id="quantity" value="1" min="1" max="@Model.InventoryQuantity"
                                   class="w-16 text-center border-0 focus:ring-0 focus:outline-none bg-transparent" />
                            <button type="button" id="increaseQty" class="px-4 py-3 text-gray-600 hover:bg-gray-100 transition-colors rounded-r-lg">
                                <i class="fas fa-plus text-xs"></i>
                            </button>
                        </div>
                        @if (Model.InventoryQuantity > 0)
                        {
                            <span class="text-sm text-gray-500">Còn <span class="font-semibold">@Model.InventoryQuantity</span> sản phẩm</span>
                        }
                        else
                        {
                            <span class="text-sm text-red-500 font-semibold">Hết hàng</span>
                        }
                    </div>

                    <div class="flex space-x-4">
                        <button id="addToCartBtn"
                                data-product-id="@Model.ProductId"
                                class="flex-1 bg-gradient-to-r from-primary to-primary-dark text-white py-4 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-[1.02] flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                @(Model.InventoryQuantity == 0 ? "disabled" : "")>
                            <i class="fas fa-shopping-cart"></i>
                            <span>Thêm vào giỏ hàng</span>
                        </button>
                        <button id="buyNowBtn"
                                class="flex-1 bg-gradient-to-r from-green-500 to-green-600 text-white py-4 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-[1.02] flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                @(Model.InventoryQuantity == 0 ? "disabled" : "")>
                            <i class="fas fa-bolt"></i>
                            <span>Đặt hàng</span>
                        </button>
                    </div>
                </div>

                <form id="antiForgeryForm" class="hidden">
                    @Html.AntiForgeryToken()
                </form>

                <!-- Product Features -->
                <div class="grid grid-cols-2 gap-4 pt-6 border-t border-gray-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary bg-opacity-10 rounded-full flex items-center justify-center">
                            <i class="fas fa-shipping-fast text-primary text-sm"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800 text-sm">Giao hàng miễn phí</p>
                            <p class="text-gray-500 text-xs">Cho đơn từ 2TR</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary bg-opacity-10 rounded-full flex items-center justify-center">
                            <i class="fas fa-shield-alt text-primary text-sm"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800 text-sm">Bảo hành chính hãng</p>
                            <p class="text-gray-500 text-xs">12-24 tháng</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary bg-opacity-10 rounded-full flex items-center justify-center">
                            <i class="fas fa-sync-alt text-primary text-sm"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800 text-sm">Đổi trả dễ dàng</p>
                            <p class="text-gray-500 text-xs">Trong 7 ngày</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary bg-opacity-10 rounded-full flex items-center justify-center">
                            <i class="fas fa-credit-card text-primary text-sm"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800 text-sm">Trả góp 0%</p>
                            <p class="text-gray-500 text-xs">Qua thẻ tín dụng</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Specifications Section -->
<section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl font-bold mb-8 text-gray-900">Thông số kỹ thuật</h2>
        
        @if (Model.CategoryId == 2 && Model.LaptopConfiguration != null)
        {
            <!-- Laptop Specifications -->
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.CPU))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Bộ vi xử lý:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.CPU</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.RAM))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">RAM:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.RAM</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.Storage))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Lưu trữ:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.Storage</span>
                            </div>
                        }
                    </div>
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.Battery))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Pin:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.Battery</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.OperatingSystem))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Hệ điều hành:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.OperatingSystem</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LaptopConfiguration.ScreenSize))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Màn hình:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.LaptopConfiguration.ScreenSize</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (Model.CategoryId == 1 && Model.PhoneConfiguration != null)
        {
            <!-- Phone Specifications -->
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.CPU))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Bộ vi xử lý:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.CPU</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.RAM))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">RAM:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.RAM</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.InternalStorage))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Bộ nhớ trong:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.InternalStorage</span>
                            </div>
                        }
                    </div>
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.Battery))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Pin:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.Battery</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.Camera))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Camera:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.Camera</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PhoneConfiguration.Cores))
                        {
                            <div class="flex justify-between items-start border-b border-gray-100 pb-4">
                                <span class="text-gray-600 font-medium flex-1">Số nhân:</span>
                                <span class="font-semibold text-gray-900 text-right flex-1">@Model.PhoneConfiguration.Cores</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl p-8 text-center">
                <i class="fas fa-info-circle text-4xl text-gray-300 mb-4"></i>
                <p class="text-gray-500">Chưa có thông số kỹ thuật cho sản phẩm này</p>
            </div>
        }
    </div>
</section>

<!-- Related Products Section -->
<section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl font-bold mb-8 text-gray-900">Sản phẩm liên quan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="relatedProducts">
            <!-- Related products will be loaded via AJAX -->
        </div>
    </div>
</section>

@section Styles {
    <style>
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .thumbnail.active {
            border-color: #f97316;
            box-shadow: 0 0 0 2px rgba(249, 115, 22, 0.1);
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Image Gallery Functionality
            const mainImage = document.getElementById('mainImage');
            const thumbnails = document.querySelectorAll('.thumbnail');

            thumbnails.forEach(thumb => {
                thumb.addEventListener('click', function() {
                    const imageId = this.dataset.imageid;
                    const newSrc = `@Url.Action("GetProductImage", "HomeUser")?imageId=${imageId}`;
                    
                    // Fade out current image
                    mainImage.style.opacity = '0';
                    
                    setTimeout(() => {
                        mainImage.src = newSrc;
                        mainImage.style.opacity = '1';
                    }, 150);

                    // Update active state
                    thumbnails.forEach(t => t.classList.remove('active', 'border-primary'));
                    this.classList.add('active', 'border-primary');
                });
            });

            // Quantity Controls
            const quantityInput = document.getElementById('quantity');
            const decreaseBtn = document.getElementById('decreaseQty');
            const increaseBtn = document.getElementById('increaseQty');

            quantityInput.addEventListener('input', function () {
                const current = parseInt(this.value);
                const max = parseInt(this.max);

                if (current > max) {
                    showCustomAlert('Số lượng sản phẩm không đủ. Tối đa: ' + max);
                    this.value = max;
                }
            });

            decreaseBtn.addEventListener('click', () => {
                const current = parseInt(quantityInput.value);
                if (current > 1) {
                    quantityInput.value = current - 1;
                }
            });

            increaseBtn.addEventListener('click', () => {
                const current = parseInt(quantityInput.value);
                const max = parseInt(quantityInput.max);
                if (current < max) {
                    quantityInput.value = current + 1;
                }
            });

            // Add to Cart Functionality
            const addToCartBtn = document.getElementById('addToCartBtn');
            addToCartBtn.addEventListener('click', function() {
                const productId = @Model.ProductId;
                const quantity = parseInt(quantityInput.value);

                // Show loading state
                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Đang thêm...</span>';
                this.disabled = true;

                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                // Send AJAX request
                fetch('/HomeCarts/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `productId=${productId}&quantity=${quantity}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success state
                        this.innerHTML = '<i class="fas fa-check"></i><span>Đã thêm!</span>';
                        this.classList.remove('from-primary', 'to-primary-dark');
                        this.classList.add('bg-green-500');

                        // Update cart count
                        const cartCount = document.querySelector('.cart-count');
                        if (cartCount) {
                            const currentCount = parseInt(cartCount.textContent) || 0;
                            cartCount.textContent = currentCount + quantity;
                            cartCount.classList.add('animate-bounce');
                            setTimeout(() => cartCount.classList.remove('animate-bounce'), 1000);
                        }

                        // Show success notification
                        showNotification('Đã thêm sản phẩm vào giỏ hàng!', 'success');

                        // Reset button after 2 seconds
                        setTimeout(() => {
                            this.innerHTML = originalHTML;
                            this.classList.remove('bg-green-500');
                            this.classList.add('from-primary', 'to-primary-dark');
                            this.disabled = false;
                        }, 2000);
                    } else {
                        if (data.requireLogin) {
                            if (confirm('Bạn cần đăng nhập để mua hàng. Đến trang đăng nhập?')) {
                                window.location.href = '/Account/LoginRegister';
                            } else {
                                this.innerHTML = originalHTML;
                                this.disabled = false;
                            }
                        } else {
                            showNotification(data.message, 'error');
                            this.innerHTML = originalHTML;
                            this.disabled = false;
                        }
                    }
                })
                .catch(error => {
                    showNotification('Có lỗi xảy ra khi thêm vào giỏ hàng', 'error');
                    this.innerHTML = originalHTML;
                    this.disabled = false;
                });
            });

            const buyNowBtn = document.getElementById('buyNowBtn');
            buyNowBtn.addEventListener('click', function () {
                const productId = @Model.ProductId;
                const quantity = parseInt(quantityInput.value);

                // Hiển thị trạng thái loading
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Đang xử lý...</span>';
                this.disabled = true;

                // Chuyển hướng đến trang BuyNow
                window.location.href = `/HomeCarts/BuyNow?productId=${productId}&quantity=${quantity}`;
            });

            // Load related products
            loadRelatedProducts();

            function loadRelatedProducts() {
                const categoryId = @Model.CategoryId;
                const currentProductId = @Model.ProductId;

                fetch(`/HomeUser/GetRelatedProducts?categoryId=${categoryId}&excludeProductId=${currentProductId}&count=4`)
                    .then(response => response.json())
                    .then(products => {
                        const container = document.getElementById('relatedProducts');
                        if (products && products.length > 0) {
                            container.innerHTML = products.map(product => `
                                <a href="/HomeUser/Productdetails/${product.productId}" class="block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden group hover:shadow-lg transition-all duration-300">
                                    <div class="relative overflow-hidden">
                                        <img src="/HomeUser/GetProductImage?imageId=${product.primaryImageId || 0}" 
                                             class="w-full h-40 object-contain p-4 transition-transform duration-300 group-hover:scale-105" 
                                             alt="${product.name}" />
                                        <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                            <button class="w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center hover:bg-gray-50">
                                                <i class="fas fa-heart text-gray-600 text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="p-4">
                                        <h3 class="font-semibold text-gray-800 text-sm line-clamp-2 mb-2">${product.name}</h3>
                                        <div class="flex items-center justify-between">
                                            <span class="text-primary font-bold">${formatPrice(product.price)}</span>
                                            <button data-product-id="${product.productId}" class="add-to-cart-related w-8 h-8 bg-primary text-white rounded-lg flex items-center justify-center hover:bg-primary-dark transition-colors">
                                                <i class="fas fa-shopping-cart text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </a>
                            `).join('');
                        } else {
                            container.innerHTML = '<p class="col-span-full text-center text-gray-500 py-8">Không có sản phẩm liên quan</p>';
                        }
                    })
                    .catch(error => {
                        console.error('Error loading related products:', error);
                    });
            }

            function formatPrice(price) {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
            }

            function showNotification(message, type = 'info') {
                const notification = document.createElement('div');
                notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-xl shadow-lg transform transition-all duration-300 ${
                    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
                }`;
                notification.innerHTML = `
                    <div class="flex items-center gap-3">
                        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                        <span>${message}</span>
                    </div>
                `;

                document.body.appendChild(notification);

                setTimeout(() => {
                    notification.style.transform = 'translateX(100%)';
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 300);
                }, 3000);
            }
        });
    </script>
}