@model WEBBANDIENTHOAI.Models.CartViewModel

@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "Giỏ hàng - FOXMOBILE";
    // Tính tổng tiền ngay tại View vì Model hiện tại chưa có biến GrandTotal
    decimal grandTotal = Model.Items != null ? Model.Items.Sum(i => i.Quantity * i.UnitPrice) : 0;
}

<div class="container mx-auto px-4 py-8">
    <div class="flex flex-col flex-1">

        <div class="flex flex-wrap gap-2 mb-6">
            <span class="text-gray-800 dark:text-gray-200 text-sm font-medium leading-normal">Giỏ hàng</span>
        </div>

        <div class="flex flex-wrap justify-between gap-3 mb-8">
            <h1 class="text-gray-800 dark:text-gray-100 text-3xl md:text-4xl font-bold leading-tight tracking-tight">Giỏ hàng của bạn</h1>
            <span class="text-gray-500 dark:text-gray-400 text-sm">@(Model.Items?.Count ?? 0) sản phẩm</span>
        </div>

        @if (Model.Items != null && Model.Items.Count > 0)
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                <div class="lg:col-span-2 flex flex-col gap-6">

                    <div class="flex items-center gap-4 bg-white dark:bg-gray-800 p-4 min-h-16 justify-between border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
                        <div class="flex items-center gap-4">
                            <input id="select-all" type="checkbox" class="h-5 w-5 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/50" />
                            <label for="select-all" class="text-base font-medium text-gray-800 dark:text-gray-200 cursor-pointer">Chọn tất cả (@Model.Items.Count sản phẩm)</label>
                        </div>
                        <form asp-action="ClearCart" asp-controller="HomeCarts" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa hết giỏ hàng?');">
                            <button type="submit" class="flex items-center gap-2 text-sm font-medium text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300 transition-colors">
                                <i class="fas fa-trash-alt text-base"></i> Xoá tất cả
                            </button>
                        </form>
                    </div>

                    <div class="flex flex-col gap-4">
                        @foreach (var item in Model.Items)
                        {
                            <div class="flex items-center gap-4 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300" data-product-id="@item.ProductId">
                                <input type="checkbox" class="item-checkbox h-5 w-5 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/50" checked />

                                <img src="@item.ImageUrl"
                                     class="w-24 h-24 object-contain rounded-xl bg-gray-100 p-1 shadow-sm"
                                     alt="@item.ProductName" />

                                <div class="flex-1">
                                    <h3 class="text-gray-800 dark:text-gray-200 font-semibold text-lg">@item.ProductName</h3>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Mã SP: @item.ProductId | @item.Color</p>
                                    <p class="text-primary font-bold text-xl mt-2">@item.UnitPrice.ToString("N0")₫</p>
                                </div>

                                <div class="flex items-center gap-2">
                                    <button onclick="updateQuantity(@item.CartDetailId, @(item.Quantity - 1))" class="w-8 h-8 border border-gray-300 dark:border-gray-600 rounded-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        <i class="fas fa-minus text-xs"></i>
                                    </button>

                                    <input type="text" value="@item.Quantity" class="w-12 text-center border border-gray-300 dark:border-gray-600 rounded-lg bg-transparent" readonly />

                                    <button onclick="updateQuantity(@item.CartDetailId, @(item.Quantity + 1))" class="w-8 h-8 border border-gray-300 dark:border-gray-600 rounded-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        <i class="fas fa-plus text-xs"></i>
                                    </button>

                                    <form asp-action="RemoveItem" asp-controller="HomeCarts" method="post" class="ml-2">
                                        <input type="hidden" name="cartDetailId" value="@item.CartDetailId" />
                                        <button type="submit" class="text-red-500 hover:text-red-700">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
                        <a asp-controller="HomeUser" asp-action="Index" class="flex items-center gap-2 text-primary hover:text-primary-dark font-medium transition-colors">
                            <i class="fas fa-arrow-left text-sm"></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>

                <aside class="lg:col-span-1 sticky top-24">
                    <div class="bg-white dark:bg-gray-800 p-6 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm flex flex-col gap-6">
                        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200">Tóm tắt đơn hàng</h2>

                        <div class="flex items-center justify-between">
                            <p class="text-gray-600 dark:text-gray-400">Tạm tính (@Model.Items.Count sản phẩm)</p>
                            <p class="font-medium text-gray-800 dark:text-gray-200">@grandTotal.ToString("N0")₫</p>
                        </div>

                        <div class="border-t border-dashed border-gray-300 dark:border-gray-600"></div>

                        <div class="flex items-center justify-between">
                            <p class="text-lg text-gray-600 dark:text-gray-400">Tổng cộng</p>
                            <p class="font-bold text-2xl text-primary">@grandTotal.ToString("N0")₫</p>
                        </div>

                        <a href="/Checkout" class="flex w-full h-12 items-center justify-center bg-gradient-to-r from-primary to-primary-dark text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:scale-105 gap-2">
                            <span>Tiến hành thanh toán</span>
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>

                    </div>
                </aside>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Giỏ hàng của bạn đang trống</h2>
                <p class="text-gray-500 mb-8">Hãy quay lại trang chủ để chọn món hàng yêu thích nhé!</p>
                <a asp-controller="HomeUser" asp-action="Index" class="px-6 py-3 bg-primary text-white rounded-xl font-bold hover:bg-primary-dark transition-colors">
                    Về trang chủ
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .form-input:focus {
            box-shadow: 0 0 0 3px rgba(244, 140, 37, 0.1);
            border-color: #f48c25;
        }
    </style>
}

@section Scripts {
    <script>
        function updateQuantity(cartDetailId, newQuantity) {
            if (newQuantity < 1) return;

            // Gửi Ajax request để cập nhật
            fetch('/HomeCarts/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `cartDetailId=${cartDetailId}&quantity=${newQuantity}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload(); // Load lại trang để cập nhật giá tiền
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}