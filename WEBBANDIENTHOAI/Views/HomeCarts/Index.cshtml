@model WEBBANDIENTHOAI.ViewModels.CartIndexViewModel

@{
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
    ViewData["Title"] = "Giỏ hàng - FOXMOBILE";
}

<div class="container mx-auto px-4 py-8">
    <div class="flex flex-col flex-1">

        <div class="flex flex-wrap gap-2 mb-6">
            <span class="text-gray-800 dark:text-gray-200 text-sm font-medium leading-normal">Giỏ hàng</span>
        </div>

        <div class="flex flex-wrap justify-between gap-3 mb-8">
            <h1 class="text-gray-800 dark:text-gray-100 text-3xl md:text-4xl font-bold leading-tight tracking-tight">Giỏ
                hàng của bạn</h1>
            <span class="text-gray-500 dark:text-gray-400 text-sm">@(Model.TotalItems) sản phẩm</span>
        </div>

        <!-- Hiển thị thông báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model.CartItems != null && Model.CartItems.Count > 0)
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                <div class="lg:col-span-2 flex flex-col gap-6">

                    <div
                        class="flex items-center gap-4 bg-white dark:bg-gray-800 p-4 min-h-16 justify-between border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
                        <div class="flex items-center gap-4">
                            <input id="select-all" type="checkbox"
                                class="h-5 w-5 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/50" />
                            <label for="select-all"
                                class="text-base font-medium text-gray-800 dark:text-gray-200 cursor-pointer">Chọn tất cả
                                (@Model.TotalItems sản phẩm)</label>
                        </div>
                        <form asp-controller="HomeCarts" asp-action="ClearCart" method="post">
                            <button type="submit"
                                class="flex items-center gap-2 text-sm font-medium text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300 transition-colors">
                                <i class="fas fa-trash-alt text-base"></i> Xoá tất cả
                            </button>
                        </form>
                    </div>

                    <div class="flex flex-col gap-4">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="flex items-center gap-4 p-6 cart-item bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm"
                                data-price="@(item.Price + item.OptionsPrice)" data-quantity="@item.Quantity" data-product-id="@item.ProductId"
                                data-inventory-quantity="@item.InventoryQuantity">

                                <input type="checkbox"
                                    class="item-checkbox h-5 w-5 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/50"
                                    checked />

                                <img src="@item.ProductImage"
                                    class="w-24 h-24 object-contain rounded-xl bg-gray-100 p-1 shadow-sm"
                                    alt="@item.ProductName" />

                                <div class="flex-1">
                                    <h3 class="text-gray-800 dark:text-gray-200 font-semibold text-lg">@item.ProductName</h3>
                                    @if (!string.IsNullOrEmpty(item.SelectedOptionsDisplay))
                                    {
                                        <p class="text-sm font-medium text-orange-600 mt-1">Cấu hình: @item.SelectedOptionsDisplay</p>
                                    }
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Mã SP: @item.ProductId</p>
                                    <p class="text-primary font-bold text-xl mt-2">@((item.Price + item.OptionsPrice).ToString("N0"))₫</p>
                                </div>

                                <div class="flex items-center gap-2">
                                    <button type="button" onclick="updateQuantity(@item.ProductId, 'decrease')"
                                        class="w-8 h-8 border border-gray-300 dark:border-gray-600 rounded-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        <i class="fas fa-minus text-xs"></i>
                                    </button>

                                    <input type="number" value="@item.Quantity"
                                        class="w-16 px-1 text-center border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 py-2 quantity-input"
                                        data-product-id="@item.ProductId" min="1" max="@item.InventoryQuantity" />


                                    <button type="button" onclick="updateQuantity(@item.ProductId, 'increase')"
                                        class="w-8 h-8 border border-gray-300 dark:border-gray-600 rounded-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        <i class="fas fa-plus text-xs"></i>
                                    </button>

                                    <form asp-action="RemoveItem" method="post" class="ml-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="text-red-500 hover:text-red-700 transition-colors">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
                        <a asp-controller="HomeUser" asp-action="Index"
                            class="flex items-center gap-2 text-primary hover:text-primary-dark font-medium transition-colors">
                            <i class="fas fa-arrow-left text-sm"></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>

                <aside class="lg:col-span-1 sticky top-24">
                    <div
                        class="bg-white dark:bg-gray-800 p-6 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm flex flex-col gap-6">
                        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200">Tóm tắt đơn hàng</h2>

                        <div class="flex items-center justify-between">
                            <p class="text-gray-600 dark:text-gray-400">Tạm tính</p>
                            <p id="subtotal-price" class="font-bold text-2xl text-primary">
                                @Model.GrandTotal.ToString("N0")₫
                            </p>
                        </div>

                        <div class="border-t border-dashed border-gray-300 dark:border-gray-600"></div>

                        <div class="flex items-center justify-between">
                            <p class="text-lg text-gray-600 dark:text-gray-400">Tổng cộng</p>
                            <p id="total-price" class="font-medium text-gray-800 dark:text-gray-200">
                                @Model.GrandTotal.ToString("N0")₫
                            </p>
                        </div>

                        <form asp-controller="ThanhToan" asp-action="Index" method="post" id="checkout-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="selectedProductIds" id="selected-product-ids" />
                            <button type="submit"
                                class="flex w-full h-12 items-center justify-center bg-gradient-to-r from-primary to-primary-dark text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:scale-105 gap-2">
                                <span>Tiến hành thanh toán</span>
                                <i class="fas fa-arrow-right text-sm"></i>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Giỏ hàng của bạn đang trống</h2>
                <p class="text-gray-500 mb-8">Hãy quay lại trang chủ để chọn món hàng yêu thích nhé!</p>
                <a asp-controller="HomeUser" asp-action="Index"
                    class="px-6 py-3 bg-primary text-white rounded-xl font-bold hover:bg-primary-dark transition-colors">
                    Về trang chủ
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .form-input:focus {
            box-shadow: 0 0 0 3px rgba(244, 140, 37, 0.1);
            border-color: #f48c25;
        }
    </style>
}

@section Scripts {
    <script>
        function updateQuantity(productId, direction) {
            const itemElement = document.querySelector(`.cart-item[data-product-id='${productId}']`);
            if (!itemElement) return;

            const quantityInput = itemElement.querySelector('.quantity-input');
            const currentQuantity = parseInt(quantityInput.value);
            const inventoryQuantity = parseInt(itemElement.dataset.inventoryQuantity);

            let newQuantity = currentQuantity;
            if (direction === 'increase') {
                newQuantity++;
            } else if (direction === 'decrease') {
                newQuantity--;
            }

            if (newQuantity < 1) {
                return; // Không cho giảm xuống dưới 1
            }

            if (newQuantity > inventoryQuantity) {
                showCustomAlert('Số lượng sản phẩm không đủ. Tối đa: ' + inventoryQuantity);
                quantityInput.value = inventoryQuantity; // Đặt lại giá trị input
                return;
            }

            sendUpdateRequest(productId, newQuantity);
        }

        document.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('change', function () {
                const productId = this.dataset.productId;
                const newQuantity = parseInt(this.value);
                const maxQuantity = parseInt(this.max);

                if (newQuantity < 1) {
                    showCustomAlert('Số lượng phải lớn hơn 0');
                    this.value = 1; // Hoặc giá trị cũ
                    return;
                }

                if (newQuantity > maxQuantity) {
                    showCustomAlert('Số lượng sản phẩm không đủ. Tối đa: ' + maxQuantity);
                    this.value = maxQuantity;
                    return;
                }
                sendUpdateRequest(productId, newQuantity);
            });
        });


        function sendUpdateRequest(productId, newQuantity) {
            fetch('/HomeCarts/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `productId=${productId}&quantity=${newQuantity}`
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload(); // Tải lại trang để cập nhật giỏ hàng
                    } else {
                        showCustomAlert(data.message);
                        location.reload(); // Tải lại trang để reset về giá trị đúng
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showCustomAlert('Có lỗi xảy ra khi cập nhật số lượng');
                });
        }


        const selectAllCheckbox = document.getElementById("select-all");
        const checkoutForm = document.getElementById("checkout-form");
        const selectedProductIdsInput = document.getElementById("selected-product-ids");

        // Format tiền
        function formatMoney(amount) {
            return amount.toLocaleString("vi-VN") + "₫";
        }

        // Tính tổng
        function updateTotal() {
            let subtotal = 0;
            const items = document.querySelectorAll(".cart-item");

            items.forEach(item => {
                const cb = item.querySelector(".item-checkbox");
                if (cb.checked) {
                    const price = parseFloat(item.dataset.price);
                    const quantity = parseInt(item.querySelector('.quantity-input').value); // Lấy quantity từ input
                    subtotal += price * quantity;
                }
            });

            document.getElementById("subtotal-price").textContent = formatMoney(subtotal);
            document.getElementById("total-price").textContent = formatMoney(subtotal);
        }


        // Lấy danh sách sản phẩm được chọn
        function getSelectedProductIds() {
            const selectedItems = document.querySelectorAll('.cart-item .item-checkbox:checked');
            const selectedProductIds = Array.from(selectedItems).map(checkbox => {
                const cartItem = checkbox.closest('.cart-item');
                return cartItem.dataset.productId;
            }).filter(id => id !== undefined);

            return selectedProductIds;
        }

        // Khi trang load lên
        window.addEventListener("DOMContentLoaded", function () {
            const itemCheckboxes = document.querySelectorAll(".item-checkbox");

            if (itemCheckboxes.length > 0) {
                itemCheckboxes.forEach(cb => cb.checked = true);
            }
            updateTotal(); // Cập nhật tổng tiền khi tải trang
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = true;
            }
        });

        // Event cho các checkbox item
        document.addEventListener("change", function (e) {
            if (e.target.classList.contains("item-checkbox")) {
                const itemCheckboxes = document.querySelectorAll(".item-checkbox");

                const allChecked = Array.from(itemCheckboxes).every(x => x.checked);
                const noneChecked = Array.from(itemCheckboxes).every(x => !x.checked);

                if (selectAllCheckbox) {
                    if (allChecked) {
                        selectAllCheckbox.checked = true;
                        selectAllCheckbox.indeterminate = false;
                    }
                    else if (noneChecked) {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = false;
                    }
                    else {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = true;
                    }
                }
                updateTotal();
            }
        });

        // Nút chọn tất cả
        selectAllCheckbox?.addEventListener("change", function () {
            const itemCheckboxes = document.querySelectorAll(".item-checkbox");
            itemCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
            updateTotal();
        });

        // Xử lý submit form thanh toán
        checkoutForm?.addEventListener("submit", function (e) {
            const selectedProductIds = getSelectedProductIds();

            if (selectedProductIds.length === 0) {
                e.preventDefault();
                showCustomAlert('Vui lòng chọn ít nhất một sản phẩm để thanh toán');
                return;
            }

            // Gán danh sách sản phẩm được chọn vào input ẩn
            selectedProductIdsInput.value = selectedProductIds.join(',');
        });
    </script>
}