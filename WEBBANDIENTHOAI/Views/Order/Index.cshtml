@model WEBBANDIENTHOAI.Repository.Admin.PagedResult<WEBBANDIENTHOAI.Models.Order>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f96b06",
                        "background-light": "#f8f7f5",
                        "background-dark": "#23170f",
                        "text-light-primary": "#1c130d",
                        "text-light-secondary": "#9e6b47",
                        "surface-light": "#f4ece6"
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            font-size: 24px;
        }

            .material-symbols-outlined.fill {
                font-variation-settings: 'FILL' 1;
            }

        body {
            font-family: 'Inter', sans-serif !important;
        }

        /* Modal Animation */
        #editStatusModal {
            animation: fadeIn 0.3s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
    </style>
}

<div class="relative min-h-screen w-full bg-background-light">
    <main class="w-full p-6 lg:p-8">
        <div class="w-full max-w-full mx-auto">
            <!-- Page Header -->
            <div class="flex flex-wrap justify-between gap-4 mb-8">
                <div class="flex flex-col gap-2">
                    <p class="text-text-light-primary text-4xl font-black leading-tight tracking-[-0.033em]">
                        Dashboard Quản Lý Đơn Hàng
                    </p>
                    <p class="text-text-light-secondary text-base font-normal leading-normal">
                        Xem và quản lý tất cả đơn hàng tại đây. Tổng cộng: <strong>@Model.TotalCount</strong> đơn hàng
                    </p>
                </div>
                <div class="flex gap-2">
                    <button onclick="window.print()" class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-surface-light text-text-light-primary gap-2 text-sm font-bold leading-normal tracking-[0.015em] hover:bg-surface-light/80 transition-colors">
                        <span class="material-symbols-outlined text-base">download</span>
                        <span class="truncate">Xuất Excel</span>
                    </button>
                </div>
            </div>

            <!-- Statistics Cards -->
            @if (ViewBag.Statistics != null)
            {
                var stats = ViewBag.Statistics as WEBBANDIENTHOAI.Models.OrderStatisticsDto;
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-primary uppercase mb-1">Tổng Đơn</p>
                                <p class="text-2xl font-black text-text-light-primary">@stats.TotalOrders</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">shopping_cart</span>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-green-600 uppercase mb-1">Doanh Thu</p>
                                <p class="text-xl font-black text-text-light-primary">@stats.TotalRevenue.ToString("N0")đ</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">payments</span>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-yellow-600 uppercase mb-1">Chờ Xử Lý</p>
                                <p class="text-2xl font-black text-text-light-primary">@stats.PendingOrders</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">schedule</span>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-blue-600 uppercase mb-1">Đang Xử Lý</p>
                                <p class="text-2xl font-black text-text-light-primary">@stats.ProcessingOrders</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">sync</span>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-green-600 uppercase mb-1">Hoàn Thành</p>
                                <p class="text-2xl font-black text-text-light-primary">@stats.CompletedOrders</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">check_circle</span>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-surface-light p-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-red-600 uppercase mb-1">Đã Hủy</p>
                                <p class="text-2xl font-black text-text-light-primary">@stats.CancelledOrders</p>
                            </div>
                            <span class="material-symbols-outlined text-4xl text-gray-300">cancel</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Filter Section -->
            <div class="mt-8 p-4 bg-white rounded-xl shadow-sm border border-surface-light">
                <form method="get" class="flex flex-wrap items-center gap-4">
                    <input type="hidden" name="__RequestVerificationToken" value="@tokenSet.RequestToken" />
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-text-light-primary" for="startDate">Từ</label>
                        <input class="form-input rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary"
                               id="startDate" name="startDate" type="date" value="@ViewBag.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-text-light-primary" for="endDate">Đến</label>
                        <input class="form-input rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary"
                               id="endDate" name="endDate" type="date" value="@ViewBag.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="flex-grow md:flex-grow-0">
                        <select name="paymentMethod" class="form-select w-full md:w-auto rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary">
                            <option value="">Phương thức thanh toán</option>
                            <option value="COD">COD</option>
                            <option value="BANKING">Chuyển khoản</option>
                        </select>
                    </div>
                    <div class="flex-grow md:flex-grow-0">
                        <select name="statusId" class="form-select w-full md:w-auto rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary">
                            <option value="">Tất cả trạng thái</option>
                            @if (ViewBag.Statuses != null)
                            {
                                @foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status.StatusId">@status.StatusName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="flex-grow md:flex-grow-0">
                        <select name="sortBy" class="form-select w-full md:w-auto rounded-lg border-surface-light bg-background-light text-text-light-primary text-sm focus:ring-primary focus:border-primary">
                            <option value="newest">Mới nhất</option>
                            <option value="oldest">Cũ nhất</option>
                            <option value="highest">Giá trị cao nhất</option>
                        </select>
                    </div>
                    <button type="submit" class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-5 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary/90 transition-colors">
                        <span class="truncate">Áp dụng</span>
                    </button>
                </form>
            </div>

            <!-- Orders Table -->
            <div class="mt-6 bg-white rounded-xl shadow-sm border border-surface-light overflow-hidden">
                <div class="p-4 flex flex-col md:flex-row gap-4 justify-between items-center border-b border-surface-light">
                    <div class="w-full md:max-w-md">
                        <form method="get">
                            <input type="hidden" name="__RequestVerificationToken" value="@tokenSet.RequestToken" />
                            <label class="flex flex-col w-full">
                                <div class="flex w-full flex-1 items-stretch rounded-lg h-11">
                                    <div class="text-text-light-secondary flex bg-surface-light items-center justify-center pl-4 rounded-l-lg">
                                        <span class="material-symbols-outlined">search</span>
                                    </div>
                                    <input name="search" value="@ViewBag.Search"
                                           class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light-primary focus:outline-0 focus:ring-1 focus:ring-primary border-none bg-surface-light h-full placeholder:text-text-light-secondary px-4 text-sm font-normal leading-normal"
                                           placeholder="Tìm theo mã đơn, tên khách hàng, SĐT..." />
                                </div>
                            </label>
                        </form>
                    </div>
                </div>

                <div class="overflow-y-auto max-h-[50vh]">
                    <div class="overflow-x-auto">
                        @if (!Model.Items.Any())
                        {
                            <div class="text-center py-12">
                                <span class="material-symbols-outlined text-6xl text-gray-300 mb-3">inbox</span>
                                <h5 class="text-xl font-semibold text-gray-500 mb-2">Không có đơn hàng nào</h5>
                                <p class="text-text-light-secondary">Chưa có đơn hàng nào được tạo trong hệ thống</p>
                            </div>
                        }
                        else
                        {
                            <table class="w-full text-sm text-left text-text-light-secondary">
                                <thead class="text-xs text-text-light-secondary uppercase bg-background-light sticky top-0">
                                    <tr>
                                        <th class="px-6 py-3" scope="col">Mã Đơn</th>
                                        <th class="px-6 py-3" scope="col">Khách Hàng</th>
                                        <th class="px-6 py-3" scope="col">Địa Chỉ</th>
                                        <th class="px-6 py-3" scope="col">Ngày Đặt</th>
                                        <th class="px-6 py-3" scope="col">Tổng Tiền</th>
                                        <th class="px-6 py-3" scope="col">Thanh Toán</th>
                                        <th class="px-6 py-3" scope="col">Trạng Thái</th>
                                        <th class="px-6 py-3 text-right" scope="col">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Items)
                                    {
                                        <tr class="bg-white border-b hover:bg-surface-light/50">
                                            <th class="px-6 py-4 font-bold text-primary whitespace-nowrap" scope="row">
                                                #@order.OrderId
                                            </th>
                                            <td class="px-6 py-4 font-medium text-text-light-primary">
                                                @order.Customer?.FullName
                                                <br />
                                                <small class="text-text-light-secondary">@order.Customer?.Phone</small>
                                            </td>
                                            <td class="px-6 py-4">@(order.ShippingAddress ?? "N/A")</td>
                                            <td class="px-6 py-4">
                                                @order.OrderDate.ToString("dd/MM/yyyy")
                                                <br />
                                                <small class="text-text-light-secondary">@order.OrderDate.ToString("HH:mm")</small>
                                            </td>
                                            <td class="px-6 py-4 font-bold text-green-600">
                                                @order.Total.ToString("N0")đ
                                            </td>
                                            <td class="px-6 py-4">
                                                @if (order.PaymentMethod == "COD")
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">COD</span>
                                                }
                                                else if (order.PaymentMethod == "BANKING")
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Chuyển khoản</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">@order.PaymentMethod</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4">
                                                @{
                                                    string statusClass = "";
                                                    string statusText = order.OrderStatus?.StatusName ?? "Không xác định";
                                                    switch (order.StatusId)
                                                    {
                                                        case 1: statusClass = "bg-yellow-100 text-yellow-800"; break;
                                                        case 2: statusClass = "bg-blue-100 text-blue-800"; break;
                                                        case 3: statusClass = "bg-green-100 text-green-800"; break;
                                                        case 4: statusClass = "bg-red-100 text-red-800"; break;
                                                        case 5: statusClass = "bg-indigo-100 text-indigo-800"; break;
                                                        default: statusClass = "bg-gray-100 text-gray-800"; break;
                                                    }
                                                }
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                                                    @statusText
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right flex justify-end gap-2">
                                                <button onclick="openDetailsModal(@order.OrderId)"
                                                        class="p-2 rounded-md hover:bg-surface-light" title="Chi tiết">
                                                    <span class="material-symbols-outlined text-base text-text-light-primary">visibility</span>
                                                </button>
                                                <button onclick="openEditModal(@order.OrderId, @order.StatusId)"
                                                        class="p-2 rounded-md hover:bg-surface-light" title="Cập nhật trạng thái">
                                                    <span class="material-symbols-outlined text-base text-text-light-primary">edit</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="mt-6 flex justify-center items-center gap-2">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-statusId="@ViewBag.StatusId"
                           asp-route-startDate="@ViewBag.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@ViewBag.EndDate?.ToString("yyyy-MM-dd")"
                           class="px-4 py-2 rounded-lg bg-white border border-surface-light text-text-light-primary hover:bg-surface-light">
                            Trước
                        </a>
                    }

                    <span class="px-4 py-2 text-text-light-primary font-medium">
                        Trang @ViewBag.CurrentPage / @Model.TotalPages
                    </span>

                    @if (ViewBag.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-statusId="@ViewBag.StatusId"
                           asp-route-startDate="@ViewBag.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@ViewBag.EndDate?.ToString("yyyy-MM-dd")"
                           class="px-4 py-2 rounded-lg bg-white border border-surface-light text-text-light-primary hover:bg-surface-light">
                            Sau
                        </a>
                    }
                </div>
            }
        </div>
    </main>
</div>

<!-- Modal Popup FORM THÔNG THƯỜNG - VẪN ĐẸP Y NGUYÊN -->
<div id="editStatusModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-auto transform transition-all duration-300 scale-95 opacity-0" id="modalContent">
            <!-- Header màu CAM đẹp -->
            <div class="bg-gradient-to-r from-primary to-orange-600 rounded-t-xl p-5">
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-white text-3xl">edit_note</span>
                        <h3 class="text-xl font-bold text-white">Cập nhật trạng thái</h3>
                    </div>
                    <button type="button" onclick="closeEditModal()" class="text-white hover:bg-white/20 rounded-full p-2 transition-all">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
            </div>

            <!-- Form sửa trạng thái -->
            <form method="post" asp-controller="Order" asp-action="UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editOrderId" name="OrderId" />

                <!-- Thông tin đơn hàng -->
                <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-4 mb-6">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-primary">info</span>
                        <p class="font-semibold text-text-light-primary">Thông tin đơn hàng</p>
                    </div>
                    <p class="text-sm text-text-light-secondary ml-8">
                        Mã đơn: <span class="font-bold text-primary" id="displayOrderId">#---</span>
                    </p>
                </div>

                <!-- Select trạng thái -->
                <div class="mb-6">
                    <label class="flex items-center gap-2 text-sm font-semibold text-text-light-primary mb-3">
                        <span class="material-symbols-outlined text-primary">task_alt</span>
                        Chọn trạng thái mới
                        <span class="text-red-500">*</span>
                    </label>
                    <select id="editStatusId" name="StatusId" required
                            class="w-full rounded-xl border-2 border-surface-light bg-white px-4 py-3.5 text-text-light-primary font-medium focus:ring-2 focus:ring-primary focus:border-primary transition-all hover:border-primary/50">
                        @if (ViewBag.Statuses != null)
                        {
                            @foreach (var status in ViewBag.Statuses)
                            {
                                <option value="@status.StatusId">
                                    @status.StatusName
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Ghi chú -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-6">
                    <div class="flex gap-2">
                        <span class="material-symbols-outlined text-blue-600 text-sm">lightbulb</span>
                        <p class="text-xs text-blue-800">
                            Trạng thái sẽ được cập nhật ngay lập tức và khách hàng có thể nhận được thông báo.
                        </p>
                    </div>
                </div>

                <!-- Buttons với hiệu ứng đẹp -->
                <div class="flex gap-3 pt-4 border-t border-surface-light">
                    <button type="button" onclick="closeEditModal()"
                            class="flex-1 py-3.5 rounded-xl border-2 border-gray-300 text-gray-700 font-bold hover:bg-gray-50 hover:border-gray-400 transition-all transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">cancel</span>
                        Hủy bỏ
                    </button>
                    <button type="submit"
                            class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-primary to-orange-600 text-white font-bold hover:from-orange-600 hover:to-primary transition-all transform hover:scale-105 active:scale-95 shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">save</span>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Animation cho modal */
    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #editStatusModal:not(.hidden) #modalContent {
        animation: modalFadeIn 0.3s ease-out forwards;
    }

    /* Custom scrollbar cho select */
    select::-webkit-scrollbar {
        width: 8px;
    }

    select::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    select::-webkit-scrollbar-thumb {
        background: #f96b06;
        border-radius: 10px;
    }

        select::-webkit-scrollbar-thumb:hover {
            background: #d85a05;
        }
</style>

<script>
    // Mở modal với animation đẹp
    function openEditModal(orderId, currentStatusId) {
        document.getElementById('editOrderId').value = orderId;
        document.getElementById('editStatusId').value = currentStatusId;
        document.getElementById('displayOrderId').textContent = '#' + orderId;

        const modal = document.getElementById('editStatusModal');
        const content = document.getElementById('modalContent');

        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Trigger animation
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    // Đóng modal với animation
    function closeEditModal() {
        const modal = document.getElementById('editStatusModal');
        const content = document.getElementById('modalContent');

        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    // Click outside để đóng
    document.getElementById('editStatusModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeEditModal();
        }
    });

    // Nhấn ESC để đóng
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('editStatusModal');
            if (!modal.classList.contains('hidden')) {
                closeEditModal();
            }
        }
    });

    // Loading state khi submit
    document.getElementById('editStatusForm').addEventListener('submit', function(e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
            <svg class="animate-spin h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="ml-2">Đang lưu...</span>
        `;
    });
</script>
<!-- ================== THÊM MODAL NÀY VÀO CUỐI FILE INDEX.CSHTML ================== -->
<!-- Modal Popup CHI TIẾT ĐƠN HÀNG -->
<div id="orderDetailsModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl mx-auto transform transition-all duration-300" id="detailsModalContent">
            <!-- Header màu CAM -->
            <div class="bg-gradient-to-r from-primary to-orange-600 rounded-t-2xl p-6">
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-white text-4xl">receipt_long</span>
                        <div>
                            <h3 class="text-2xl font-bold text-white">Chi Tiết Đơn Hàng</h3>
                            <p class="text-orange-100 text-sm" id="modalOrderId">Mã đơn: #---</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeDetailsModal()" class="text-white hover:bg-white/20 rounded-full p-2 transition-all">
                        <span class="material-symbols-outlined text-3xl">close</span>
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="p-6 max-h-[70vh] overflow-y-auto">
                <!-- Loading State -->
                <div id="detailsLoading" class="text-center py-12">
                    <svg class="animate-spin h-12 w-12 text-primary mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="text-text-light-secondary">Đang tải dữ liệu...</p>
                </div>

                <!-- Content Container -->
                <div id="detailsContent" class="hidden">
                    <!-- Thông tin khách hàng -->
                    <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-xl p-5 mb-6 border-l-4 border-primary">
                        <h4 class="font-bold text-lg text-text-light-primary mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">person</span>
                            Thông Tin Khách Hàng
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-orange-600">badge</span>
                                <div>
                                    <p class="text-xs text-text-light-secondary">Họ tên</p>
                                    <p class="font-semibold text-text-light-primary" id="customerName">---</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-orange-600">call</span>
                                <div>
                                    <p class="text-xs text-text-light-secondary">Số điện thoại</p>
                                    <p class="font-semibold text-text-light-primary" id="customerPhone">---</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-orange-600">mail</span>
                                <div>
                                    <p class="text-xs text-text-light-secondary">Email</p>
                                    <p class="font-semibold text-text-light-primary" id="customerEmail">---</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-orange-600">local_shipping</span>
                                <div>
                                    <p class="text-xs text-text-light-secondary">Địa chỉ giao hàng</p>
                                    <p class="font-semibold text-text-light-primary" id="shippingAddress">---</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Thông tin đơn hàng -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div class="bg-blue-50 rounded-xl p-4 border border-blue-200">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="material-symbols-outlined text-blue-600">calendar_today</span>
                                <p class="text-xs font-semibold text-blue-900">Ngày đặt</p>
                            </div>
                            <p class="font-bold text-blue-800" id="orderDate">---</p>
                        </div>
                        <div class="bg-green-50 rounded-xl p-4 border border-green-200">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="material-symbols-outlined text-green-600">credit_card</span>
                                <p class="text-xs font-semibold text-green-900">Thanh toán</p>
                            </div>
                            <p class="font-bold text-green-800" id="paymentMethod">---</p>
                        </div>
                        <div class="bg-purple-50 rounded-xl p-4 border border-purple-200">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="material-symbols-outlined text-purple-600">info</span>
                                <p class="text-xs font-semibold text-purple-900">Trạng thái</p>
                            </div>
                            <p class="font-bold text-purple-800" id="orderStatus">---</p>
                        </div>
                    </div>

                    <!-- Ghi chú -->
                    <div id="notesSection" class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-6 hidden">
                        <div class="flex gap-2">
                            <span class="material-symbols-outlined text-yellow-700">note</span>
                            <div class="flex-1">
                                <p class="text-xs font-semibold text-yellow-900 mb-1">Ghi chú</p>
                                <p class="text-sm text-yellow-800" id="orderNotes">---</p>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div class="bg-white rounded-xl border-2 border-surface-light">
                        <div class="bg-gradient-to-r from-primary to-orange-600 text-white px-5 py-3 rounded-t-xl">
                            <h4 class="font-bold text-lg flex items-center gap-2">
                                <span class="material-symbols-outlined">shopping_bag</span>
                                Sản Phẩm Đã Đặt
                            </h4>
                        </div>
                        <div class="divide-y divide-surface-light" id="productList">
                            <!-- Products will be loaded here -->
                        </div>
                    </div>

                    <!-- Tổng tiền -->
                    <div class="mt-6 bg-gradient-to-br from-green-50 to-emerald-100 rounded-xl p-6 border-2 border-green-300">
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-4xl text-green-700">paid</span>
                                <span class="text-xl font-bold text-green-900">Tổng Cộng</span>
                            </div>
                            <span class="text-3xl font-black text-green-700" id="orderTotal">0đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-surface-light px-6 py-4 rounded-b-2xl flex justify-end gap-3">
                <!-- Nút Xuất hàng - chỉ hiện khi StatusId = 3 -->
                <button type="button" id="exportOrderBtn" onclick="exportOrder()" class="hidden px-6 py-3 rounded-xl bg-green-500 text-white font-semibold hover:bg-green-600 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined">local_shipping</span>
                    Xuất hàng
                </button>

                <button type="button" onclick="printOrder()" class="px-6 py-3 rounded-xl bg-blue-500 text-white font-semibold hover:bg-blue-600 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined">print</span>
                    In đơn hàng
                </button>
                <button type="button" onclick="closeDetailsModal()" class="px-6 py-3 rounded-xl bg-gray-500 text-white font-semibold hover:bg-gray-600 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined">close</span>
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Mở modal chi tiết đơn hàng với xử lý lỗi chi tiết
    async function openDetailsModal(orderId) {
        const modal = document.getElementById('orderDetailsModal');
        const loading = document.getElementById('detailsLoading');
        const content = document.getElementById('detailsContent');
        const exportBtn = document.getElementById('exportOrderBtn');

        // Hiện modal
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Reset state
        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            // Gọi API lấy dữ liệu
            const response = await fetch(`/Admin/Order/GetOrderDetails?orderId=${orderId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });

            // Kiểm tra response status
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            // Lấy text trước để debug
            const responseText = await response.text();
            console.log('Response text:', responseText);

            // Parse JSON
            let result;
            try {
                result = JSON.parse(responseText);
            } catch (parseError) {
                console.error('JSON Parse Error:', parseError);
                console.error('Response was:', responseText);
                throw new Error('Dữ liệu trả về không đúng định dạng JSON');
            }

            if (result.success) {
                const data = result.data;

                // Cập nhật thông tin cơ bản
                document.getElementById('modalOrderId').textContent = `Mã đơn: #${data.orderId}`;
                document.getElementById('customerName').textContent = data.customerName || 'N/A';
                document.getElementById('customerPhone').textContent = data.customerPhone || 'N/A';
                document.getElementById('customerEmail').textContent = data.customerEmail || 'N/A';
                document.getElementById('shippingAddress').textContent = data.shippingAddress || 'N/A';
                document.getElementById('orderDate').textContent = new Date(data.orderDate).toLocaleDateString('vi-VN');
                document.getElementById('paymentMethod').textContent = data.paymentMethod || 'COD';
                document.getElementById('orderStatus').textContent = data.statusName || 'Không xác định';
                document.getElementById('orderTotal').textContent = (data.total || 0).toLocaleString('vi-VN') + 'đ';

                // Hiển thị/Ẩn nút Xuất hàng dựa trên StatusId
                if (data.statusId === 3) { // 3 = Completed
                    exportBtn.classList.remove('hidden');
                    exportBtn.setAttribute('data-order-id', data.orderId);
                } else {
                    exportBtn.classList.add('hidden');
                }

                // Ghi chú (nếu có)
                const notesSection = document.getElementById('notesSection');
                if (data.notes && data.notes.trim() !== '') {
                    notesSection.classList.remove('hidden');
                    document.getElementById('orderNotes').textContent = data.notes;
                } else {
                    notesSection.classList.add('hidden');
                }

                // Render danh sách sản phẩm
                const productList = document.getElementById('productList');
                if (data.orderDetails && data.orderDetails.length > 0) {
                    productList.innerHTML = data.orderDetails.map(item => `
                        <div class="flex items-center gap-4 p-4 hover:bg-orange-50 transition-colors">
                            <img src="${item.productImage || '/images/no-image.png'}"
                                 alt="${item.productName || 'Product'}"
                                 class="w-20 h-20 object-cover rounded-lg border-2 border-surface-light"
                                 onerror="this.src='/images/no-image.png'">
                            <div class="flex-1">
                                <h5 class="font-bold text-text-light-primary mb-1">${item.productName || 'N/A'}</h5>
                                <p class="text-sm text-text-light-secondary">
                                    Đơn giá: <span class="font-semibold text-primary">${(item.unitPrice || 0).toLocaleString('vi-VN')}đ</span>
                                </p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-text-light-secondary mb-1">Số lượng</p>
                                <span class="inline-flex items-center justify-center w-12 h-12 bg-primary text-white font-bold rounded-full text-lg">
                                    ${item.quantity || 0}
                                </span>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-text-light-secondary mb-1">Thành tiền</p>
                                <p class="text-xl font-black text-green-600">
                                    ${(item.subtotal || 0).toLocaleString('vi-VN')}đ
                                </p>
                            </div>
                        </div>
                    `).join('');
                } else {
                    productList.innerHTML = `
                        <div class="text-center py-8 text-text-light-secondary">
                            <span class="material-symbols-outlined text-4xl mb-2">inventory_2</span>
                            <p>Không có sản phẩm nào</p>
                        </div>
                    `;
                }

                // Hiện content
                loading.classList.add('hidden');
                content.classList.remove('hidden');
            } else {
                throw new Error(result.message || 'Không thể tải dữ liệu');
            }
        } catch (error) {
            console.error('Error loading order details:', error);

            // Hiện thông báo lỗi chi tiết
            loading.innerHTML = `
                <div class="text-center py-8">
                    <span class="material-symbols-outlined text-6xl text-red-500 mb-3">error</span>
                    <h5 class="text-xl font-semibold text-red-600 mb-2">Có lỗi xảy ra</h5>
                    <p class="text-text-light-secondary mb-4">${error.message}</p>
                    <button onclick="closeDetailsModal()"
                            class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Đóng
                    </button>
                </div>
            `;
        }
    }

    // Đóng modal
    function closeDetailsModal() {
        const modal = document.getElementById('orderDetailsModal');
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // In đơn hàng
    function printOrder() {
        window.print();
    }

    // Xuất hàng
    function exportOrder() {
        const orderId = document.getElementById('exportOrderBtn').getAttribute('data-order-id');
        if (orderId && confirm(`Xác nhận xuất hàng cho đơn hàng #${orderId}?`)) {
            window.location.href = `/Admin/ExportReceipt/Create?orderId=${orderId}`;
        }
    }

    // Click outside để đóng
    document.getElementById('orderDetailsModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeDetailsModal();
        }
    });

    // ESC để đóng
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('orderDetailsModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeDetailsModal();
            }
        }
    });
</script>