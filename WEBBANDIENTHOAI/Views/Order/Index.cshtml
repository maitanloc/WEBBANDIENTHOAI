</div>

<!-- ================== THAY THẾ TOÀN BỘ SCRIPT exportOrder() CŨ BẰNG CODE NÀY ================== -->

<script>
    // =====================================================
    // MODAL CHI TIẾT ĐƠN HÀNG - openDetailsModal()
    // =====================================================
    async function openDetailsModal(orderId) {
        const modal = document.getElementById('orderDetailsModal');
        const modalContent = document.getElementById('detailsModalContent');
        const loading = document.getElementById('detailsLoading');
        const content = document.getElementById('detailsContent');
        const exportBtn = document.getElementById('exportOrderBtn');

        // Hiện modal
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Trigger animation
        setTimeout(() => {
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);

        // Reset state
        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            const response = await fetch(`/Admin/Order/GetOrderDetails?orderId=${orderId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const responseText = await response.text();
            console.log('Response text:', responseText);

            let result;
            try {
                result = JSON.parse(responseText);
            } catch (parseError) {
                console.error('JSON Parse Error:', parseError);
                console.error('Response was:', responseText);
                throw new Error('Dữ liệu trả về không đúng định dạng JSON');
            }

            if (result.success) {
                const data = result.data;

                // Cập nhật thông tin cơ bản
                document.getElementById('modalOrderId').textContent = `Mã đơn: #${data.orderId}`;
                document.getElementById('customerName').textContent = data.customerName || 'N/A';
                document.getElementById('customerPhone').textContent = data.customerPhone || 'N/A';
                document.getElementById('customerEmail').textContent = data.customerEmail || 'N/A';
                document.getElementById('shippingAddress').textContent = data.shippingAddress || 'N/A';
                document.getElementById('orderDate').textContent = new Date(data.orderDate).toLocaleDateString('vi-VN');
                document.getElementById('paymentMethod').textContent = data.paymentMethod || 'COD';
                document.getElementById('orderStatus').textContent = data.statusName || 'Không xác định';

                // Render Giá cả
                document.getElementById('orderSubTotal').textContent = (data.originalTotal || 0).toLocaleString('vi-VN') + 'đ';
                document.getElementById('orderTotal').textContent = (data.total || 0).toLocaleString('vi-VN') + 'đ';
                
                // Voucher
                if (data.discountAmount > 0) {
                    document.getElementById('voucherContainer').classList.remove('hidden');
                    document.getElementById('voucherCodeText').textContent = data.appliedVoucherCode ? `(${data.appliedVoucherCode})` : '';
                    document.getElementById('voucherDiscount').textContent = data.discountAmount.toLocaleString('vi-VN') + 'đ';
                } else {
                    document.getElementById('voucherContainer').classList.add('hidden');
                }

                // Points
                if (data.pointsUsed > 0) {
                    document.getElementById('pointsContainer').classList.remove('hidden');
                    document.getElementById('pointsUsedText').textContent = data.pointsUsed;
                    document.getElementById('pointsDiscount').textContent = (data.pointsUsed * 1000).toLocaleString('vi-VN') + 'đ';
                } else {
                    document.getElementById('pointsContainer').classList.add('hidden');
                }

                // Hiển thị/Ẩn nút Xuất hàng dựa trên StatusId
                if (data.statusId === 3) { // 3 = Completed
                    exportBtn.classList.remove('hidden');
                    exportBtn.setAttribute('data-order-id', data.orderId);
                } else {
                    exportBtn.classList.add('hidden');
                }

                // Ghi chú (nếu có)
                const notesSection = document.getElementById('notesSection');
                if (data.notes && data.notes.trim() !== '') {
                    notesSection.classList.remove('hidden');
                    document.getElementById('orderNotes').textContent = data.notes;
                } else {
                    notesSection.classList.add('hidden');
                }

                // Render danh sách sản phẩm
                const productList = document.getElementById('productList');
                if (data.orderDetails && data.orderDetails.length > 0) {
                    productList.innerHTML = data.orderDetails.map(item => `
                        <div class="flex items-center gap-4 p-4 hover:bg-gray-50 transition-colors border-b border-gray-200 last:border-0 text-black">
                            <img src="${item.productImage || '/images/no-image.png'}"
                                 alt="${item.productName || 'Product'}"
                                 class="w-16 h-16 object-cover border border-gray-300"
                                 onerror="this.src='/images/no-image.png'">
                            <div class="flex-1">
                                <h5 class="font-bold mb-1">${item.productName || 'N/A'}</h5>
                                <p class="text-xs text-gray-500 lowercase tracking-wider">
                                    Đơn giá: <span class="font-bold text-black">${(item.unitPrice || 0).toLocaleString('vi-VN')}đ</span>
                                </p>
                            </div>
                            <div class="text-center">
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter mb-1">Số lượng</p>
                                <span class="font-bold">
                                    ${item.quantity || 0}
                                </span>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter mb-1">Thành tiền</p>
                                <p class="font-bold text-emerald-700">
                                    ${(item.subtotal || 0).toLocaleString('vi-VN')}đ
                                </p>
                            </div>
                        </div>
                    `).join('');
                } else {
                    productList.innerHTML = `
                        <div class="text-center py-8 text-text-light-secondary">
                            <span class="material-symbols-outlined text-4xl mb-2">inventory_2</span>
                            <p>Không có sản phẩm nào</p>
                        </div>
                    `;
                }

                loading.classList.add('hidden');
                content.classList.remove('hidden');
            } else {
                throw new Error(result.message || 'Không thể tải dữ liệu');
            }
        } catch (error) {
            console.error('Error loading order details:', error);

            loading.innerHTML = `
                <div class="text-center py-8">
                    <span class="material-symbols-outlined text-6xl text-red-500 mb-3">error</span>
                    <h5 class="text-xl font-semibold text-red-600 mb-2">Có lỗi xảy ra</h5>
                    <p class="text-text-light-secondary mb-4">${error.message}</p>
                    <button onclick="closeDetailsModal()"
                            class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Đóng
                    </button>
                </div>
            `;
        }
    }

    function closeDetailsModal() {
        const modal = document.getElementById('orderDetailsModal');
        const modalContent = document.getElementById('detailsModalContent');

        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    function printOrder() {
        window.print();
    }

    // =====================================================
    // HÀM XUẤT HÀNG - TÍCH HỢP VỚI MODAL XUẤT KHO
    // =====================================================
    function exportOrder() {
        const orderId = document.getElementById('exportOrderBtn').getAttribute('data-order-id');
        if (orderId) {
            closeDetailsModal(); // Đóng modal chi tiết
            openExportModal(parseInt(orderId)); // Mở modal xuất kho
        }
    }

    // =====================================================
    // MODAL XUẤT KHO
    // =====================================================
    let currentExportOrderId = null;
    let currentExportData = null;

    async function openExportModal(orderId) {
        const modal = document.getElementById('exportModal');
        const modalContent = document.getElementById('exportModalContent');
        const loading = document.getElementById('exportLoading');
        const content = document.getElementById('exportContent');

        currentExportOrderId = orderId;

        // Hiện modal
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Trigger animation
        setTimeout(() => {
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);

        // Reset state
        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            // Gọi API lấy dữ liệu đơn hàng
            const response = await fetch(`/Admin/ExportReceipt/GetOrderForExport?orderId=${orderId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();

            if (result.success) {
                const data = result.data;
                currentExportData = data;

                // Cập nhật thông tin
                document.getElementById('exportOrderInfo').textContent = `Đơn hàng: #${data.orderId}`;
                document.getElementById('exportCustomerName').textContent = data.customerName;
                document.getElementById('exportOrderDate').textContent = data.orderDate;
                document.getElementById('exportOrderTotal').textContent = data.total.toLocaleString('vi-VN') + 'đ';
                document.getElementById('exportGrandTotal').textContent = data.total.toLocaleString('vi-VN') + 'đ';

                // Render danh sách sản phẩm
                const productList = document.getElementById('exportProductList');
                if (data.items && data.items.length > 0) {
                    productList.innerHTML = data.items.map(item => `
                        <tr class="hover:bg-green-50 transition-colors">
                            <td class="px-4 py-3">
                                <span class="font-mono text-xs bg-gray-100 px-2 py-1 rounded">${item.stockCode || 'N/A'}</span>
                            </td>
                            <td class="px-4 py-3">
                                <div>
                                    <p class="font-semibold text-text-light-primary">${item.name}</p>
                                    <p class="text-xs text-text-light-secondary">SKU: ${item.sku || 'N/A'}</p>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center justify-center w-10 h-10 bg-green-500 text-white font-bold rounded-full">
                                    ${item.quantity}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right font-semibold text-text-light-primary">
                                ${item.unitPrice.toLocaleString('vi-VN')}đ
                            </td>
                            <td class="px-4 py-3 text-right font-bold text-green-600">
                                ${item.totalPrice.toLocaleString('vi-VN')}đ
                            </td>
                        </tr>
                    `).join('');
                } else {
                    productList.innerHTML = `
                        <tr>
                            <td colspan="5" class="text-center py-8 text-text-light-secondary">
                                Không có sản phẩm nào
                            </td>
                        </tr>
                    `;
                }

                // Hiện content
                loading.classList.add('hidden');
                content.classList.remove('hidden');
            } else {
                throw new Error(result.message || 'Không thể tải dữ liệu');
            }
        } catch (error) {
            console.error('Error loading export data:', error);

            loading.innerHTML = `
                <div class="text-center py-8">
                    <span class="material-symbols-outlined text-6xl text-red-500 mb-3">error</span>
                    <h5 class="text-xl font-semibold text-red-600 mb-2">Có lỗi xảy ra</h5>
                    <p class="text-text-light-secondary mb-4">${error.message}</p>
                    <button onclick="closeExportModal()"
                            class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Đóng
                    </button>
                </div>
            `;
        }
    }

    async function confirmExport() {
        if (!currentExportData) {
            alert('Không có dữ liệu để xuất kho');
            return;
        }

        // Xác nhận
        if (!confirm(`Xác nhận xuất kho cho đơn hàng #${currentExportData.orderId}?\n\nThao tác này không thể hoàn tác!`)) {
            return;
        }

        const confirmBtn = document.getElementById('confirmExportBtn');
        const originalContent = confirmBtn.innerHTML;

        try {
            // Disable button và hiện loading
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = `
                <svg class="animate-spin h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="ml-2">Đang xử lý...</span>
            `;

            // Lấy ghi chú
            const notes = document.getElementById('exportNotes').value;

            // Tạo DTO để gửi
            const dto = {
                OrderId: currentExportData.orderId,
                CustomerId: currentExportData.customerId,
                CreatedByUserId: 1, // TODO: Lấy từ session/authentication
                Notes: notes,
                Items: currentExportData.items.map(item => ({
                    ProductId: item.productId,
                    StockCode: item.stockCode,
                    SKU: item.sku,
                    Name: item.name,
                    Brand: item.brand,
                    Quantity: item.quantity,
                    UnitPrice: item.unitPrice
                }))
            };

            // Lấy CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Gọi API
            const response = await fetch('/Admin/ExportReceipt/CreateFromOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(dto)
            });

            const result = await response.json();

            if (result.success) {
                // Thành công
                alert(`✅ ${result.message}\nMã phiếu xuất: ${result.receiptNumber}`);
                closeExportModal();

                // Reload trang hoặc chuyển hướng
                window.location.href = '/Admin/ExportReceipt';
            } else {
                throw new Error(result.message || 'Xuất kho thất bại');
            }
        } catch (error) {
            console.error('Error exporting:', error);
            alert(`❌ Lỗi: ${error.message}`);

            // Restore button
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = originalContent;
        }
    }

    function closeExportModal() {
        const modal = document.getElementById('exportModal');
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');

        // Reset data
        currentExportOrderId = null;
        currentExportData = null;
        document.getElementById('exportNotes').value = '';
    }

    // =====================================================
    // EVENT LISTENERS
    // =====================================================

    // Click outside để đóng orderDetailsModal
    document.getElementById('orderDetailsModal')?.addEventListener('click', function (e) {
        if (e.target === this) {
            closeDetailsModal();
        }
    });

    // Click outside để đóng exportModal
    document.getElementById('exportModal')?.addEventListener('click', function (e) {
        if (e.target === this) {
            closeExportModal();
        }
    });

    // ESC để đóng modals
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const orderModal = document.getElementById('orderDetailsModal');
            const exportModal = document.getElementById('exportModal');

            if (orderModal && !orderModal.classList.contains('hidden')) {
                closeDetailsModal();
            }

            if (exportModal && !exportModal.classList.contains('hidden')) {
                closeExportModal();
            }
        }
    });
</script>
