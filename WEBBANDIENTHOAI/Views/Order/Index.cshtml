<!-- Modal Popup CHI TIẾT ĐƠN HÀNG - CLEAN & PREMIUM -->
<!-- Modal Popup CHI TIẾT ĐƠN HÀNG -->
<div id="orderDetailsModal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-black bg-opacity-50 transition-all duration-300">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white border-0 rounded-2xl shadow-xl w-full max-w-5xl mx-auto transform transition-all duration-300 scale-95 opacity-0"
            id="detailsModalContent">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <div>
                    <h5 class="text-lg font-bold text-gray-900">Chi Tiết Đơn Hàng</h5>
                    <p class="text-sm text-gray-500" id="modalOrderId">Mã đơn: #---</p>
