@model WEBBANDIENTHOAI.Repository.Admin.PagedResult<WEBBANDIENTHOAI.Models.Order>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            font-size: 24px;
        }

        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }

        body {
            font-family: 'Inter', sans-serif !important;
        }

        /* Borderless input styles */
        .borderless-input {
            background-color: transparent !important;
            border: none !important;
            border-bottom: 1px solid #d1d5db !important;
            border-radius: 0 !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
        }

        .borderless-input:focus {
            outline: none !important;
            border-bottom-color: #10b981 !important;
            box-shadow: none !important;
        }
    </style>
}

<!-- Page Header -->
<div class="mb-8 mt-2">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Quản lý Đơn hàng</h1>
            <p class="text-sm text-gray-500 mt-1">Xem và xử lý các giao dịch từ khách hàng. Tổng cộng:
                <strong>@Model.TotalCount</strong> đơn hàng.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button onclick="window.print()"
                class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-sm">download</span>
                Xuất Excel
            </button>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="bg-transparent mb-6">
    <form method="get" class="flex flex-wrap items-center gap-6">
        @Html.AntiForgeryToken()
        <div class="relative flex-1 min-w-[300px]">
            <span class="material-symbols-outlined absolute left-0 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            <input name="search" value="@ViewBag.Search"
                class="w-full pl-8 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 text-black text-sm"
                placeholder="Mã đơn, tên khách hàng, SĐT..." />
        </div>

        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wider" for="startDate">Từ</label>
                <input
                    class="bg-transparent border-b border-gray-300 py-1 text-sm text-black focus:outline-none focus:border-emerald-500"
                    id="startDate" name="startDate" type="date" value="@ViewBag.StartDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wider" for="endDate">Đến</label>
                <input
                    class="bg-transparent border-b border-gray-300 py-1 text-sm text-black focus:outline-none focus:border-emerald-500"
                    id="endDate" name="endDate" type="date" value="@ViewBag.EndDate?.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <select name="statusId"
            class="bg-transparent border-b border-gray-300 py-2 text-sm text-black focus:outline-none focus:border-emerald-500 min-w-[150px]">
            <option value="">Trạng thái</option>
            @if (ViewBag.Statuses != null)
            {
                @foreach (var status in ViewBag.Statuses)
                {
                    <option value="@status.StatusId" selected="@(ViewBag.StatusId == status.StatusId)">@status.StatusName
                    </option>
                }
            }
        </select>

        <button type="submit"
            class="px-6 py-2 bg-gray-800 text-white rounded text-xs font-bold hover:bg-black transition-colors tracking-widest">
            ÁP DỤNG LỌC
        </button>
    </form>
</div>

<!-- Orders Table -->
<div class="bg-white border border-gray-300">
    <div class="overflow-x-auto">

        @if (!Model.Items.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">inbox</span>
                <p>Không tìm thấy đơn hàng nào.</p>
            </div>
        }
        else
        {
            <table class="w-full text-left border-collapse border border-gray-300" id="ordersTable">
                <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">
                            Mã Đơn</th>
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">
                            Khách Hàng</th>
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">
                            Ngày Đặt</th>
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">
                            Tổng Tiền</th>
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300 w-24">
                            P. Thức</th>
                        <th
                            class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">
                            Trạng Thái</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    @foreach (var order in Model.Items)
                    {
                        <tr class="order-row border-b border-gray-300 hover:bg-gray-50 transition-colors text-black">
                            <td class="px-4 py-3 font-bold border-r border-gray-300">
                                #@order.OrderId
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <p class="font-bold">@order.Customer?.FullName</p>
                                <p class="text-xs text-gray-500">@order.Customer?.Phone</p>
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <p class="text-sm">@order.OrderDate.ToString("dd/MM/yyyy")</p>
                                <p class="text-xs text-gray-500">@order.OrderDate.ToString("HH:mm")</p>
                            </td>
                            <td class="px-4 py-3 font-bold text-emerald-700 border-r border-gray-300">
                                @order.Total.ToString("N0")đ
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300 text-xs">
                                @order.PaymentMethod
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <span class="text-xs font-bold uppercase">
                                    @(order.OrderStatus?.StatusName ?? "N/A")
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button onclick="openDetailsModal(@order.OrderId)"
                                        class="p-1 px-2 text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded text-xs font-bold uppercase transition-colors"
                                        title="Chi tiết">
                                        Xem
                                    </button>
                                    <button onclick="openEditModal(@order.OrderId, @order.StatusId)"
                                        class="p-1 px-2 text-amber-700 bg-amber-100 hover:bg-amber-200 border border-amber-300 rounded text-xs font-bold uppercase transition-colors"
                                        title="Cập nhật">
                                        Sửa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-8 flex justify-center items-center gap-4">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search"
                asp-route-statusId="@ViewBag.StatusId" asp-route-startDate="@ViewBag.StartDate?.ToString("yyyy-MM-dd")"
                asp-route-endDate="@ViewBag.EndDate?.ToString("yyyy-MM-dd")"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
                Trước
            </a>
        }

        <div class="flex items-center gap-1">
            <span class="text-lg font-black text-gray-900">@ViewBag.CurrentPage</span>
            <span class="text-sm font-bold text-gray-400">/</span>
            <span class="text-sm font-bold text-gray-400">@Model.TotalPages</span>
        </div>

        @if (ViewBag.CurrentPage < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search"
                asp-route-statusId="@ViewBag.StatusId" asp-route-startDate="@ViewBag.StartDate?.ToString("yyyy-MM-dd")"
                asp-route-endDate="@ViewBag.EndDate?.ToString("yyyy-MM-dd")"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                Sau
                <span class="material-symbols-outlined text-sm">chevron_right</span>
            </a>
        }
    </div>
}
</div>
</main>
</div>

<!-- Modal Popup CẬP NHẬT TRẠNG THÁI - CLEAN & PREMIUM -->
<!-- Modal Popup CẬP NHẬT TRẠNG THÁI -->
<div id="editStatusModal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-black bg-opacity-50 transition-all duration-300">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white border-0 rounded-2xl shadow-xl w-full max-w-lg mx-auto transform transition-all duration-300 scale-95 opacity-0"
            id="modalContent">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h5 class="text-lg font-bold text-gray-900">Cập nhật trạng thái</h5>
                <button type="button" onclick="closeEditModal()"
                    class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-gray-400">close</span>
                </button>
            </div>

            <!-- Body Area -->
            <form method="post" asp-controller="Order" asp-action="UpdateStatus" id="editStatusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editOrderId" name="OrderId" />

                <div class="p-6 space-y-6">
                    <!-- Order ID Display -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Mã đơn hàng</label>
                        <span class="text-xl font-bold text-gray-900" id="displayOrderId">#---</span>
                    </div>

                    <!-- Status Selection -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Trạng thái mới <span
                                class="text-red-500">*</span></label>
                        <div class="relative group">
                            <select id="editStatusId" name="StatusId" required
                                class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all appearance-none cursor-pointer bg-white text-gray-900">
                                @if (ViewBag.Statuses != null)
                                {
                                    @foreach (var status in ViewBag.Statuses)
                                    {
                                        <option value="@status.StatusId">@status.StatusName</option>
                                    }
                                }
                            </select>
                            <span
                                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                                expand_more
                            </span>
                        </div>
                    </div>

                    <!-- Info Note -->
                    <div class="flex gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100">
                        <span class="material-symbols-outlined text-blue-500 text-xl flex-shrink-0">info</span>
                        <p class="text-sm text-gray-600 leading-relaxed">
                            <strong class="text-gray-900">Lưu ý:</strong> Trạng thái đơn hàng sẽ được cập nhật ngay lập
                            tức. Khách hàng sẽ nhận được thông báo về sự thay đổi này.
                        </p>
                    </div>
                </div>

                <!-- Footer / Actions -->
                <div class="px-6 py-4 bg-gray-50 rounded-b-2xl flex justify-end gap-3">
                    <button type="button" onclick="closeEditModal()"
                        class="px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors">
                        Hủy bỏ
                    </button>
                    <button type="submit"
                        class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-colors">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Animation cho modal */
    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #editStatusModal:not(.hidden) #modalContent {
        animation: modalFadeIn 0.3s ease-out forwards;
    }

    /* Custom scrollbar cho select */
    select::-webkit-scrollbar {
        width: 8px;
    }

    select::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    select::-webkit-scrollbar-thumb {
        background: #f96b06;
        border-radius: 10px;
    }

    select::-webkit-scrollbar-thumb:hover {
        background: #d85a05;
    }
</style>

<script>
    // Mở modal với animation đẹp
    function openEditModal(orderId, currentStatusId) {
        document.getElementById('editOrderId').value = orderId;
        document.getElementById('editStatusId').value = currentStatusId;
        document.getElementById('displayOrderId').textContent = '#' + orderId;

        const modal = document.getElementById('editStatusModal');
        const content = document.getElementById('modalContent');

        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');

        // Trigger animation
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    // Đóng modal với animation
    function closeEditModal() {
        const modal = document.getElementById('editStatusModal');
        const content = document.getElementById('modalContent');

        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    // Click outside để đóng
    document.getElementById('editStatusModal').addEventListener('click', function (e) {
        if (e.target === this) {
            closeEditModal();
        }
    });

    // Nhấn ESC để đóng
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('editStatusModal');
            if (!modal.classList.contains('hidden')) {
                closeEditModal();
            }
        }
    });

    // Loading state khi submit
    document.getElementById('editStatusForm').addEventListener('submit', function (e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
            <svg class="animate-spin h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="ml-2">Đang lưu...</span>
        `;
    });
</script>
