                                <span class="material-symbols-outlined text-gray-400">person</span>
                                <div>
                                    <p class="text-xs font-semibold text-gray-500">Họ tên</p>
                                    <p class="font-bold text-gray-900" id="customerName">---</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-gray-400">call</span>
                                <div>
                                    <p class="text-xs font-semibold text-gray-500">Điện thoại</p>
                                    <p class="font-medium text-gray-900" id="customerPhone">---</p>
                                </div>
                            </div>
