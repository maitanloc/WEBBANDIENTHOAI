@model WEBBANDIENTHOAI.Models.Product

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden group hover:shadow-md transition-all duration-300 hover-lift">
    <div class="relative overflow-hidden">
        @if (Model.PrimaryImage != null)
        {
            <img src="@Url.Action("GetProductImage", "HomeUser", new { imageId = Model.PrimaryImage.ImageId })"
                 alt="@Model.Name"
                 class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105" />
        }
        else
        {
            <img src="~/images/default-product.png"
                 alt="@Model.Name"
                 class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105" />
        }

        @if (Model.Price < 5000000)
        {
            <span class="absolute top-3 left-3 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full">
                GIÁ TỐT
            </span>
        }
    </div>

    <div class="p-4">
        <h3 class="font-semibold text-gray-800 mb-2 line-clamp-2 h-12 overflow-hidden" title="@Model.Name">
            @Model.Name
        </h3>

        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="text-gray-600 text-sm mb-3 line-clamp-2 h-10 overflow-hidden">
                @Model.ShortDescription
            </p>
        }

        <div class="flex items-center justify-between mt-4">
            <div class="flex flex-col">
                <span class="text-orange-600 font-bold text-lg">
                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.Price)
                </span>
            </div>

            <div class="flex space-x-2">
                <a href="@Url.Action("Details", "Products", new { id = Model.ProductId })"
                   class="bg-gray-100 text-gray-700 hover:bg-gray-200 px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center"
                   title="Xem chi tiết">
                    <i class="fas fa-eye mr-1 text-sm"></i>
                    <span class="hidden sm:inline">Xem</span>
                </a>

                <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form" data-product="@Model.ProductId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <button type="submit" class="bg-orange-500 text-white hover:bg-orange-600 px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center" title="Thêm vào giỏ">
                        <i class="fas fa-shopping-cart mr-1 text-sm"></i>
                        <span class="hidden sm:inline">Thêm</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="flex items-center mt-3 pt-3 border-t border-gray-100">
            <div class="flex text-orange-400 mr-2">
                <i class="fas fa-star text-sm"></i>
                <i class="fas fa-star text-sm"></i>
                <i class="fas fa-star text-sm"></i>
                <i class="fas fa-star text-sm"></i>
                <i class="fas fa-star-half-alt text-sm"></i>
            </div>
            <span class="text-gray-500 text-xs">(128)</span>
        </div>
    </div>
</div>