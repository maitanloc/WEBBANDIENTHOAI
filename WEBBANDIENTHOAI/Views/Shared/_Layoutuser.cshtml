            <p class="logout-message">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
            <div class="logout-buttons">
                <button id="logout-cancel" class="logout-btn-cancel">Hủy</button>
                <button id="logout-confirm" class="logout-btn-confirm">Đăng xuất</button>
