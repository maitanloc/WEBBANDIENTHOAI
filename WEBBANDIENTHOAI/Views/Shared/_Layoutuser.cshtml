    <!-- Main JavaScript -->
    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Loading Screen (Fast version)
        window.addEventListener('load', function() {
            const loadingScreen = document.getElementById('loadingScreen');
            const progressFill = document.querySelector('.progress-fill');

            let progress = 0;
            const interval = setInterval(() => {
                progress += Math.random() * 30; // Tăng nhanh hơn
                if (progress >= 100) {
                    progress = 100;
                    clearInterval(interval);
                    setTimeout(() => {
                        loadingScreen.style.opacity = '0';
                        setTimeout(() => {
                            loadingScreen.style.display = 'none';
                        }, 300); // Fade out nhanh hơn
                    }, 100); // Chờ ít hơn
                }
                progressFill.style.width = progress + '%';
            }, 100); // Cập nhật nhanh hơn
        });

        // Header Scroll Effect
        let lastScrollY = window.scrollY;
        const header = document.getElementById('mainHeader');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }

            lastScrollY = window.scrollY;
        });

        // Chat Widget Toggle
        function toggleChat() {
            const chatContainer = document.getElementById('chatContainer');
            chatContainer.classList.toggle('scale-0');
            chatContainer.classList.toggle('scale-100');
        }

        // Scroll to Top
        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        // Search Functionality
        const globalSearch = document.getElementById('globalSearch');
        const searchSuggestions = document.getElementById('searchSuggestions');

        if (globalSearch) {
            globalSearch.addEventListener('focus', () => {
                searchSuggestions.classList.remove('hidden');
            });

            globalSearch.addEventListener('blur', () => {
                setTimeout(() => {
                    searchSuggestions.classList.add('hidden');
                }, 200);
            });

            // Sample search suggestions
            const suggestions = [
                'iPhone 15 Pro Max',
                'Samsung Galaxy S24',
                'MacBook Pro M3',
                'iPad Air 5',
                'Apple Watch Series 9',
                'AirPods Pro 2'
            ];

            globalSearch.addEventListener('input', (e) => {
                const value = e.target.value.toLowerCase();
                const filtered = suggestions.filter(item =>
                    item.toLowerCase().includes(value)
                );

                const suggestionsContainer = searchSuggestions.querySelector('.max-h-60');
                suggestionsContainer.innerHTML = filtered.map(item => `
                    <div class="px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer border-b border-gray-100 dark:border-gray-700 last:border-b-0">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-search text-gray-400"></i>
                            <span class="text-gray-700 dark:text-gray-300">${item}</span>
                        </div>
                    </div>
                `).join('');
            });
        }

        // Add to Cart Animation
        function animateAddToCart(button) {
            const cartCount = document.querySelector('.cart-count');
            if (cartCount) {
                const currentCount = parseInt(cartCount.textContent);
                cartCount.textContent = currentCount + 1;

                // Add animation
                cartCount.classList.add('animate-bounce');
                setTimeout(() => {
                    cartCount.classList.remove('animate-bounce');
                }, 1000);
            }
        }

        // Initialize Splide Sliders (if any)
        document.addEventListener('DOMContentLoaded', function() {
            const sliders = document.querySelectorAll('.splide');
            sliders.forEach(slider => {
                new Splide(slider, {
                    type: 'loop',
                    perPage: 1,
                    autoplay: true,
                    interval: 5000,
                    pauseOnHover: true,
                    pauseOnFocus: true
                }).mount();
            });
        });

        // Dark Mode Toggle (if implemented)
        function toggleDarkMode() {
            const html = document.documentElement;
            html.classList.toggle('dark');
            localStorage.setItem('darkMode', html.classList.contains('dark'));
        }

        // Check for saved dark mode preference
        if (localStorage.getItem('darkMode') === 'true') {
            document.documentElement.classList.add('dark');
        }
    </script>

    @RenderSection("Scripts", required: false)
