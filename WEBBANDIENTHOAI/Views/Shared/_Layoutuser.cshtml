        <style>
            @@keyframes spinFabPulse {
                0%, 100% { box-shadow: 0 4px 20px rgba(244,140,37,0.6), 0 0 0 0 rgba(244,140,37,0.3); }
                50%       { box-shadow: 0 4px 30px rgba(244,140,37,0.9), 0 0 0 12px rgba(244,140,37,0); }
            }
            @@keyframes ringRotate { to { transform: rotate(360deg); } }
        </style>

        <script>
        (function() {
            // ── Dữ liệu ──────────────────────────────────────────────────────
            const NO_PRIZE_SLOTS = 2;
            const COLORS = [
                ["#f48c25","#d97a1a"],["#fff","#f3f4f6"],["#f97316","#ea580c"],
                ["#fff","#f3f4f6"],["#fbbf24","#f59e0b"],["#fff","#f3f4f6"],
                ["#f48c25","#d97a1a"],["#fff","#f3f4f6"],["#fb923c","#f97316"],
                ["#fff","#f3f4f6"]
            ];
            let vouchers = [];
            let segments = [];
            let rotation = 0;
            let isSpinning = false;
            let initialised = false;

            // ── Lấy danh sách voucher ─────────────────────────────────────────
            async function loadVouchers() {
                try {
                    const r = await fetch('/Spin/GetSegments');
                    vouchers = await r.json();
                } catch(e) { vouchers = []; }
                segments = [
                    ...vouchers.map(v => v.discountType === 1
                        ? `🎉 ${v.value}%` : `🎉 ${Number(v.value).toLocaleString('vi-VN')}đ`
                    ),
                    ...Array(NO_PRIZE_SLOTS).fill("😢 Thử lại!")
                ];
            }

            // ── Vẽ bánh xe ───────────────────────────────────────────────────
            function drawWheel(canvas) {
                const n = segments.length;
                if (!n) return;
                const cx = canvas.width / 2, cy = canvas.height / 2, r = cx - 3;
                const arc = (2 * Math.PI) / n;
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < n; i++) {
                    const s = rotation + i * arc, e = s + arc;
                    const [c1, c2] = COLORS[i % COLORS.length];
                    const grad = ctx.createRadialGradient(cx, cy, r * 0.2, cx, cy, r);
                    grad.addColorStop(0, c1); grad.addColorStop(1, c2);
                    ctx.beginPath(); ctx.moveTo(cx, cy);
                    ctx.arc(cx, cy, r, s, e); ctx.closePath();
                    ctx.fillStyle = grad; ctx.fill();
                    ctx.strokeStyle = 'rgba(244,140,37,0.35)'; ctx.lineWidth = 1.5; ctx.stroke();
                    ctx.save(); ctx.translate(cx, cy); ctx.rotate(s + arc / 2);
                    ctx.textAlign = 'right'; ctx.fillStyle = i%2===0 ? '#fff' : '#1f2937';
                    ctx.font = `bold ${Math.max(9, Math.min(12, 200 / n))}px Inter,sans-serif`;
                    ctx.shadowColor = i%2===0 ? 'rgba(0,0,0,0.5)' : 'rgba(244,140,37,0.4)';
                    ctx.shadowBlur = 3;
                    ctx.fillText(segments[i], r - 10, 4); ctx.restore();
                }
                // Tâm
                const cg = ctx.createRadialGradient(cx, cy, 0, cx, cy, 30);
                cg.addColorStop(0, '#fff'); cg.addColorStop(1, '#f48c25');
                ctx.beginPath(); ctx.arc(cx, cy, 30, 0, Math.PI * 2);
                ctx.fillStyle = cg; ctx.fill();
                ctx.strokeStyle = '#fff'; ctx.lineWidth = 3; ctx.stroke();
            }

            // ── Mở popup ─────────────────────────────────────────────────────
            window.openSpinModal = async function() {
                const modal = document.getElementById('spin-modal');
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';

                if (!initialised) {
                    await loadVouchers();
                    initialised = true;
                }
                const canvas = document.getElementById('spin-canvas');
                const size = Math.min(300, window.innerWidth * 0.78);
                canvas.width = canvas.height = size;
                drawWheel(canvas);
            };

            // ── Đóng popup ────────────────────────────────────────────────────
            window.closeSpinModal = function() {
                document.getElementById('spin-modal').style.display = 'none';
                document.body.style.overflow = '';
            };

            // ── Quay ─────────────────────────────────────────────────────────
            window.doSpin = async function() {
                if (isSpinning) return;
                const btn = document.getElementById('spin-center-btn');
                isSpinning = true; btn.disabled = true;

                const token = document.querySelector('#spin-form input[name="__RequestVerificationToken"]').value;
                let data;
                try {
                    const res = await fetch('/Spin/DoSpin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                    });
                    data = await res.json();
                } catch(e) {
                    isSpinning = false; btn.disabled = false;
                    alert('Lỗi kết nối, thử lại nhé!'); return;
                }

                if (!data.success) {
                    isSpinning = false; btn.disabled = false;
                    showSpinResult('😅', data.message, '', data.message); return;
                }

                // ⚡ Đồng bộ segments từ server (nguồn sự thật duy nhất)
                const canvas = document.getElementById('spin-canvas');
                if (data.segmentLabels && data.segmentLabels.length) {
                    segments = data.segmentLabels;
                    drawWheel(canvas); // vẽ lại với đúng nhãn server
                }

                // Animate đến đúng ô server chọn
                const n = segments.length;
                const arc = (2 * Math.PI) / n;
                const targetAngle = (3 * Math.PI / 2) - (data.segmentIndex + 0.5) * arc;
                const extra = Math.PI * 2 * (5 + Math.random() * 4);
                const diff = ((targetAngle - rotation) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
                const finalRot = rotation - (Math.PI * 2 - diff) - extra;
                const startRot = rotation, startTime = performance.now();
                const duration = 3500 + Math.random() * 1000;

                function easeOut(t) { return 1 - Math.pow(1 - t, 4); }
                function animate(now) {
                    const t = Math.min((now - startTime) / duration, 1);
                    rotation = startRot + (finalRot - startRot) * easeOut(t);
                    drawWheel(canvas);
                    if (t < 1) { requestAnimationFrame(animate); }
                    else {
                        rotation = finalRot;
                        isSpinning = false;
                        btn.style.display = 'none'; // Không còn lượt hôm nay
                        if (data.isWin) {
                            launchConfetti();
                            showSpinResult('🎉', data.label, data.voucherCode, data.message);
                        } else {
                            showSpinResult('😢', data.label, '', data.message);
                        }
                    }
                }
                requestAnimationFrame(animate);
            };

            function showSpinResult(emoji, name, code, msg) {
                const area = document.getElementById('spin-result-area');
                document.getElementById('spin-result-emoji').textContent = emoji;
                document.getElementById('spin-result-name').textContent = name;
                const codeEl = document.getElementById('spin-result-code');
                if (code) { codeEl.textContent = code; codeEl.style.display = 'inline-block'; }
                else        codeEl.style.display = 'none';
                document.getElementById('spin-result-msg').innerHTML = msg;
                area.style.display = 'block';
            }

            function launchConfetti() {
                const colors = ['#FFD700','#ff6bff','#00e5ff','#ff6b6b','#1DD1A1'];
                for (let i = 0; i < 60; i++) {
                    const el = document.createElement('div');
                    el.style.cssText = `position:fixed;top:-10px;width:8px;height:8px;
                        border-radius:${Math.random()>.5?'50%':'2px'};
                        background:${colors[Math.floor(Math.random()*colors.length)]};
                        left:${Math.random()*100}vw;z-index:99999;pointer-events:none;
                        animation:confettiFall ${1.5+Math.random()*2}s linear ${Math.random()*.8}s forwards;`;
                    document.body.appendChild(el);
                    el.addEventListener('animationend', () => el.remove());
                }
            }

            // Đóng khi click vào overlay
            document.getElementById('spin-modal').addEventListener('click', function(e) {
                if (e.target === this) closeSpinModal();
            });
        })();
        </script>
        <style>
            @@keyframes confettiFall {
                to { transform: translateY(110vh) rotate(720deg); opacity: 0; }
            }
        </style>

        <script src="~/js/lazyload.js" defer></script>
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>

        <script>
            // Close welcome notification
            function closeWelcome() {
            const welcomeNotification = document.getElementById('welcome-notification');
            if (welcomeNotification) {
            welcomeNotification.style.opacity = '0';
            welcomeNotification.style.transform = 'translateX(100%)';
            setTimeout(() => {
            welcomeNotification.remove();
            }, 300);
            }
            }

            // Auto close welcome notification after 5 seconds
            setTimeout(() => {
            closeWelcome();
            }, 5000);

            // Loading Screen & AOS Initialization
            document.addEventListener('DOMContentLoaded', function () {
            // Initialize AOS
            if (typeof AOS !== 'undefined') {
            AOS.init({
            duration: 800,
            once: true,
            offset: 100
            });
            }

            const loadingScreen = document.getElementById('loadingScreen');
            const progressFill = document.querySelector('.progress-fill');

            let progress = 0;
            const interval = setInterval(() => {
            progress += Math.random() * 40 + 20;
            if (progress >= 100) {
            progress = 100;
            clearInterval(interval);
            if (progressFill) progressFill.style.width = '100%';
            setTimeout(() => {
            if (loadingScreen) {
            loadingScreen.style.opacity = '0';
            setTimeout(() => {
            loadingScreen.style.display = 'none';
            }, 300);
            }
            }, 100);
            } else {
            if (progressFill) progressFill.style.width = progress + '%';
            }
            }, 50);
            });

            // Header Scroll Effect
            let lastScrollY = window.scrollY;
            const header = document.getElementById('mainHeader');

            window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
            if (header) header.classList.add('scrolled');
            } else {
            if (header) header.classList.remove('scrolled');
            }
            lastScrollY = window.scrollY;
            });

            // Search Functionality
            const globalSearch = document.getElementById('globalSearch');
            const searchSuggestions = document.getElementById('searchSuggestions');

            if (globalSearch && searchSuggestions) {
            globalSearch.addEventListener('focus', () => {
            if (globalSearch.value.length > 0) {
            searchSuggestions.classList.remove('hidden');
            }
            });

            globalSearch.addEventListener('blur', () => {
            setTimeout(() => {
            searchSuggestions.classList.add('hidden');
            }, 200);
            });

            globalSearch.addEventListener('input', async (e) => {
            const query = e.target.value;

            if (query.length < 1) {
            searchSuggestions.classList.add('hidden');
            return;
            }

            const response = await fetch(`/HomeUser/Search?query=${encodeURIComponent(query)}`, {
            headers: {
            'X-Requested-With': 'XMLHttpRequest'
            }
            });
            const data = await response.json();

            if (data.redirectToUrl) {
            window.location.href = data.redirectToUrl;
            return;
            }

            const suggestionsContainer = searchSuggestions.querySelector('.max-h-60');
            if (suggestionsContainer) {
            if (data.suggestions && data.suggestions.length > 0) {
            suggestionsContainer.innerHTML = data.suggestions.map(item => `
            <a href="/HomeUser/Productdetails/${item.productId}" class="block px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer border-b border-gray-100 dark:border-gray-700 last:border-b-0">
            <div class="flex items-center gap-3">
            <i class="fas fa-search text-gray-400"></i>
            <span class="text-gray-700 dark:text-gray-300">${item.name}</span>
            </div>
            </a>
            `).join('');
            searchSuggestions.classList.remove('hidden');
            } else {
            suggestionsContainer.innerHTML = '<p class="p-4 text-sm text-gray-500">Không tìm thấy sản phẩm nào.</p>';
            searchSuggestions.classList.remove('hidden');
            }
            }
            });
            }

            // User Profile Dropdown với Click
            document.addEventListener('DOMContentLoaded', function () {
            const userProfileButton = document.getElementById('user-profile-button');
            const userProfileDropdown = document.getElementById('user-profile-dropdown');
            const userProfileChevron = document.getElementById('user-profile-chevron');
            const logoutTriggers = document.querySelectorAll('.logout-trigger');

            // Toggle dropdown khi click
            if (userProfileButton && userProfileDropdown && userProfileChevron) {
            userProfileButton.addEventListener('click', function (e) {
            e.stopPropagation();
            const isHidden = userProfileDropdown.classList.contains('hidden');
            userProfileDropdown.classList.toggle('hidden', !isHidden);
            userProfileChevron.classList.toggle('rotate-180', !isHidden);
            });
            }

            // Đóng dropdown khi click ra ngoài
            document.addEventListener('click', function () {
            if (userProfileDropdown && userProfileChevron) {
            userProfileDropdown.classList.add('hidden');
            userProfileChevron.classList.remove('rotate-180');
            }
            });

            // Ngăn đóng dropdown khi click vào dropdown
            if (userProfileDropdown) {
            userProfileDropdown.addEventListener('click', function (e) {
            e.stopPropagation();
            });
            }

            // XỬ LÝ POPUP ĐĂNG XUẤT
            const logoutPopup = document.getElementById('logout-popup');
            const logoutCancel = document.getElementById('logout-cancel');
            const logoutConfirm = document.getElementById('logout-confirm');

            function showLogoutPopup() {
            if (logoutPopup) logoutPopup.style.display = 'flex';
            }

            function hideLogoutPopup() {
            if (logoutPopup) logoutPopup.style.display = 'none';
            }

            // Gán sự kiện cho các nút đăng xuất
            logoutTriggers.forEach(trigger => {
            trigger.addEventListener('click', function (e) {
            e.preventDefault();
            // Đóng dropdown trước khi mở popup
            if (userProfileDropdown) userProfileDropdown.classList.add('hidden');
            if (userProfileChevron) userProfileChevron.classList.remove('rotate-180');
            showLogoutPopup();
            });
            });

            // Xử lý nút hủy
            if (logoutCancel) {
            logoutCancel.addEventListener('click', function () {
            hideLogoutPopup();
            });
            }

            // Xử lý nút xác nhận đăng xuất
            if (logoutConfirm) {
            logoutConfirm.addEventListener('click', function () {
            hideLogoutPopup();
            // Optional: show a loader here
            window.location.href = '/Account/Logout';
            });
            }

            // Đóng popup khi click bên ngoài
            if (logoutPopup) {
            logoutPopup.addEventListener('click', function (e) {
            if (e.target === logoutPopup) {
            hideLogoutPopup();
            }
            });
            }
            });

            // Dark Mode Toggle
            function toggleDarkMode() {
            const html = document.documentElement;
            html.classList.toggle('dark');
            localStorage.setItem('darkMode', html.classList.contains('dark'));
            }

            // Check for saved dark mode preference
            if (localStorage.getItem('darkMode') === 'true') {
            document.documentElement.classList.add('dark');
            }


            // =======================================================
            // 🤖 CHAT WIDGET FUNCTIONALITY (ĐÃ SỬA CHO CẤU TRÚC HTML MỚI)
            // =======================================================
            document.addEventListener('DOMContentLoaded', function () {
            // Lấy các phần tử DOM
            const chatToggle = document.getElementById('chat-toggle');
            const chatContainer = document.getElementById('chat-container'); // Khối chat chính
            const chatClose = document.getElementById('chat-close');
            const chatInput = document.getElementById('chat-input');
            const chatSend = document.getElementById('chat-send');
            const chatMessagesContainer = document.getElementById('chat-messages'); // Khu vực chứa tin nhắn
            const chatClear = document.getElementById('chat-clear'); // Bạn cần thêm nút này vào HTML Header

            // Đường dẫn Avatar (Sử dụng đường dẫn của bạn)
            const aiAvatarUrl = '/images/nhân viên tư vấn.png';

            // Class Tailwind cho màu sắc
            const userBg = 'bg-indigo-500 text-white';
            const aiBg = 'bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200';

            // Hàm tạo tin nhắn trên giao diện
            function createMessageElement(text, sender, isLoading = false) {
            const messageWrapper = document.createElement('div');
            messageWrapper.className = `flex gap-2 mb-4 ${sender === 'user' ? 'justify-end' : 'justify-start'}`;

            const innerContent = document.createElement('div');
            innerContent.className = 'flex-1 max-w-[85%]';

            // Nếu là tin nhắn AI, thêm Avatar và căn chỉnh
            if (sender === 'ai') {
            messageWrapper.classList.add('items-start', 'justify-start');

            // Thêm Avatar
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'w-8 h-8 bg-primary rounded-full overflow-hidden flex-shrink-0';
            avatarDiv.innerHTML = `<img src="${aiAvatarUrl}" alt="Fox AI" class="w-full h-full object-cover">`;
            messageWrapper.appendChild(avatarDiv);

            innerContent.className = 'flex-1';
            } else {
            messageWrapper.classList.add('justify-end');
            innerContent.className = 'flex-none';
            }


            // Nội dung tin nhắn chính
            const messageBubble = document.createElement('div');
            messageBubble.className = `rounded-lg p-3 shadow-sm ${sender === 'user' ? userBg : aiBg}`;

            if (isLoading) {
            messageBubble.id = 'loading-message';
            messageBubble.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Fox AI đang gõ...';
            } else {
            // Xử lý xuống dòng và hiển thị nội dung
            messageBubble.innerHTML = text.replace(/\n/g, '<br>');
            }

            innerContent.appendChild(messageBubble);

            // Thêm bubble vào wrapper
            messageWrapper.appendChild(innerContent);

            chatMessagesContainer.appendChild(messageWrapper);
            chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight; // Cuộn xuống dưới
            return messageWrapper;
            }

            // Hàm tải lịch sử chat
            async function loadHistory() {
            try {
            // Gọi action GetChatHistory trong ChatController
            const response = await fetch('/Chat/GetChatHistory');
            const history = await response.json();

            chatMessagesContainer.innerHTML = ''; // Xóa nội dung cũ

            if (history.length === 0) {
            createMessageElement("Chào bạn! Tôi là Fox AI, chuyên gia tư vấn công nghệ của FOXMOBILE. Tôi có thể giúp bạn tìm kiếm Điện thoại hoặc Laptop phù hợp!", 'ai');
            } else {
            history.forEach(msg => {
            createMessageElement(msg.userPrompt, 'user');
            createMessageElement(msg.aiResponse, 'ai');
            });
            }
            } catch (error) {
            console.error('Lỗi khi tải lịch sử chat:', error);
            }
            }


            // Hàm gửi tin nhắn
            async function sendMessage() {
            const userPrompt = chatInput.value.trim();
            if (userPrompt === '') return;

            // 1. Hiển thị tin nhắn người dùng
            createMessageElement(userPrompt, 'user');
            chatInput.value = '';
            chatInput.disabled = true;
            chatSend.disabled = true;

            // 2. Hiện tin nhắn Loading
            const loadingMsg = createMessageElement('', 'ai', true);

            try {
            // 3. Gửi tin nhắn đến Controller
            const response = await fetch('/Chat/Ask', {
            method: 'POST',
            headers: {
            'Content-Type': 'application/json',
            },
            body: JSON.stringify({ UserPrompt: userPrompt })
            });

            const data = await response.json();

            // 4. Xóa loading và hiển thị câu trả lời
            const existingLoading = document.getElementById('loading-message');
            if (existingLoading) existingLoading.remove();

            if (data.success) {
            createMessageElement(data.aiResponse, 'ai');
            } else {
            createMessageElement("Xin lỗi, Fox AI gặp lỗi: " + (data.message || "Không nhận được phản hồi từ server."), 'ai');
            }

            } catch (error) {
            const existingLoading = document.getElementById('loading-message');
            if (existingLoading) existingLoading.remove();
            createMessageElement("Lỗi kết nối. Vui lòng kiểm tra Server và API Key.", 'ai');
            console.error('Lỗi gửi tin nhắn:', error);
            } finally {
            chatInput.disabled = false;
            chatSend.disabled = false;
            chatInput.focus();
            }
            }

            // Hàm xóa lịch sử
            async function clearHistory() {
            if (confirm("Bạn có chắc chắn muốn xóa toàn bộ lịch sử chat không?")) {
            await fetch('/Chat/ClearHistory', { method: 'POST' });
            loadHistory();
            }
            }

            // --- KÍCH HOẠT CÁC CHỨC NĂNG CHATBOT ---

            // Toggle chat visibility
            if (chatToggle && chatContainer) {
            chatToggle.addEventListener('click', function () {
            chatContainer.classList.toggle('hidden');
            if (!chatContainer.classList.contains('hidden')) {
            loadHistory(); // Tải lịch sử khi mở
            chatInput.focus();
            }
            });
            }

            // Close chat
            if (chatClose && chatContainer) {
            chatClose.addEventListener('click', function () {
            chatContainer.classList.add('hidden');
            });
            }

            // Send message on button click
            if (chatSend) {
            chatSend.addEventListener('click', sendMessage);
            }

            // Send message on Enter key
            if (chatInput) {
            chatInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
            sendMessage();
            e.preventDefault();
            }
            });
            }

            // Xử lý nút xóa lịch sử (Nếu bạn thêm ID chat-clear vào HTML)
            if (chatClear) {
            chatClear.addEventListener('click', clearHistory);
            }
            });
        </script>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
        <script>
            function showCustomAlert(message, type = 'error') {
            if (typeof Swal !== 'undefined') {
            Swal.fire({
            icon: type,
            title: 'Thông báo',
            text: message,
            confirmButtonColor: '#f48c25'
            });
            } else {
            alert(message);
            }
            }
        </script>

        <!-- Leaflet JS for Maps -->
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <!-- Map Address Handler -->
        <script src="~/js/map-address.js"></script>

        @RenderSection("Scripts", required: false)
    </body>

</html>