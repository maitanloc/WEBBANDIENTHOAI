@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Lấy thông tin từ Session
    var session = HttpContextAccessor.HttpContext?.Session;
    var isLoggedIn = !string.IsNullOrEmpty(session?.GetString("CustomerId")) ||
                     !string.IsNullOrEmpty(session?.GetString("UserId"));

    var customerName = session?.GetString("Username") ?? "Khách";
    var customerEmail = session?.GetString("Email");
    var customerId = session?.GetString("CustomerId");
    var userId = session?.GetString("UserId");
    var roleName = session?.GetString("RoleName");

    // Gán vào ViewBag để dùng trong welcome notification và các thành phần khác
    ViewBag.IsLoggedIn = isLoggedIn;
    ViewBag.CustomerName = customerName;
    ViewBag.CustomerEmail = customerEmail;
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FOXMOBILE | Thế giới công nghệ cao cấp</title>

    <!-- SEO Optimization -->
    <meta name="description" content="FOXMOBILE - Cửa hàng điện thoại, laptop, tablet và phụ kiện chính hãng. Giá tốt nhất, bảo hành dài hạn, giao hàng miễn phí.">
    <meta name="keywords" content="điện thoại, laptop, tablet, foxmobile, công nghệ, smartphone">
    <meta name="author" content="FOXMOBILE">

    <!-- Open Graph -->
    <meta property="og:title" content="FOXMOBILE - Thế giới công nghệ cao cấp">
    <meta property="og:description" content="Khám phá những sản phẩm công nghệ mới nhất với giá tốt nhất tại FOXMOBILE">
    <meta property="og:type" content="website">
    <meta property="og:image" content="/images/foxmobile-og.jpg">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f48c25",
                        "primary-dark": "#d97a1a",
                        "secondary": "#1f2937",
                        "accent": "#10b981",
                        "background-light": "#f8f7f5",
                        "background-dark": "#221910",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 3s ease-in-out infinite',
                        'bounce-slow': 'bounce 2s infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                },
            },
        }
    </script>

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #f48c25;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #d97a1a;
            }

        /* Gradient text */
        .gradient-text {
            background: linear-gradient(135deg, #f48c25 0%, #f59e0b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* === POPUP XÁC NHẬN ĐĂNG XUẤT === */
        .logout-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
        }

        .logout-popup {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            max-width: 400px;
            width: 90%;
            text-align: center;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .logout-image {
            width: 120px;
            height: 120px;
            margin: 0 auto 1.5rem;
            border-radius: 12px;
            object-fit: cover;
        }

        .logout-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .logout-message {
            color: #6b7280;
            margin-bottom: 2rem;
        }

        .logout-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .logout-btn-cancel {
            background: #6b7280;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.2s;
        }

            .logout-btn-cancel:hover {
                background: #4b5563;
            }

        .logout-btn-confirm {
            background: #ef4444;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.2s;
        }

            .logout-btn-confirm:hover {
                background: #dc2626;
            }

        /* === CHAT WIDGET STYLES === */
        #chat-container {
            animation: slideUp 0.3s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        #chat-messages::-webkit-scrollbar {
            width: 4px;
        }

        #chat-messages::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        #chat-messages::-webkit-scrollbar-thumb {
            background: #f48c25;
            border-radius: 4px;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200 antialiased">
    <!-- Custom Alert Popup -->
    <div id="custom-alert-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[10001] hidden items-center justify-center p-4">
        <div id="custom-alert-box" class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-6 w-full max-w-md text-center transform scale-95 transition-all duration-300">
            <div class="flex justify-center items-center mb-4">
                <div class="w-20 h-20 bg-orange-100 dark:bg-orange-900/30 rounded-full flex items-center justify-center border-4 border-white dark:border-gray-700">
                    <i class="fas fa-exclamation-triangle text-4xl text-primary"></i>
                </div>
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Thông báo</h3>
