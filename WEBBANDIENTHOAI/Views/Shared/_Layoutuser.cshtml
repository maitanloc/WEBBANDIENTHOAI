                            <i class="fas fa-mobile-alt text-base"></i>
                            <span>Điện thoại</span>
                        </a>
                        <a href="/HomeUser/Laptops" class="text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors duration-200 flex items-center gap-2 group">
                            <i class="fas fa-laptop text-base"></i>
                            <span>Laptop</span>
