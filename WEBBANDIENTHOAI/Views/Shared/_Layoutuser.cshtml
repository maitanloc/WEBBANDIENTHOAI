<!DOCTYPE html>
<html class="light" lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FOXMOBILE | Thế giới công nghệ cao cấp</title>

    <!-- SEO Optimization -->
    <meta name="description"
          content="FOXMOBILE - Cửa hàng điện thoại, laptop, tablet và phụ kiện chính hãng. Giá tốt nhất, bảo hành dài hạn, giao hàng miễn phí.">
    <meta name="keywords" content="điện thoại, laptop, tablet, foxmobile, công nghệ, smartphone">
    <meta name="author" content="FOXMOBILE">

    <!-- Open Graph -->
    <meta property="og:title" content="FOXMOBILE - Thế giới công nghệ cao cấp">
    <meta property="og:description" content="Khám phá những sản phẩm công nghệ mới nhất với giá tốt nhất tại FOXMOBILE">
    <meta property="og:type" content="website">
    <meta property="og:image" content="/images/foxmobile-og.jpg">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Leaflet CSS for Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <script>
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "primary": "#f48c25",
        "primary-dark": "#d97a1a",
        "secondary": "#1f2937",
        "accent": "#10b981",
        "background-light": "#f8f7f5",
        "background-dark": "#221910",
        },
        fontFamily: {
        "display": ["Inter", "sans-serif"]
        },
        animation: {
        'float': 'float 6s ease-in-out infinite',
        'pulse-slow': 'pulse 3s ease-in-out infinite',
        'bounce-slow': 'bounce 2s infinite',
        },
        keyframes: {
        float: {
        '0%, 100%': { transform: 'translateY(0px)' },
        '50%': { transform: 'translateY(-10px)' },
        }
        }
        },
        },
        }
    </script>

    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Custom Scrollbar (Slide Bar style) */
        ::-webkit-scrollbar {
        width: 6px;
        }

        ::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.02);
        border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
        background: #f48c25;
        border-radius: 20px;
        border: 1px solid transparent;
        background-clip: content-box;
        }

        ::-webkit-scrollbar-thumb:hover {
        background: #d97a1a;
        }

        .sidebar-scrollable {
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #f48c25 rgba(0, 0, 0, 0.05);
        }

        /* Gradient text */
        .gradient-text {
        background: linear-gradient(135deg, #f48c25 0%, #f59e0b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        }

        /* === POPUP XÁC NHẬN ĐĂNG XUẤT === */
        .logout-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        }

        .logout-popup {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        max-width: 400px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .logout-image {
        width: 120px;
        height: 120px;
        margin: 0 auto 1.5rem;
        border-radius: 12px;
        object-fit: cover;
        }

        .logout-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
        }

        .logout-message {
        color: #6b7280;
        margin-bottom: 2rem;
        }

        .logout-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        }

        .logout-btn-cancel {
        background: #6b7280;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        transition: background-color 0.2s;
        }

        .logout-btn-cancel:hover {
        background: #4b5563;
        }

        .logout-btn-confirm {
        background: #ef4444;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        transition: background-color 0.2s;
        }

        .logout-btn-confirm:hover {
        background: #dc2626;
        }

        /* === CHAT WIDGET STYLES === */
        #chat-container {
        animation: slideUp 0.3s ease-out;
        }

        @@keyframes slideUp {
        from {
        opacity: 0;
        transform: translateY(20px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        #chat-messages::-webkit-scrollbar {
        width: 4px;
        }

        #chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1;
        }

        #chat-messages::-webkit-scrollbar-thumb {
        background: #f48c25;
        border-radius: 4px;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200 antialiased">
    <!-- POPUP XÁC NHẬN ĐĂNG XUẤT -->
    <div id="logout-popup" class="logout-overlay">
        <div class="logout-popup">
            <img src="~/images/hỏi đăng xuất.png" alt="Xác nhận đăng xuất" class="logout-image" />
            <h3 class="logout-title">Xác nhận đăng xuất</h3>
            <p class="logout-message">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
            <div class="logout-buttons">
                <button id="logout-cancel" class="logout-btn-cancel">Hủy</button>
                <button id="logout-confirm" class="logout-btn-confirm">Đăng xuất</button>
            </div>
        </div>
    </div>
    <!-- Welcome Notification -->
    @if (ViewBag.IsLoggedIn == true && !string.IsNullOrEmpty(ViewBag.CustomerName?.ToString()))
    {
        <div id="welcome-notification"
             class="fixed top-20 right-4 bg-white dark:bg-gray-800 rounded-lg shadow-lg p-4 z-50 border border-primary/20 animate-bounce-slow">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center">
                    <span class="text-white font-bold text-sm">
                        @ViewBag.CustomerName?.ToString().Substring(0, 1).ToUpper()
                    </span>
                </div>
                <div>
                    <h4 class="font-semibold text-gray-800 dark:text-white">Xin chào!</h4>
                    <p class="text-gray-600 dark:text-gray-300 text-sm">Chào mừng @ViewBag.CustomerName quay trở lại</p>
                </div>
                <button onclick="closeWelcome()" class="text-gray-400 hover:text-gray-600">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }

    <!-- Loading Screen -->
    <div id="loadingScreen"
         class="fixed inset-0 bg-white dark:bg-gray-900 z-50 flex items-center justify-center transition-opacity duration-500">
        <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 relative">
                <div class="absolute inset-0 bg-primary rounded-full animate-ping"></div>
                <div class="absolute inset-2 bg-primary rounded-full flex items-center justify-center">
                    <span class="text-white font-bold text-lg">F</span>
                </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 font-medium">Đang tải FOXMOBILE...</p>
            <div class="w-32 h-1 bg-gray-200 rounded-full mt-4 mx-auto overflow-hidden">
                <div class="h-full bg-primary rounded-full progress-fill" style="width: 0%"></div>
            </div>
        </div>
    </div>

    <div class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">

            <!-- Enhanced Header -->
            <header
                class="sticky top-0 z-40 flex items-center justify-between border-b border-solid border-primary/20 bg-background-light/95 dark:bg-background-dark/95 px-4 sm:px-6 lg:px-8 py-3 backdrop-blur-md transition-all duration-300 shadow-sm"
                id="mainHeader">
                <!-- Logo Section -->
                <div class="flex items-center gap-6">
                    <a href="/HomeUser" class="flex items-center gap-3 text-gray-800 dark:text-white group">
                        <div class="relative">
                            <div
                                class="size-12 bg-gradient-to-br from-primary to-primary-dark rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300 transform group-hover:scale-105">
                                <span class="text-white font-bold text-lg">F</span>
                            </div>
                            <div
                                class="absolute -inset-1 bg-primary/20 rounded-xl blur-sm group-hover:blur-md transition-all duration-300">
                            </div>
                        </div>
                        <div>
                            <h2 class="text-xl font-black tracking-tight gradient-text">FOXMOBILE</h2>
                            <p class="text-xs text-gray-500 dark:text-gray-400 -mt-1">Premium Technology</p>
                        </div>
                    </a>
                </div>

                <!-- Enhanced Search -->
                <div class="hidden lg:flex flex-1 justify-center px-8 max-w-2xl">
                    <form action="/HomeUser/Search" method="get" class="relative w-full group">
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-primary/20 to-primary-dark/20 rounded-xl blur-sm group-hover:blur transition-all duration-300">
                        </div>
                        <div
                            class="relative flex items-stretch rounded-xl h-12 bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 group-hover:shadow-md transition-all duration-300">
                            <div class="text-gray-500 dark:text-gray-400 flex items-center justify-center pl-4">
                                <i class="fas fa-search"></i>
                            </div>
                            <input
                            class="flex-1 rounded-r-xl text-gray-800 dark:text-white bg-transparent border-none h-full px-4 text-sm focus:outline-none focus:ring-0"
                            placeholder="Tìm kiếm sản phẩm, thương hiệu..." id="globalSearch" name="query"
                            autocomplete="off" />
                            <button type="submit" class="px-4 text-gray-500 hover:text-primary transition-colors">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        <!-- Search Suggestions -->
                        <div class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 hidden z-50 overflow-hidden"
                             id="searchSuggestions">
                            <div class="p-3 border-b border-gray-100 dark:border-gray-700">
                                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Đề xuất tìm kiếm
                                </p>
                            </div>
                            <div class="max-h-60 overflow-y-auto">
                                <!-- Suggestions will be populated by JavaScript -->
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Enhanced Navigation & Actions -->
                <div class="flex items-center gap-4">
                    <!-- Desktop Navigation -->
                    <nav class="hidden xl:flex items-center gap-6 mr-4">
                        <a href="/HomeUser/Smartphones"
                               class="text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors duration-200 flex items-center gap-2 group">
                            <i class="fas fa-mobile-alt text-base"></i>
                            <span>Điện thoại</span>
                        </a>
                        <a href="/HomeUser/Laptops"
                               class="text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors duration-200 flex items-center gap-2 group">
                            <i class="fas fa-laptop text-base"></i>
                            <span>Laptop</span>
                        </a>
                    </nav>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-3">


                        <!-- Cart with Enhanced Badge -->
                        <a href="/HomeCarts/Index"
                               class="flex items-center justify-center rounded-xl w-10 h-10 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-200 relative group">
                            <i
                            class="fas fa-shopping-cart text-gray-600 dark:text-gray-400 group-hover:text-primary"></i>
                            @* <span class="absolute -top-1 -right-1 bg-primary text-white rounded-full w-5 h-5 text-xs flex items-center justify-center shadow-lg cart-count transform group-hover:scale-110 transition-transform">
                                !
                            </span> *@
                        </a>



                        <!-- User Profile với Click Dropdown -->
                        <div class="relative" id="user-profile-container">
                            <button id="user-profile-button"
                                    class="flex items-center gap-2 rounded-xl px-3 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-200">
                                @if (ViewBag.IsLoggedIn == true)
                                {
                                    <div
                                        class="w-8 h-8 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white text-sm font-semibold">
                                        @(!string.IsNullOrEmpty(ViewBag.CustomerName?.ToString()) ?
                                    ViewBag.CustomerName.ToString().Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <i class="fas fa-chevron-down text-gray-500 text-xs transition-transform"
                                       id="user-profile-chevron"></i>
                                }
                                else
                                {
                                    <div
                                        class="w-8 h-8 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white text-sm font-semibold">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <i class="fas fa-chevron-down text-gray-500 text-xs transition-transform"
                                       id="user-profile-chevron"></i>
                                }
                            </button>

                            <!-- Enhanced User Dropdown -->
                            <div id="user-profile-dropdown"
                                 class="absolute right-0 top-full mt-2 w-64 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 hidden z-50 overflow-hidden">
                                @if (ViewBag.IsLoggedIn == true)
                                {
                                    <div class="p-4 border-b border-gray-100 dark:border-gray-700">
                                        <div class="flex items-center gap-3">
                                            <div
                                                class="w-12 h-12 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white font-semibold">
                                                @(!string.IsNullOrEmpty(ViewBag.CustomerName?.ToString()) ?
                                            ViewBag.CustomerName.ToString().Substring(0, 1).ToUpper() : "U")
                                            </div>
                                            <div>
                                                <p class="font-semibold text-gray-800 dark:text-white">@ViewBag.CustomerName
                                                </p>
                                                @if (!string.IsNullOrEmpty(ViewBag.CustomerEmail?.ToString()))
                                                {
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">@ViewBag.CustomerEmail
                                                    </p>
                                                }
                                                @if (!string.IsNullOrEmpty(ViewBag.CustomerPhone?.ToString()))
                                                {
                                                    <p class="text-xs text-gray-400">@ViewBag.CustomerPhone</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-2">
                                        <a href="/Info/ThongTinKH"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-user text-gray-500 w-5"></i>
                                            <span>Tài khoản của tôi</span>
                                        </a>
                                        <a asp-controller="Orders" asp-action="HomeOrders"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-clipboard-list text-gray-500 w-5"></i>
                                            <span>Đơn hàng</span>
                                        </a>
                                        <a asp-controller="Loyalty" asp-action="Index"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-gem text-gray-500 w-5"></i>
                                            <span>Điểm thưởng & Ưu đãi</span>
                                        </a>
                                        <a asp-controller="Loyalty" asp-action="MyVouchers"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-tags text-primary w-5"></i>
                                            <span>Kho Voucher</span>
                                        </a>
                                        <button
                                            class="logout-trigger w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 transition-colors text-left">
                                            <i class="fas fa-sign-out-alt w-5"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 border-b border-gray-100 dark:border-gray-700">
                                        <div class="flex items-center gap-3">
                                            <div
                                                class="w-12 h-12 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white font-semibold">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <p class="font-semibold text-gray-800 dark:text-white">Khách</p>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Chưa đăng nhập</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-2">
                                        <a href="/Account/Login"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-sign-in-alt text-gray-500 w-5"></i>
                                            <span>Đăng nhập</span>
                                        </a>
                                        <a href="/Account/Login"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-user-plus text-gray-500 w-5"></i>
                                            <span>Đăng ký</span>
                                        </a>
                                        <div class="border-t border-gray-100 dark:border-gray-700 my-2"></div>
                                        <a href="/help"
                                               class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-question-circle text-gray-500 w-5"></i>
                                            <span>Trợ giúp</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Mobile Navigation Bottom Bar -->
            <div
                class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 z-30 lg:hidden">
                <div class="flex justify-around items-center py-2">
                    <a href="/" class="flex flex-col items-center text-primary">
                        <i class="fas fa-home text-lg"></i>
                        <span class="text-xs mt-1">Trang chủ</span>
                    </a>
                    <a href="/products" class="flex flex-col items-center text-gray-600 dark:text-gray-400">
                        <i class="fas fa-th-large text-lg"></i>
                        <span class="text-xs mt-1">Danh mục</span>
                    </a>
                    <a href="/search" class="flex flex-col items-center text-gray-600 dark:text-gray-400">
                        <i class="fas fa-search text-lg"></i>
                        <span class="text-xs mt-1">Tìm kiếm</span>
                    </a>
                    <a href="/cart" class="flex flex-col items-center text-gray-600 dark:text-gray-400 relative">
                        <i class="fas fa-shopping-cart text-lg"></i>
                        <span class="text-xs mt-1">Giỏ hàng</span>
                        <span
                        class="absolute -top-1 -right-2 bg-primary text-white rounded-full w-5 h-5 text-xs flex items-center justify-center">2</span>
                    </a>
                    <a href="/account" class="flex flex-col items-center text-gray-600 dark:text-gray-400">
                        <i class="fas fa-user text-lg"></i>
                        <span class="text-xs mt-1">Tài khoản</span>
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <main class="flex flex-col flex-1 pb-20 lg:pb-0">
                @RenderBody()
            </main>

            <!-- Enhanced Footer -->
            <footer class="bg-gradient-to-br from-gray-900 to-gray-800 text-white relative overflow-hidden">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-5">
                    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\" 60\"
                         height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\"
                         fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Ccircle cx=\"30\"
                         cy=\"30\" r=\"1\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
                </div>

                <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
                        <!-- Brand Column -->
                        <div class="lg:col-span-1">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="w-12 h-12 bg-gradient-to-br from-primary to-primary-dark rounded-xl flex items-center justify-center shadow-lg">
                                    <span class="text-white font-bold text-lg">F</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-black gradient-text">FOXMOBILE</h3>
                                    <p class="text-sm text-gray-400">Premium Technology</p>
                                </div>
                            </div>
                            <p class="text-gray-300 mb-6 leading-relaxed">
                                Đồng hành cùng bạn trong hành trình khám phá thế giới công nghệ. Chất lượng - Uy tín -
                                Đẳng cấp.
                            </p>
