<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FOXMOBILE | Thế giới công nghệ cao cấp</title>

    <!-- SEO Optimization -->
