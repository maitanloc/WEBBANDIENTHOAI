                                                <p class="font-semibold text-gray-800 dark:text-white">@customerName</p>
                                                @if (!string.IsNullOrEmpty(customerEmail))
                                                {
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">@customerEmail</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-2">
                                        <a href="/account" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-user text-gray-500 w-5"></i>
                                            <span>Tài khoản của tôi</span>
                                        </a>
                                        <a href="/orders" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
