                                            <i class="fas fa-sign-out-alt w-5"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 border-b border-gray-100 dark:border-gray-700">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-12 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white font-semibold">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <p class="font-semibold text-gray-800 dark:text-white">Khách</p>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Chưa đăng nhập</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-2">
                                        <a href="/Account/Login" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-sign-in-alt text-gray-500 w-5"></i>
                                            <span>Đăng nhập</span>
                                        </a>
                                        <a href="/Account/Login" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-user-plus text-gray-500 w-5"></i>
                                            <span>Đăng ký</span>
                                        </a>
                                        <div class="border-t border-gray-100 dark:border-gray-700 my-2"></div>
                                        <a href="/help" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            <i class="fas fa-question-circle text-gray-500 w-5"></i>
                                            <span>Trợ giúp</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Mobile Navigation Bottom Bar -->
            <div class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 z-30 lg:hidden">
                <div class="flex justify-around items-center py-2">
                    <a href="/" class="flex flex-col items-center text-primary">
                        <i class="fas fa-home text-lg"></i>
                        <span class="text-xs mt-1">Trang chủ</span>
                    </a>
                    <a href="/products" class="flex flex-col items-center text-gray-600 dark:text-gray-400">
                        <i class="fas fa-th-large text-lg"></i>
                        <span class="text-xs mt-1">Danh mục</span>
                    </a>
