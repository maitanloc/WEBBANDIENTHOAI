@{
    Layout = null;
    var currentSearch = Context.Request.Query["search"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - WebBánĐiệnThoại</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Products.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="font-display bg-background-light text-gray-800 antialiased">
    <div class="min-h-screen flex">
        <!-- === SIDEBAR (moved here, exact code from your Admin Index) === -->
        <aside class="w-64 flex-shrink-0 bg-surface-light dark:bg-surface-dark border-r border-border-light dark:border-border-dark flex flex-col p-4">
            <div class="flex items-center gap-3 px-2 mb-6">
                <span class="material-symbols-outlined text-primary text-3xl">store</span>
                <h1 class="text-xl font-bold">WebBánĐiệnThoại</h1>
            </div>

            <nav class="flex flex-col gap-2 flex-grow">
                <!-- Quản lý Sản Phẩm -->
                <details class="group" open>
                    <summary class="flex items-center justify-between p-3 rounded-DEFAULT cursor-pointer hover:bg-primary/10">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-text-muted-light">smartphone</span>
                            <span class="font-medium text-sm">Quản lý Sản Phẩm</span>
                        </div>
                        <span class="material-symbols-outlined transform transition-transform group-open:rotate-90 text-sm">chevron_right</span>
                    </summary>
                    <div class="pl-8 pt-2 flex flex-col gap-2">
                        <a href="@Url.Action("Index","Products")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Index","Products")">
                            <span class="material-symbols-outlined text-sm">inventory_2</span>
                            Sản Phẩm
                        </a>
                        <a href="@Url.Action("ProductStatuses","ProductStatuses")" class="flex items-center gap-3 p-2 rounded text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 transition-colors panel-link" data-url="@Url.Action("ProductStatuses","ProductStatuses")">
                            <span class="material-symbols-outlined text-base">category</span>
                            Trạng thái sản phẩm
                        </a>
                        <a href="@Url.Action("Index","Categories")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Index","Categories")">
                            <span class="material-symbols-outlined text-sm">category</span>
                            Danh mục
                        </a>
                    </div>
                </details>

                <!-- Quản lý Đơn Hàng -->
                <details class="group">
                    <summary class="flex items-center justify-between p-3 rounded-DEFAULT cursor-pointer hover:bg-primary/10">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-text-muted-light">receipt_long</span>
                            <span class="font-medium text-sm">Quản lý Đơn Hàng</span>
                        </div>
                        <span class="material-symbols-outlined transform transition-transform group-open:rotate-90 text-sm">chevron_right</span>
                    </summary>
                    <div class="pl-8 pt-2 flex flex-col gap-2">
                        <a href="@Url.Action("Orders","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Orders","Admin")">
                            <span class="material-symbols-outlined text-sm">shopping_cart</span>
                            Đặt Hàng
                        </a>
                        <a href="@Url.Action("Shipping","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Shipping","Admin")">
                            <span class="material-symbols-outlined text-sm">local_shipping</span>
                            Vận Chuyển
                        </a>
                    </div>
                </details>

                <!-- Quản lý Tài Khoản -->
                <details class="group">
                    <summary class="flex items-center justify-between p-3 rounded-DEFAULT cursor-pointer hover:bg-primary/10">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-text-muted-light">group</span>
                            <span class="font-medium text-sm">Quản lý Tài Khoản</span>
                        </div>
                        <span class="material-symbols-outlined transform transition-transform group-open:rotate-90 text-sm">chevron_right</span>
                    </summary>
                    <div class="pl-8 pt-2 flex flex-col gap-2">
                        <a href="@Url.Action("Index","Customer")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Index","Customer")">
                            <span class="material-symbols-outlined text-sm">people</span>
                            Khách Hàng  
                        </a>
                        <a href="@Url.Action("StaffList","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("StaffList","Admin")">
                            <span class="material-symbols-outlined text-sm">badge</span>
                            Nhân Viên
                        </a>
                    </div>
                </details>

                <!-- Báo Cáo & Công Cụ -->
                <details class="group" open>
                    <summary class="flex items-center justify-between p-3 rounded-DEFAULT cursor-pointer hover:bg-primary/10 bg-primary/10">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">assessment</span>
                            <span class="font-medium text-sm text-primary">Báo Cáo & Công Cụ</span>
                        </div>
                        <span class="material-symbols-outlined transform transition-transform group-open:rotate-90 text-sm text-primary">chevron_right</span>
                    </summary>
                    <div class="pl-8 pt-2 flex flex-col gap-2">
                        <a href="@Url.Action("Reports","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-primary bg-primary/20 panel-link" data-url="@Url.Action("Reports","Admin")">
                            <span class="material-symbols-outlined text-sm">assessment</span>
                            Báo Cáo
                        </a>
                        <a href="@Url.Action("Audit","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Audit","Admin")">
                            <span class="material-symbols-outlined text-sm">history</span>
                            Nhật Ký
                        </a>
                        <a href="@Url.Action("Promos","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Promos","Admin")">
                            <span class="material-symbols-outlined text-sm">local_offer</span>
                            Khuyến Mãi
                        </a>
                        <a href="@Url.Action("Inventory","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Inventory","Admin")">
                            <span class="material-symbols-outlined text-sm">inventory_2</span>
                            Kho Hàng
                        </a>
                        <a href="@Url.Action("ImportExport","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("ImportExport","Admin")">
                            <span class="material-symbols-outlined text-sm">import_export</span>
                            Import/Export
                        </a>
                        <a href="@Url.Action("Support","Admin")" class="flex items-center gap-3 p-2 rounded-DEFAULT text-sm text-text-muted-light hover:text-text-light hover:bg-primary/10 panel-link" data-url="@Url.Action("Support","Admin")">
                            <span class="material-symbols-outlined text-sm">support_agent</span>
                            Hỗ Trợ
                        </a>
                    </div>
                </details>
            </nav>

            <div class="mt-auto">
                <div class="flex items-center gap-3 p-3 bg-surface-light/60 rounded-lg mb-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-orange-100 to-orange-50 text-primary font-semibold">AD</div>
                    <div class="flex flex-col">
                        <h1 class="text-gray-800 text-sm font-medium">Admin User</h1>
                        <p class="text-gray-500 text-xs">administrator@example.com</p>
                    </div>
                </div>

                <a id="nav-logout" class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-600 hover:bg-gray-100 cursor-pointer" href="@Url.Action("Logout","Account")">
                    <span class="material-symbols-outlined">logout</span>
                    <p class="text-sm font-medium">Đăng Xuất</p>
                </a>

                <div class="mt-3 text-xs text-gray-600/70 text-center">
                    <span>© 2025 WebBánĐiệnThoại</span>
                </div>
            </div>
        </aside>
        <!-- === end sidebar === -->

        <!-- MAIN -->
        <div class="flex-1 min-h-screen flex flex-col">
            <header class="bg-white border-b">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="h-16 flex items-center justify-between">
                        <form method="get" action="@Url.Action("Index","Products")" class="max-w-2xl w-full">
                            <div class="relative">
                                <input name="search" value="@(currentSearch)" class="w-full rounded-lg border px-4 py-2 pr-12 text-sm placeholder-gray-400" placeholder="Tìm theo tên, SKU, mã kho..." />
                                <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 bg-blue-600 text-white px-3 py-1.5 rounded-lg text-sm">
                                    <span class="material-symbols-outlined">search</span>
                                </button>
                            </div>
                        </form>

                        <div class="ml-4 flex items-center gap-3">
                            <button id="open-products-btn" data-url="@Url.Action("Index","Products")" class="hidden sm:inline-flex items-center gap-2 px-3 py-2 bg-primary text-white rounded panel-link" data-url="@Url.Action("Index","Products")">
                                <span class="material-symbols-outlined">inventory_2</span> Sản phẩm
                            </button>
                            <a href="@Url.Action("Logout","Account")" class="text-sm text-gray-600">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-auto">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                    <div id="panel-alerts" class="mb-4"></div>
                    <div id="panel-root" data-current-url="@Context.Request.Path@Context.Request.QueryString">
                        @RenderBody()
                    </div>
                </div>
            </main>

            <footer class="bg-white border-t">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
                    <div class="flex justify-between">
                        <div>© @(DateTime.UtcNow.Year) WebBánĐiệnThoại</div>
                        <div><a class="text-blue-600" href="#">Chính sách</a></div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <div id="panel-spinner" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/20">
        <div class="bg-white p-4 rounded-md flex items-center gap-3 shadow-lg">
            <div class="w-8 h-8 border-4 border-gray-200 border-t-blue-500 rounded-full animate-spin"></div>
            <div class="text-sm">Đang tải...</div>
        </div>
    </div>

    <style>.panel-link.active-panel-link { background: rgba(11,107,255,0.08); color:#0b6bff; border-radius:.5rem; }</style>

    <script src="~/js/admin-panel-loader.js" asp-append-version="true" defer></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
