@{
    Layout = null;
    var currentSearch = Context.Request.Query["search"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - Quản lý Fox Mobile</title>

    <!-- CHỈ SỬ DỤNG TAILWIND - LOẠI BỎ BOOTSTRAP CONFLICT -->
    <script src="https://cdn.tailwindcss.com?plugins=forms" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- LOẠI BỎ CSS CONFLICT -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- CSS TÙY CHỈNH RIÊNG CHO ADMIN -->
    <style>
        /* RESET LẠI MỘT SỐ STYLE BỊ CONFLICT */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        /* ẨN NỘI DUNG CHO ĐẾN KHI LOAD XONG */
        .main-content {
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .content-loaded .main-content {
            opacity: 1;
        }

        /* SIDEBAR FIXED */
        .sidebar-fixed {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 16rem;
            z-index: 40;
            background: white;
            border-right: 1px solid #e5e7eb;
        }

        /* MAIN CONTENT OFFSET */
        .main-content {
            margin-left: 16rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ACTIVE LINK STYLES */
        .panel-link.active-panel-link {
            background: rgba(11,107,255,0.08);
            color: #0b6bff;
            border-radius: 0.5rem;
        }

        /* MATERIAL ICONS FIX */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* SEARCH FORM STYLES */
        .search-form {
            max-width: 32rem;
        }

        /* === FIX QUAN TRỌNG: RESET TRIỆT ĐỂ CHO LOADER === */
        #initial-loader,
        #navigation-loader {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            z-index: 9999 !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            background: white !important; /* NỀN TRẮNG NGAY LẬP TỨC */
            transform: none !important;
            opacity: 1 !important;
            transition: none !important; /* KHÔNG CÓ TRANSITION GÂY DELAY */
        }

            #initial-loader.fade-out {
                opacity: 0 !important;
                pointer-events: none !important;
                transition: opacity 0.5s ease-in-out !important;
            }

            #navigation-loader.hidden {
                display: none !important;
            }

        /* RESET CONTAINER LOADER */
        .loader {
            position: absolute !important;
            top: 50% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) !important;
            width: fit-content !important;
            height: fit-content !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            background: transparent !important;
        }

        /* ĐẢM BẢO LOADER KHÔNG BỊ ẢNH HƯỞNG BỞI CSS KHÁC */
        .truckWrapper {
            position: relative !important;
            width: 200px !important;
            height: 100px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: flex-end !important;
            overflow-x: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
            transform: none !important;
        }

        /* LOADER XE TẢI - GIỮ NGUYÊN ANIMATION */
        .truckBody {
            width: 130px;
            height: fit-content;
            margin-bottom: 6px;
            animation: motion 1s linear infinite;
        }

        /* truck suspension animation*/
        @@keyframes motion {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(3px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        /* truck's tires */
        .truckTires {
            width: 130px;
            height: fit-content;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0px 10px 0px 15px;
            position: absolute;
            bottom: 0;
        }

            .truckTires svg {
                width: 24px;
            }

        .road {
            width: 100%;
            height: 1.5px;
            background-color: #282828;
            position: relative;
            bottom: 0;
            align-self: flex-end;
            border-radius: 3px;
        }

            .road::before {
                content: "";
                position: absolute;
                width: 20px;
                height: 100%;
                background-color: #282828;
                right: -50%;
                border-radius: 3px;
                animation: roadAnimation 1.4s linear infinite;
                border-left: 10px solid white;
            }

            .road::after {
                content: "";
                position: absolute;
                width: 10px;
                height: 100%;
                background-color: #282828;
                right: -65%;
                border-radius: 3px;
                animation: roadAnimation 1.4s linear infinite;
                border-left: 4px solid white;
            }

        .lampPost {
            position: absolute;
            bottom: 0;
            right: -90%;
            height: 90px;
            animation: roadAnimation 1.4s linear infinite;
        }

        @@keyframes roadAnimation {
            0% {
                transform: translateX(0px);
            }

            100% {
                transform: translateX(-350px);
            }
        }

        /* RESPONSIVE FIXES */
        @@media (max-width: 768px) {
            .sidebar-fixed {
                transform: translateX(-100%);
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-fixed.mobile-open {
                transform: translateX(0);
            }
        }

        /* === EMERGENCY FIX: ĐẢM BẢO KHÔNG CÓ BACKGROUND TRONG SUỐT === */
        #navigation-loader {
            background: white !important;
            background-color: white !important;
            background-image: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        /* === POPUP XÁC NHẬN ĐĂNG XUẤT === */
        .logout-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
        }

        .logout-popup {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            max-width: 400px;
            width: 90%;
            text-align: center;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .logout-image {
            width: 120px;
            height: 120px;
            margin: 0 auto 1.5rem;
            border-radius: 12px;
            object-fit: cover;
        }

        .logout-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .logout-message {
            color: #6b7280;
            margin-bottom: 2rem;
        }

        .logout-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .logout-btn-cancel {
            background: #6b7280;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.2s;
        }

            .logout-btn-cancel:hover {
                background: #4b5563;
            }

        .logout-btn-confirm {
            background: #ef4444;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.2s;
        }

            .logout-btn-confirm:hover {
                background: #dc2626;
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
