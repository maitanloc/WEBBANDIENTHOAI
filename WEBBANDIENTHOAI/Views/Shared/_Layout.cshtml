                            <div class="relative">
                                <input name="search" value="@(currentSearch)" class="w-full rounded-lg border border-gray-300 px-4 py-2 pr-12 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="Tìm theo tên, SKU, mã kho..." />
                                <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 bg-orange-500 text-white px-3 py-1.5 rounded-lg text-sm hover:bg-orange-600 transition-colors">
                                    <span class="material-symbols-outlined text-lg">search</span>
                                </button>
                            </div>
                        </form>

                        <div class="ml-4 flex items-center gap-3">
                            <button id="open-products-btn" class="hidden sm:inline-flex items-center gap-2 px-3 py-2 bg-orange-500 text-white rounded hover:bg-orange-600 transition-colors" data-loader="true">
                                <span class="material-symbols-outlined">inventory_2</span> Sản phẩm
                            </button>
                            <!-- Sửa link đăng xuất trong header -->
                            <a href="#" class="text-sm text-gray-600 hover:text-gray-800 logout-trigger">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-auto">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                    <div id="panel-alerts" class="mb-4"></div>
                    <div id="panel-root" data-current-url="@Context.Request.Path@Context.Request.QueryString">
                        @RenderBody()
                    </div>
                </div>
            </main>

            <footer class="bg-white border-t">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
                    <div class="flex justify-between">
                        <div>© @(DateTime.UtcNow.Year) WebBánĐiệnThoại</div>
                        <div><a class="text-orange-500 hover:text-orange-600" href="#">Chính sách</a></div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- NAVIGATION LOADER - HIỆN KHI CHUYỂN TRANG -->
    <div id="navigation-loader" class="hidden">
        <div class="loader">
            <div class="truckWrapper">
                <div class="truckBody">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 198 93" class="trucksvg">
