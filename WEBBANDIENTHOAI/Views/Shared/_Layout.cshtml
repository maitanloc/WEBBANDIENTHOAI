    </div>

    <script>
        // QUẢN LÝ LOADER TOÀN TRANG - ĐÃ SỬA LỖI
        document.addEventListener('DOMContentLoaded', function() {
            const initialLoader = document.getElementById('initial-loader');
            const navigationLoader = document.getElementById('navigation-loader');
            const logoutPopup = document.getElementById('logout-popup');
            const logoutCancel = document.getElementById('logout-cancel');
            const logoutConfirm = document.getElementById('logout-confirm');
            const logoutTriggers = document.querySelectorAll('.logout-trigger');
            const minLoadTime = 500; // 1.5 giây

            // XỬ LÝ POPUP ĐĂNG XUẤT
            function showLogoutPopup() {
                logoutPopup.style.display = 'flex';
            }

            function hideLogoutPopup() {
                logoutPopup.style.display = 'none';
            }

            // Gán sự kiện cho các nút đăng xuất
            logoutTriggers.forEach(trigger => {
                trigger.addEventListener('click', function(e) {
                    e.preventDefault();
                    showLogoutPopup();
                });
            });

            // Xử lý nút hủy
            logoutCancel.addEventListener('click', function() {
                hideLogoutPopup();
            });

            // Xử lý nút xác nhận đăng xuất
            logoutConfirm.addEventListener('click', function() {
                hideLogoutPopup();
                // Hiển thị loader và chuyển đến trang đăng xuất
                resetLoaderPosition();
                navigationLoader.style.background = 'white';
                navigationLoader.style.display = 'flex';
                navigationLoader.classList.remove('hidden');

                setTimeout(function() {
                    window.location.href = '@Url.Action("Logout", "Account")';
                }, minLoadTime);
            });

            // Đóng popup khi click bên ngoài
            logoutPopup.addEventListener('click', function(e) {
                if (e.target === logoutPopup) {
                    hideLogoutPopup();
                }
            });

            // FORCE RESET POSITION CHO LOADER
            function resetLoaderPosition() {
                if (initialLoader) {
                    initialLoader.style.position = 'fixed';
                    initialLoader.style.top = '0';
                    initialLoader.style.left = '0';
                    initialLoader.style.background = 'white';
                }
                if (navigationLoader) {
                    navigationLoader.style.position = 'fixed';
                    navigationLoader.style.top = '0';
                    navigationLoader.style.left = '0';
                    navigationLoader.style.background = 'white';
                    navigationLoader.style.display = 'flex';
                }
            }

            // GỌI NGAY KHI DOM LOAD
            resetLoaderPosition();

            // Thời điểm bắt đầu load
            const startTime = Date.now();

            // Hiển thị nội dung sau khi load
            function showContent() {
                const currentTime = Date.now();
                const elapsed = currentTime - startTime;
                const remainingTime = Math.max(0, minLoadTime - elapsed);

                setTimeout(function() {
                    document.body.classList.add('content-loaded');

                    setTimeout(function() {
                        initialLoader.classList.add('fade-out');
                        setTimeout(function() {
                            initialLoader.style.display = 'none';
                        }, 500);
                    }, 300);
                }, remainingTime);
            }

            // Xử lý khi trang load xong
            if (document.readyState === 'complete') {
                showContent();
            } else {
                window.addEventListener('load', function() {
                    resetLoaderPosition();
                    showContent();
                });
            }

            // Fallback
            setTimeout(function() {
                resetLoaderPosition();
                showContent();
            }, 3000);

            // QUẢN LÝ NAVIGATION LOADER - ĐÃ SỬA LỖI NỀN TRONG SUỐT
            const currentUrl = window.location.pathname + window.location.search;
            const links = document.querySelectorAll('[data-loader="true"]');

            links.forEach(link => {
                if (link.getAttribute('href') === currentUrl) {
                    link.classList.add('active-panel-link');
                }

                link.addEventListener('click', function(e) {
                    if (!this.target || this.target !== '_blank') {
                        e.preventDefault();
                        const href = this.getAttribute('href');

                        // ĐẢM BẢO LOADER CÓ NỀN TRẮNG NGAY LẬP TỨC
                        resetLoaderPosition();
                        navigationLoader.style.background = 'white';
                        navigationLoader.style.display = 'flex';
                        navigationLoader.classList.remove('hidden');

                        setTimeout(function() {
                            window.location.href = href;
                        }, minLoadTime);
                    }
                });
            });

            // Xử lý form submit
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function() {
                    resetLoaderPosition();
                    navigationLoader.style.background = 'white';
                    navigationLoader.style.display = 'flex';
                    navigationLoader.classList.remove('hidden');

                    setTimeout(function() {
                        navigationLoader.classList.add('hidden');
                    }, 5000);
                });
            });

            // Xử lý nút sản phẩm
            const openProductsBtn = document.getElementById('open-products-btn');
            if (openProductsBtn) {
                openProductsBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    resetLoaderPosition();
                    navigationLoader.style.background = 'white';
                    navigationLoader.style.display = 'flex';
                    navigationLoader.classList.remove('hidden');

                    setTimeout(function() {
                        window.location.href = '@Url.Action("Index", "Products")';
                    }, minLoadTime);
                });
            }

            // Xử lý search form
            const searchForm = document.getElementById('search-form');
            if (searchForm) {
                searchForm.addEventListener('submit', function(e) {
                    resetLoaderPosition();
                    navigationLoader.style.background = 'white';
                    navigationLoader.style.display = 'flex';
                    navigationLoader.classList.remove('hidden');
                });
            }
        });

        // Hàm để hiện/ẩn loader từ bất kỳ đâu
        window.showLoader = function() {
            const navigationLoader = document.getElementById('navigation-loader');
            if (navigationLoader) {
                navigationLoader.style.position = 'fixed';
                navigationLoader.style.top = '0';
                navigationLoader.style.left = '0';
                navigationLoader.style.background = 'white';
                navigationLoader.style.display = 'flex';
                navigationLoader.classList.remove('hidden');
            }
        };

        window.hideLoader = function() {
            const navigationLoader = document.getElementById('navigation-loader');
            if (navigationLoader) {
                navigationLoader.classList.add('hidden');
            }
        };
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>