@model WEBBANDIENTHOAI.Models.Product

<a href="@Url.Action("ProductDetails", "HomeUser", new { id = Model.ProductId })"
   class="block product-card">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden group hover:shadow-xl transition-all duration-500 hover-lift cursor-pointer h-full flex flex-col">
        <div class="relative overflow-hidden flex-1">
            @if (Model.PrimaryImage != null)
            {
                <img src="/images/default-product.png" 
                     data-src="@Url.Action("GetProductImage", "HomeUser", new { imageId = Model.PrimaryImage.ImageId })"
                     class="lazy w-full h-40 object-contain p-2 transition-transform duration-500 group-hover:scale-105 bg-white"
                     alt="@Model.Name" />
            }
            else
            {
                <img src="/images/default-product.png"
                     class="w-full h-40 object-contain p-2 transition-transform duration-500 group-hover:scale-105 bg-white"
                     alt="@Model.Name" />
            }

            @if (Model.Price < 5000000)
            {
                <div class="absolute top-3 left-3">
                    <span class="bg-gradient-to-r from-primary to-primary-dark text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                        GIÁ TỐT
                    </span>
                </div>
            }

            <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <button type="button"
                        class="wishlist-btn w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center hover:bg-gray-50 transition-colors"
                        onclick="event.preventDefault(); event.stopPropagation();">
                    <i class="fas fa-heart text-gray-600 text-sm"></i>
                </button>
            </div>
        </div>

        <div class="p-4 flex-1 flex flex-col">
            <h3 class="font-semibold text-gray-800 text-sm line-clamp-2 mb-2 leading-tight">@Model.Name</h3>

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="text-gray-500 text-xs line-clamp-2 mb-3 leading-relaxed flex-1">
                    @Model.ShortDescription
                </p>
            }

            <div class="mt-auto">
                <div class="flex items-center justify-between mt-4">
                    <div class="flex flex-col">
                        <span class="text-primary font-bold text-lg">
                            @String.Format("{0:N0}₫", Model.Price)
                        </span>
                        @if (Model.OldPrice > Model.Price)
                        {
                            <span class="text-gray-400 text-sm line-through">
                                @String.Format("{0:N0}₫", Model.OldPrice)
                            </span>
                        }
                    </div>

                    <form asp-controller="HomeCarts" asp-action="AddToCart" method="post"
                          class="add-to-cart-form"
                          data-product="@Model.ProductId"
                          onclick="event.stopPropagation();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <button type="submit"
                                class="w-10 h-10 bg-gradient-to-r from-primary to-primary-dark text-white rounded-xl flex items-center justify-center hover:shadow-lg transition-all duration-300 transform hover:scale-105 group/btn">
                            <i class="fas fa-shopping-cart text-sm group-hover/btn:scale-110 transition-transform"></i>
                        </button>
                    </form>
                </div>

                <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                    <div class="flex items-center space-x-1">
                        <div class="flex text-yellow-400">
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star-half-alt text-xs"></i>
                        </div>
                        <span class="text-gray-500 text-xs ml-1">(128)</span>
                    </div>
                    <span class="text-green-600 text-xs font-medium bg-green-50 px-2 py-1 rounded-full">
                        Còn hàng
                    </span>
                </div>
            </div>
        </div>
    </div>
</a>
