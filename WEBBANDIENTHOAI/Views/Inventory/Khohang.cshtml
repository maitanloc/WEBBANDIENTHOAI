@model IEnumerable<WEBBANDIENTHOAI.Models.Inventory>

@{
    ViewData["Title"] = "Quản lý kho hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalItems = ViewBag.TotalItems ?? 0;
    var lowStockItems = ViewBag.LowStockItems ?? 0;
    var searchTerm = ViewBag.SearchTerm as string;
    var isLowStockView = ViewBag.IsLowStockView as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
}

<div class="category-management">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Quản lý Kho hàng</h1>
                <p class="text-sm text-gray-500 mt-1">Quản lý tồn kho và theo dõi sản phẩm trong kho.</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    @if (!string.IsNullOrEmpty(searchTerm) || isLowStockView)
    {
        <div class="flex flex-wrap gap-4 mb-6">
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <div class="px-4 py-3 bg-white border border-gray-300 rounded text-sm text-gray-700">
                    Kết quả tìm kiếm: <span class="font-semibold">@searchTerm</span>
                    <a href="@Url.Action("Index")" class="ml-2 text-emerald-600 hover:underline">✕</a>
                </div>
            }
            @if (isLowStockView)
            {
                <div class="px-4 py-3 bg-white border border-gray-300 rounded text-sm text-gray-700">
                    Đang xem sản phẩm sắp hết hàng
                    <a href="@Url.Action("Index")" class="ml-2 text-emerald-600 hover:underline">✕</a>
                </div>
            }
        </div>
    }

    <!-- Filter Section -->
    <div class="bg-transparent p-0 mb-6">
        <form id="inventory-filter-form" class="flex flex-wrap gap-4 items-center">
            <div class="relative flex-1 min-w-[250px]">
                <span class="material-symbols-outlined absolute left-0 top-1/2 -translate-y-1/2 text-gray-400">search</span>
                <input name="searchTerm" value="@searchTerm" placeholder="Tìm tên sản phẩm, mã kho..." 
                       class="w-full pl-8 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 text-black" />
            </div>
            
            <div class="flex items-center gap-2">
                <a href="@Url.Action("LowStock")"
                   class="flex items-center gap-2 px-4 py-2 bg-red-100 hover:bg-red-200 text-red-700 rounded border border-red-300 text-xs font-bold uppercase transition-colors">
                    <span class="material-symbols-outlined text-sm">warning</span>
                    Sắp hết hàng
                </a>

                <button type="button" class="flex items-center gap-2 px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-700 rounded border border-amber-300 text-xs font-bold uppercase transition-colors" 
                        title="Nhập hàng">
                    <span class="material-symbols-outlined text-sm">login</span>
                    Nhập
                </button>

                <button type="button" class="flex items-center gap-2 px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded border border-blue-300 text-xs font-bold uppercase transition-colors"
                        title="Xuất hàng">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    Xuất
                </button>

                <button type="button" onclick="window.location.href = '@Url.Action("ExportExcel", "Kho")';"
                        class="flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-bold uppercase transition-colors">
                    <span class="material-symbols-outlined text-sm">download</span>
                    Excel
                </button>
            </div>
        </form>
    </div>

    <!-- Main Content -->
    <div class="bg-white border border-gray-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-300" id="inventoryTable">
                <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mã kho</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mã SKU</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Tên sản phẩm</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-center border-r border-gray-300">Hiện tại</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-center border-r border-gray-300">Tối thiểu</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-center border-r border-gray-300">Tối đa</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Vị trí</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Cập nhật lần cuối</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    @foreach (var item in Model)
                    {
                        <tr class="inventory-row border-b border-gray-300 hover:bg-gray-50 transition-colors @(item.CurrentQuantity <= item.MinimumQuantity ? "bg-red-50" : "")">
                            <td class="px-4 py-3 border-r border-gray-300">
                                <span class="font-bold text-black">#@item.InventoryId</span>
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">@item.StockCode</td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                @if (item.Product != null)
                                {
                                    <div class="font-bold text-black">@item.Product.Name</div>
                                    <div class="text-xs text-gray-500">@item.Product.SKU</div>
                                }
                                else
                                {
                                    <span class="text-gray-500 text-sm">Chưa có thông tin</span>
                                }
                                @if (item.CurrentQuantity <= item.MinimumQuantity)
                                {
                                    <span class="inline-block ml-2 px-2 py-1 text-xs font-bold bg-red-600 text-white rounded">CẢNH BÁO</span>
                                }
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300 text-black text-sm text-center font-semibold">@item.CurrentQuantity</td>
                            <td class="px-4 py-3 border-r border-gray-300 text-black text-sm text-center">@item.MinimumQuantity</td>
                            <td class="px-4 py-3 border-r border-gray-300 text-black text-sm text-center">@item.MaximumQuantity</td>
                            <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">@item.Location</td>
                            <td class="px-4 py-3 text-black text-sm">@item.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">inventory_2</span>
                                <p>Không tìm thấy dữ liệu kho hàng nào.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
