@model IEnumerable<WEBBANDIENTHOAI.ViewModels.ProductListItemVm>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";   // dùng layout chính bạn đã cung cấp
    ViewData["Title"] = "Danh sách sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="page-products">
    <div class="container mx-auto px-4 py-6">
        @* Nếu bạn có partial _ProductsIndexPartial, render nó *@
        @await Html.PartialAsync("_ProductsIndexPartial", Model)
    </div>
</div>

@section Scripts {
    @* Nếu cần script riêng cho trang sản phẩm *@
    <script src="~/js/products.js"></script>
}
