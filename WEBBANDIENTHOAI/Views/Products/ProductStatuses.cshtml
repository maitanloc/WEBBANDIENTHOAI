@model IEnumerable<WEBBANDIENTHOAI.Models.ProductStatus>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý Trạng thái Sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ProductStatuses.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
}

<div class="status-management">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Trạng thái Sản phẩm</h1>
                <p class="text-sm text-gray-500 mt-1">Quản lý và phân loại các trạng thái cho sản phẩm của bạn.</p>
            </div>
            
            <div class="flex items-center gap-3">
                <div class="relative group">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-emerald-500 transition-colors">search</span>
                    <input type="text" id="searchInput" 
                           class="w-full md:w-64 pl-10 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 transition-all text-black"
                           placeholder="Tìm kiếm trạng thái..." />
                </div>
                
                <button type="button"
                        class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold text-sm transition-all"
                        data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="material-symbols-outlined text-sm">add</span>
                    Thêm mới
                </button>
            </div>
        </div>
    </div>



    <!-- Main Content -->
    <div class="bg-white border border-gray-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-300" id="statusesTable">
                <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider w-12 text-center border-r border-gray-300">
                            <input class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-gray-400 cursor-pointer" type="checkbox" id="selectAll" />
                        </th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Tên trạng thái</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mô tả</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-center border-r border-gray-300">Số sản phẩm</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    @foreach (var item in Model)
                    {
                        <tr class="status-row border-b border-gray-300 hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3 text-center border-r border-gray-300">
                                <input class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-gray-400 cursor-pointer status-checkbox" type="checkbox" value="@item.StatusId" />
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <span class="font-bold text-black">@item.StatusName</span>
                            </td>
                            <td class="px-4 py-3 text-black text-sm max-w-xs truncate border-r border-gray-300">
                                @(item.Description ?? "Không có mô tả")
                            </td>
                            <td class="px-4 py-3 text-center border-r border-gray-300 text-black font-medium">
                                @(item.Products?.Count ?? 0)
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="p-1 px-2 text-amber-700 bg-amber-100 hover:bg-amber-200 border border-amber-300 rounded text-xs font-bold uppercase transition-colors"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-id="@item.StatusId"
                                            data-name="@item.StatusName"
                                            data-desc="@item.Description"
                                            title="Sửa">
                                        Sửa
                                    </button>
                                    <button class="p-1 px-2 text-red-700 bg-red-100 hover:bg-red-200 border border-red-300 rounded text-xs font-bold uppercase transition-colors"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-id="@item.StatusId"
                                            data-name="@item.StatusName"
                                            title="Xóa">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">inventory_2</span>
                                <p>Chưa có trạng thái nào được tạo.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modals (Refined for rounded-2xl and consistency) -->
    <!-- Modal Thêm -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-2xl shadow-xl">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h5 class="text-lg font-bold text-gray-900">Thêm Trạng thái</h5>
                    <button type="button" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" data-bs-dismiss="modal">
                        <span class="material-symbols-outlined text-gray-400">close</span>
                    </button>
                </div>
                <form asp-action="CreateStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <div class="p-6 space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Tên trạng thái <span class="text-red-500">*</span></label>
                            <input type="text" name="StatusName" class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all placeholder-gray-300"
                                   placeholder="Ví dụ: Đang bán, Hết hàng..." required maxlength="30" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Mô tả</label>
                            <textarea name="Description" class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all placeholder-gray-300 min-h-[100px]"
                                      placeholder="Mô tả ngắn gọn về trạng thái này..." maxlength="150"></textarea>
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-gray-50 rounded-b-2xl flex justify-end gap-3">
                        <button type="button" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-orange-500 hover:bg-orange-600 rounded-xl shadow-sm transition-colors">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Sửa -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-2xl shadow-xl">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h5 class="text-lg font-bold text-gray-900">Sửa Trạng thái</h5>
                    <button type="button" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" data-bs-dismiss="modal">
                        <span class="material-symbols-outlined text-gray-400">close</span>
                    </button>
                </div>
                <form asp-action="EditStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StatusId" id="editStatusId" />
                    <div class="p-6 space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Tên trạng thái <span class="text-red-500">*</span></label>
                            <input type="text" id="editStatusName" name="StatusName" class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
                                   placeholder="Tên trạng thái" required maxlength="30" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Mô tả</label>
                            <textarea id="editDescription" name="Description" class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all min-h-[100px]"
                                      placeholder="Mô tả..." maxlength="150"></textarea>
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-gray-50 rounded-b-2xl flex justify-end gap-3">
                        <button type="button" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-colors">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Xóa -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 rounded-2xl shadow-xl">
                <form asp-action="DeleteStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteStatusId" />
                    <div class="p-8 text-center">
                        <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="material-symbols-outlined text-3xl">delete_forever</span>
                        </div>
                        <h5 class="text-xl font-bold text-gray-900 mb-2">Xóa trạng thái?</h5>
                        <p class="text-sm text-gray-500">Bạn có chắc chắn muốn xóa "<span id="deleteStatusName" class="font-bold text-gray-900"></span>"? Hành động này không thể hoàn tác.</p>
                        <p class="text-xs text-red-500 mt-3 p-2 bg-red-50 rounded-lg">Không thể xóa nếu trạng thái đang có sản phẩm.</p>
                    </div>
                    <div class="px-6 py-4 bg-gray-50 rounded-b-2xl flex justify-center gap-3">
                        <button type="button" class="flex-1 px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="flex-1 px-4 py-2 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-sm transition-colors">Xóa ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
    <!-- Bootstrap & jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <script>
            // Xử lý modal sửa - tự động điền thông tin khi nhấn nút sửa
            $('#editModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');
                var desc = button.data('desc');

                var modal = $(this);
                modal.find('#editStatusId').val(id);
                modal.find('#editStatusName').val(name);
                modal.find('#editDescription').val(desc || '');
            });

            // Xử lý modal xóa
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');

                var modal = $(this);
                modal.find('#deleteStatusId').val(id);
                modal.find('#deleteStatusName').text(name);
            });

            // Tìm kiếm trạng thái
            $('#searchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('.status-row').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Chọn tất cả
            $('#selectAll').click(function() {
                $('.status-checkbox').prop('checked', this.checked);
            });

            // Reset form khi đóng modal thêm
            $('#createModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
            });

            // Tự động ẩn thông báo sau 5 giây
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        </script>
    }
