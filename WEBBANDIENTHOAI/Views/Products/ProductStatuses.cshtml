@model IEnumerable<WEBBANDIENTHOAI.Models.ProductStatus>

@{
    ViewData["Title"] = "Quản lý Trạng thái Sản phẩm";
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/ProductStatuses.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="status-management bg-gray-50 dark:bg-gray-900">
    <div class="flex h-screen">
        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col overflow-y-auto">
            <div class="status-header sticky top-0 z-10">
                <header class="h-16 flex items-center justify-between px-8 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-xl font-bold text-orange-500 dark:text-orange-400">
                        Quản lý Trạng thái Sản phẩm
                    </h2>

                    <div class="flex items-center space-x-4">
                        <div class="relative">
                            <span class="material-icons-outlined absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">search</span>
                            <input class="search-input pl-10 pr-4 py-2 text-sm w-64 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500/80 transition dark:placeholder-gray-500"
                                   placeholder="Tìm kiếm trạng thái..." type="text" id="searchInput" />
                        </div>
                        <button type="button"
                                class="btn-primary-custom flex items-center justify-center px-4 py-2 font-semibold rounded-lg text-sm transition-opacity focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 dark:focus:ring-offset-gray-900"
                                data-bs-toggle="modal" data-bs-target="#createModal">
                            <span class="material-icons-outlined text-base mr-2">add</span>
                            Thêm Trạng thái
                        </button>
                    </div>
                </header>
            </div>

            <div class="p-8">
                <!-- Hiển thị thông báo -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-4">
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        @TempData["Error"]
                    </div>
                }

                <div class="status-table overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left" id="statusesTable">
                            <thead>
                                <tr>
                                    <th class="w-12 text-center font-medium" scope="col">
                                        <input class="checkbox-custom" type="checkbox" id="selectAll" />
                                    </th>
                                    <th class="font-medium" scope="col">Tên trạng thái</th>
                                    <th class="font-medium" scope="col">Mô tả</th>
                                    <th class="font-medium text-center" scope="col">Số sản phẩm</th>
                                    <th class="font-medium" scope="col">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="border-b dark:border-gray-700 status-row">
                                        <td class="w-12 text-center">
                                            <input class="checkbox-custom status-checkbox" type="checkbox" value="@item.StatusId" />
                                        </td>
                                        <td class="font-semibold text-gray-800 dark:text-gray-100">@item.StatusName</td>
                                        <td class="text-gray-600 dark:text-gray-300">@(item.Description ?? "Không có mô tả")</td>
                                        <td class="text-gray-600 dark:text-gray-300 text-center">@(item.Products?.Count ?? 0)</td>
                                        <td>
                                            <div class="flex items-center space-x-2">
                                                <button class="action-btn edit-btn"
                                                        data-bs-toggle="modal" data-bs-target="#editModal"
                                                        data-id="@item.StatusId"
                                                        data-name="@item.StatusName"
                                                        data-desc="@item.Description">
                                                    <span class="material-icons-outlined text-lg">edit</span>
                                                </button>
                                                <button class="action-btn delete-btn"
                                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                        data-id="@item.StatusId"
                                                        data-name="@item.StatusName">
                                                    <span class="material-icons-outlined text-lg">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Thêm -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content modal-content-custom">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">Thêm Trạng thái Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="modal-label" for="createStatusName">Tên trạng thái <span class="text-red-500">*</span></label>
                            <input type="text" id="createStatusName" name="StatusName" class="modal-input"
                                   placeholder="Nhập tên trạng thái" required maxlength="30" />
                        </div>
                        <div class="form-group">
                            <label class="modal-label" for="createDescription">Mô tả</label>
                            <textarea id="createDescription" name="Description" class="modal-input modal-textarea"
                                      placeholder="Nhập mô tả cho trạng thái" maxlength="150"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="modal-btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="modal-btn-primary">Thêm Trạng thái</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Sửa -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content modal-content-custom">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Sửa Trạng thái</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="StatusId" id="editStatusId" />
                        <div class="form-group">
                            <label class="modal-label" for="editStatusName">Tên trạng thái <span class="text-red-500">*</span></label>
                            <input type="text" id="editStatusName" name="StatusName" class="modal-input"
                                   placeholder="Nhập tên trạng thái" required maxlength="30" />
                        </div>
                        <div class="form-group">
                            <label class="modal-label" for="editDescription">Mô tả</label>
                            <textarea id="editDescription" name="Description" class="modal-input modal-textarea"
                                      placeholder="Nhập mô tả cho trạng thái" maxlength="150"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="modal-btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="modal-btn-primary">Cập nhật Trạng thái</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Xóa -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content modal-content-custom">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Xóa Trạng thái</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="DeleteStatus" asp-controller="ProductStatuses" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="id" id="deleteStatusId" />
                        <p class="text-gray-700 dark:text-gray-300 mb-3">Bạn có chắc chắn muốn xóa trạng thái "<span id="deleteStatusName" class="font-semibold"></span>"?</p>
                        <p class="text-red-500 text-sm">Lưu ý: Không thể xóa nếu trạng thái đang có sản phẩm.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="modal-btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="modal-btn-danger">Xóa Trạng thái</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap & jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Xử lý modal sửa - tự động điền thông tin khi nhấn nút sửa
        $('#editModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            var name = button.data('name');
            var desc = button.data('desc');

            var modal = $(this);
            modal.find('#editStatusId').val(id);
            modal.find('#editStatusName').val(name);
            modal.find('#editDescription').val(desc || '');
        });

        // Xử lý modal xóa
        $('#deleteModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            var name = button.data('name');

            var modal = $(this);
            modal.find('#deleteStatusId').val(id);
            modal.find('#deleteStatusName').text(name);
        });

        // Tìm kiếm trạng thái
        $('#searchInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.status-row').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        // Chọn tất cả
        $('#selectAll').click(function() {
            $('.status-checkbox').prop('checked', this.checked);
        });

        // Reset form khi đóng modal thêm
        $('#createModal').on('hidden.bs.modal', function () {
            $(this).find('form')[0].reset();
        });

        // Tự động ẩn thông báo sau 5 giây
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
</body>
</html>