@model IEnumerable<WEBBANDIENTHOAI.ViewModels.ProductListItemVm>

<!-- Header Section -->
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Danh sách Sản phẩm</h1>
            <p class="text-sm text-gray-500 mt-1">Quản lý kho hàng và thông tin chi tiết các sản phẩm.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Create", "Products")" 
               class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
                Thêm sản phẩm
            </a>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="bg-transparent p-0 mb-6">
    <form id="product-filter-form" class="flex flex-wrap gap-6 items-center">
        <div class="relative flex-1 min-w-[300px]">
            <span class="material-symbols-outlined absolute left-0 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            <input name="search" placeholder="Tìm tên, SKU, mã kho..." 
                   class="w-full pl-8 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 text-black" />
        </div>
        <select name="statusId" class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black focus:outline-none focus:border-emerald-500">
            <option value="">Tất cả trạng thái</option>
            <option value="1">Còn hàng</option>
        </select>
        <div class="flex items-center gap-2">
            <input name="priceMin" type="number" placeholder="Giá từ" 
                   class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black w-24 focus:outline-none focus:border-emerald-500" />
            <span class="text-gray-400">-</span>
            <input name="priceMax" type="number" placeholder="Đến" 
                   class="bg-transparent border-b border-gray-300 px-2 py-2 text-sm text-black w-24 focus:outline-none focus:border-emerald-500" />
        </div>
        <button id="filter-apply" type="submit" class="px-6 py-2 bg-gray-800 text-white rounded text-xs font-bold hover:bg-black transition-colors tracking-widest">
            ÁP DỤNG LỌC
        </button>
    </form>
</div>

<!-- Main Content -->
<div class="bg-white border border-gray-300">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse border border-gray-300" id="productsTable">
            <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider w-20 text-center border-r border-gray-300">Ảnh</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Tên Sản phẩm</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">SKU</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Giá bán</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mã kho</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Trạng thái</th>
                    <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-300">
                @foreach(var item in Model)
                {
                    <tr class="product-row border-b border-gray-300 hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-center border-r border-gray-300">
                            @if (item.PrimaryImageId != null)
                            {
                                <img src="@Url.Action("Image","Products", new { id = item.PrimaryImageId })" 
                                     class="w-12 h-12 object-cover border border-gray-200" 
                                     alt="@item.Name" />
                            }
                            else
                            {
                                <div class="w-12 h-12 bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-400">
                                    <span class="material-symbols-outlined text-sm">image</span>
                                </div>
                            }
                        </td>
                        <td class="px-4 py-3 border-r border-gray-300">
                            <span class="font-bold text-black">@item.Name</span>
                        </td>
                        <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">@item.SKU</td>
                        <td class="px-4 py-3 border-r border-gray-300 text-black font-bold">
                            @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.Price)
                        </td>
                        <td class="px-4 py-3 border-r border-gray-300 text-black text-sm">@item.StockCode</td>
                        <td class="px-4 py-3 border-r border-gray-300">
                            <span class="text-sm font-medium text-black">@item.StatusName</span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="@Url.Action("Details", "Products", new { id = item.ProductId })" 
                                   class="p-1 px-2 text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded text-xs font-bold uppercase transition-colors">
                                    Xem
                                </a>
                                @if (item.IsEditable)
                                {
                                    <a href="@Url.Action("Edit", "Products", new { id = item.ProductId })" 
                                       class="p-1 px-2 text-amber-700 bg-amber-100 hover:bg-amber-200 border border-amber-300 rounded text-xs font-bold uppercase transition-colors">
                                        Sửa
                                    </a>
                                }
                                else
                                {
                                    <span class="p-1 px-2 bg-gray-100 text-gray-400 border border-gray-200 rounded text-xs font-bold uppercase cursor-not-allowed" 
                                          title="Sản phẩm đã có tồn kho hoặc lịch sử - không thể sửa">
                                        Khóa
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="px-4 py-12 text-center text-gray-500">
                            <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">inventory_2</span>
                            <p>Không tìm thấy sản phẩm nào.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Section -->
    @{
        var totalCount = (int)(ViewData["TotalCount"] ?? 0);
        var pageSize = 20; // Matches controller default
        var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
        var currentPage = Context.Request.Query.ContainsKey("page") ? int.Parse(Context.Request.Query["page"]) : 1;
    }

    @if (totalPages > 1)
    {
        <div class="mt-8 flex justify-center items-center gap-4 py-4 border-t border-gray-200">
            @if (currentPage > 1)
            {
                <button type="button" onclick="loadProducts(@(currentPage - 1))"
                        class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                    Trước
                </button>
            }

            <div class="flex items-center gap-1">
                <span class="text-lg font-black text-gray-900">@currentPage</span>
                <span class="text-sm font-bold text-gray-400">/</span>
                <span class="text-sm font-bold text-gray-400">@totalPages</span>
            </div>

            @if (currentPage < totalPages)
            {
                <button type="button" onclick="loadProducts(@(currentPage + 1))"
                        class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-black text-xs font-bold uppercase tracking-widest hover:bg-gray-900 hover:text-white transition-all duration-300">
                    Sau
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>
            }
        </div>
    }
</div>