@model WEBBANDIENTHOAI.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
}

<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
    <div class="layout-container flex h-full grow flex-col">

        <main class="flex-1 w-full max-w-7xl mx-auto px-4 lg:px-10 py-8 lg:py-12">
            <!-- THAY ĐỔI FORM ACTION THÀNH PREVIEW -->
            <form asp-action="Preview" method="post" id="checkout-form">
                @Html.AntiForgeryToken()

                <!-- Hidden fields for selected items -->
                @for (int i = 0; i < Model.SelectedItems.Count; i++)
                {
                    <input type="hidden" name="SelectedItems[@i].ProductId" value="@Model.SelectedItems[i].ProductId" />
                    <input type="hidden" name="SelectedItems[@i].Quantity" value="@Model.SelectedItems[i].Quantity" />
                    <input type="hidden" name="SelectedItems[@i].Price" value="@Model.SelectedItems[i].Price" />
                    <input type="hidden" name="SelectedItems[@i].ProductName" value="@Model.SelectedItems[i].ProductName" />
                }
                <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />
                <input type="hidden" name="PaymentMethod" id="payment-method-hidden" value="COD" />

                <div class="flex flex-col lg:flex-row lg:space-x-12">
                    <!-- Left Column -->
                    <div class="w-full lg:w-3/5">
                        <div class="flex flex-wrap gap-2 pb-6">
                            <a class="text-primary/80 dark:text-primary/70 text-sm font-medium">Giỏ hàng</a>
                            <span class="text-primary/80 dark:text-primary/70 text-sm font-medium">/</span>
                            <span class="text-[#1c140d] dark:text-white text-sm font-medium">Thanh toán</span>
                            <span class="text-gray-400 dark:text-gray-500 text-sm font-medium">/</span>
                            <span class="text-gray-400 dark:text-gray-500 text-sm font-medium">Hoàn tất</span>
                        </div>

                        <div class="space-y-8">
                            <!-- Contact Information -->
                            <div>
                                <h2 class="text-[#1c140d] dark:text-white text-[22px] font-bold pb-3">Thông tin liên hệ</h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <label class="flex flex-col">
                                        <p class="text-[#1c140d] dark:text-gray-300 pb-2">Email</p>
                                        <input type="email" name="Email" class="form-input rounded-lg border bg-background-light dark:bg-gray-800 h-12 px-4"
                                               value="@Model.Email" required />
                                        <span class="text-red-500 text-sm mt-1" asp-validation-for="Email"></span>
                                    </label>

                                    <label class="flex flex-col">
                                        <p class="text-[#1c140d] dark:text-gray-300 pb-2">Số điện thoại</p>
                                        <input type="tel" name="Phone" class="form-input rounded-lg border bg-background-light dark:bg-gray-800 h-12 px-4"
                                               value="@Model.Phone" placeholder="Nhập số điện thoại" required />
                                        <span class="text-red-500 text-sm mt-1" asp-validation-for="Phone"></span>
                                    </label>
                                </div>
                            </div>

                            <!-- Shipping Information -->
                            <div>
                                <h2 class="text-[#1c140d] dark:text-white text-[22px] font-bold pb-3">Thông tin nhận hàng</h2>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <label class="flex flex-col col-span-2">
                                        <p class="text-[#1c140d] dark:text-gray-300 pb-2">Họ và tên người nhận</p>
                                        <input type="text" name="FullName" class="form-input rounded-lg border bg-background-light dark:bg-gray-800 h-12 px-4"
                                               value="@Model.FullName" placeholder="Nguyễn Văn A" required />
                                        <span class="text-red-500 text-sm mt-1" asp-validation-for="FullName"></span>
                                    </label>

                                    <label class="flex flex-col col-span-2 relative relative-container z-20">
                                        <p class="text-[#1c140d] dark:text-gray-300 pb-2">Địa chỉ</p>
                                        <input type="text" name="Address" id="Address" class="form-input rounded-lg border bg-background-light dark:bg-gray-800 h-12 px-4 focus:ring-primary focus:border-primary"
                                               value="@Model.Address" placeholder="Tìm kiếm địa chỉ của bạn..." required autocomplete="off" />
                                        <ul id="address-suggestions" class="absolute top-[80px] left-0 right-0 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-xl z-50 hidden max-h-60 overflow-y-auto w-full"></ul>
                                        <!-- Map Instance -->
                                        <div id="map-container" class="w-full h-64 mt-3 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm z-10"></div>
                                        
                                        <span class="text-red-500 text-sm mt-1" asp-validation-for="Address"></span>
                                        
                                        <!-- Hidden LatLng Form Data -->
                                        <input type="hidden" name="Latitude" id="Latitude" value="@Model.Latitude" />
                                        <input type="hidden" name="Longitude" id="Longitude" value="@Model.Longitude" />
                                    </label>

                                    <label class="flex flex-col col-span-2">
                                        <p class="text-[#1c140d] dark:text-gray-300 pb-2">Ghi chú</p>
                                        <textarea name="Notes" class="form-textarea rounded-lg border bg-background-light dark:bg-gray-800 p-4"
                                                  placeholder="Ghi chú về đơn hàng..."></textarea>
                                    </label>
                                </div>
                            </div>

                            <!-- Payment Method -->
                            <div>
                                <h2 class="text-[#1c140d] dark:text-white text-[22px] font-bold pb-3">Phương thức thanh toán</h2>

                                <div class="space-y-3">
                                    <label class="flex items-center p-4 rounded-lg border-2 border-primary bg-primary/10 cursor-pointer payment-option">
                                        <input type="radio" name="payment-method-radio" value="COD" checked class="form-radio h-5 w-5 text-primary" />
                                        <span class="ml-4 flex-1">Thanh toán khi nhận hàng (COD)</span>
                                        <span class="material-symbols-outlined text-2xl">local_shipping</span>
                                    </label>

                                    <label class="flex items-center p-4 rounded-lg border bg-background-light dark:bg-gray-800 cursor-pointer payment-option">
                                        <input type="radio" name="payment-method-radio" value="BankTransfer" class="form-radio h-5 w-5 text-primary" />
                                        <span class="ml-4 flex-1">Chuyển khoản qua ngân hàng (QR)</span>
                                        <span class="material-symbols-outlined text-2xl">qr_code_2</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="w-full lg:w-2/5 mt-10 lg:mt-0">
                        <div class="sticky top-28 space-y-6">
                            <div class="border rounded-xl p-6 bg-white dark:bg-background-dark shadow-sm">
                                <h2 class="text-xl font-bold mb-4">Tóm tắt đơn hàng</h2>

                                <div class="space-y-4">
                                    @foreach (var item in Model.SelectedItems)
                                    {
                                        <div class="flex items-center space-x-4">
                                            <div class="relative">
                                                <img class="w-20 h-20 rounded-lg object-cover border"
                                                     src="@item.ProductImage" alt="@item.ProductName" />
                                                <span class="absolute -top-2 -right-2 bg-primary text-white text-xs font-semibold w-6 h-6 flex items-center justify-center rounded-full">@item.Quantity</span>
                                            </div>

                                            <div class="flex-1">
                                                <p class="font-semibold">@item.ProductName</p>
                                                <p class="text-sm text-[#9c7349]">Số lượng: @item.Quantity</p>
                                            </div>

                                            <p class="font-semibold text-base">@((item.Price * item.Quantity).ToString("N0"))₫</p>
                                        </div>
                                    }
                                </div>

                                <div class="border-t my-5"></div>

                                <div class="space-y-2">
                                    <div class="flex justify-between items-center">
                                        <p class="text-[#9c7349]">Tạm tính</p>
                                        <p class="font-medium">@Model.TotalAmount.ToString("N0")₫</p>
                                    </div>

                                    <div class="flex justify-between items-center">
                                        <p class="text-[#9c7349]">Phí vận chuyển</p>
                                        <p class="font-medium">Miễn phí</p>
                                    </div>
                                </div>

                                <div class="border-t my-5"></div>

                                <div class="flex justify-between items-center">
                                    <p class="text-lg font-semibold">Tổng cộng</p>
                                    <p class="text-2xl font-bold text-primary">@Model.TotalAmount.ToString("N0")₫</p>
                                </div>
                            </div>

                            <button type="button" id="place-order-btn" class="w-full bg-primary text-white text-lg font-semibold rounded-lg h-14 shadow-lg hover:bg-orange-600 transition-colors">
                                Đặt Đơn Hàng
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- Payment Method UI Handling ---
            const paymentRadios = document.querySelectorAll('input[name="payment-method-radio"]');
            const hiddenPaymentInput = document.getElementById('payment-method-hidden');

            paymentRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    hiddenPaymentInput.value = this.value;

                    document.querySelectorAll('.payment-option').forEach(option => {
                        option.classList.remove('border-2', 'border-primary', 'bg-primary/10');
                        option.classList.add('border', 'bg-background-light', 'dark:bg-gray-800');
                    });

                    if (this.checked) {
                        const parent = this.closest('.payment-option');
                        parent.classList.add('border-2', 'border-primary', 'bg-primary/10');
                        parent.classList.remove('border', 'bg-background-light', 'dark:bg-gray-800');
                    }
                });
            });

            // --- Order Placement Handling ---
            const placeOrderBtn = document.getElementById('place-order-btn');
            const checkoutForm = document.getElementById('checkout-form');

            placeOrderBtn.addEventListener('click', function (event) {
                event.preventDefault(); // Prevent default button action

                // Basic form validation check
                if (!checkoutForm.checkValidity()) {
                    checkoutForm.reportValidity();
                    return;
                }

                const selectedPaymentMethod = document.querySelector('input[name="payment-method-radio"]:checked').value;
                
                // Set the hidden input value right before deciding the action
                hiddenPaymentInput.value = selectedPaymentMethod;

                if (selectedPaymentMethod === 'BankTransfer') {
                    // --- VNPay Flow ---
                    this.disabled = true;
                    this.textContent = 'Đang xử lý...';

                    const formData = new FormData(checkoutForm);

                    fetch('/ThanhToan/CreateVnpayPayment', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.paymentUrl) {
                            window.location.href = data.paymentUrl;
                        } else {
                            alert('Có lỗi xảy ra khi tạo thanh toán. ' + (data.message || 'Vui lòng thử lại.'));
                            this.disabled = false;
                            this.textContent = 'Đặt Đơn Hàng';
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Đã xảy ra lỗi kết nối. Vui lòng kiểm tra lại đường truyền và thử lại.');
                        this.disabled = false;
                        this.textContent = 'Đặt Đơn Hàng';
                    });

                } else {
                    // --- COD Flow (or other standard methods) ---
                    checkoutForm.submit();
                }
            });

            // Initialize UI state on page load
            const checkedRadio = document.querySelector('input[name="payment-method-radio"]:checked');
            if (checkedRadio) {
                checkedRadio.dispatchEvent(new Event('change'));
            }

            // --- Initialize Map & Autocomplete ---
            if (typeof MapAddressIntegration !== 'undefined') {
                new MapAddressIntegration({
                    mapId: 'map-container',
                    inputId: 'Address',
                    latId: 'Latitude',
                    lngId: 'Longitude',
                    suggestionsId: 'address-suggestions'
                });
            }
        });
    </script>
}