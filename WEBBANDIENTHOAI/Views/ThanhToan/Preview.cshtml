@model WEBBANDIENTHOAI.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Xác Nhận Đơn Hàng";
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
}

<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
    <div class="layout-container flex h-full grow flex-col">

        <main class="flex-1 w-full max-w-4xl mx-auto px-4 lg:px-8 py-8 lg:py-12">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white">Xác Nhận Đơn Hàng</h1>
                <p class="text-gray-600 dark:text-gray-300 mt-2">Vui lòng kiểm tra kỹ thông tin trước khi xác nhận</p>
            </div>

            <!-- Error Message -->
            <div id="error-message" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4"></div>

            <!-- Bill Container -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
                <!-- Bill Header -->
                <div class="bg-primary text-white rounded-t-xl p-6">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-2xl font-bold">HÓA ĐƠN ĐẶT HÀNG</h2>
                            <p class="text-primary-100">Thông tin đơn hàng của bạn</p>
                        </div>
                        <div class="text-right">
                            <p class="text-lg font-semibold">Mã Đơn: #PREVIEW</p>
                            <p class="text-primary-100">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>

                <!-- Customer Information -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Thông Tin Khách Hàng</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Họ tên</p>
                            <p class="font-semibold">@Model.FullName</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Email</p>
                            <p class="font-semibold">@Model.Email</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Số điện thoại</p>
                            <p class="font-semibold">@Model.Phone</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Địa chỉ giao hàng</p>
                            <p class="font-semibold">@Model.Address</p>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Sản Phẩm Đã Chọn</h3>
                    <div class="space-y-4">
                        @foreach (var item in Model.SelectedItems)
                        {
                            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                                <div class="flex items-center space-x-4">
                                    <img src="@item.ProductImage" alt="@item.ProductName"
                                         class="w-16 h-16 object-cover rounded-lg border">
                                    <div>
                                        <p class="font-semibold text-gray-800 dark:text-white">@item.ProductName</p>
                                        @if (!string.IsNullOrEmpty(item.SelectedOptionsDisplay))
                                        {
                                            <p class="text-xs text-orange-600 mt-0.5">@item.SelectedOptionsDisplay</p>
                                        }
                                        <p class="text-sm text-gray-600 dark:text-gray-400">Số lượng: @item.Quantity</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-semibold text-gray-800 dark:text-white">@(((item.Price + item.OptionsPrice) * item.Quantity).ToString("N0"))₫</p>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">@((item.Price + item.OptionsPrice).ToString("N0"))₫ x @item.Quantity</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Payment & Total -->
                <div class="p-6">
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-gray-600 dark:text-gray-400">Phương thức thanh toán:</span>
                        <span class="font-semibold">
                            @(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản ngân hàng")
                        </span>
                    </div>
                    
                    <div class="space-y-2 mb-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between items-center text-gray-600 dark:text-gray-400">
                            <span>Tạm tính:</span>
                            <span>@Model.TotalAmount.ToString("N0")₫</span>
                        </div>
                        @if (Model.VoucherDiscount > 0)
                        {
                            <div class="flex justify-between items-center text-green-600">
                                <span>Voucher (@Model.AppliedVoucherCode):</span>
                                <span>-@Model.VoucherDiscount.ToString("N0")₫</span>
                            </div>
                        }
                        @if (Model.PointsDiscount > 0)
                        {
                            <div class="flex justify-between items-center text-green-600">
                                <span>Dùng @Model.PointsUsed F-Point:</span>
                                <span>-@Model.PointsDiscount.ToString("N0")₫</span>
                            </div>
                        }
                    </div>

                    <div class="flex justify-between items-center text-lg font-semibold border-t pt-4">
                        <span class="text-gray-800 dark:text-white">Tổng cộng:</span>
                        <span class="text-2xl text-primary">@Math.Max(0, Model.FinalAmount).ToString("N0")₫</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
                <form id="process-form" asp-action="ProcessOrder" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        Xác Nhận Đặt Hàng
                    </button>
                </form>

                <form asp-action="CancelOrder" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center"
                            onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')">
                        <i class="fas fa-times-circle mr-2"></i>
                        Hủy Đơn Hàng
                    </button>
                </form>

                <a href="@Url.Action("Index", "HomeCarts")"
                   class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center">
                    <i class="fas fa-edit mr-2"></i>
                    Chỉnh Sửa Giỏ Hàng
                </a>
            </div>

            <!-- Warning Message -->
            <div class="mt-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-triangle text-yellow-500 mr-3"></i>
                    <div>
                        <p class="text-yellow-800 dark:text-yellow-200 font-semibold">Lưu ý quan trọng</p>
                        <p class="text-yellow-700 dark:text-yellow-300 text-sm mt-1">
                            Vui lòng kiểm tra kỹ thông tin đơn hàng trước khi xác nhận.
                            Sau khi xác nhận, đơn hàng sẽ được xử lý và không thể hủy bỏ.
                        </p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('process-form').addEventListener('submit', function(e) {
            e.preventDefault();
            var errorDiv = document.getElementById('error-message');
            errorDiv.classList.add('hidden');

            var formData = new FormData(this);

            fetch(this.action, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl;
                } else {
                    errorDiv.textContent = data.message;
                    errorDiv.classList.remove('hidden');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                errorDiv.textContent = 'Có lỗi xảy ra. Vui lòng thử lại.';
                errorDiv.classList.remove('hidden');
            });
        });
    </script>
}