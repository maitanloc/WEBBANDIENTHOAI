@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layoutuser.cshtml";
}

<div class="container mx-auto px-4 py-16 text-center">
    <div class="max-w-md mx-auto">
        <div class="text-green-500 text-6xl mb-6">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-4">Đặt hàng thành công!</h1>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
            Cảm ơn bạn đã mua hàng. Đơn hàng <strong>#@ViewBag.OrderId</strong> của bạn đã được tiếp nhận.
        </p>
        <p class="text-gray-500 dark:text-gray-400 mb-8">
            Chúng tôi sẽ liên hệ với bạn trong thời gian sớm nhất để xác nhận đơn hàng.
        </p>
        <div class="flex gap-4 justify-center">
            <a asp-controller="HomeUser" asp-action="Index"
               class="px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-orange-600 transition-colors">
                Tiếp tục mua sắm
            </a>
            <a href="#"
               class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors">
                Theo dõi đơn hàng
            </a>
        </div>
    </div>
</div>