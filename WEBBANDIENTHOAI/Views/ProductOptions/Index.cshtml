@model IEnumerable<WEBBANDIENTHOAI.Models.ProductOption>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý Cấu hình Sản phẩm";
}

<div class="product-options-management p-4 md:p-6 lg:p-8">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Quản lý Cấu hình</h1>
                <p class="text-sm text-gray-500 mt-1">Quản lý các tùy chọn phiên bản (màu sắc, RAM, bộ nhớ, vv) cho sản phẩm.</p>
            </div>
            
            <div class="flex items-center gap-3">
                <form method="get" asp-action="Index" class="flex gap-2 items-center flex-wrap">
                    <div class="relative group min-w-[200px]">
                        <select name="productId" class="w-full md:w-64 pl-4 pr-10 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 transition-all text-black appearance-none" onchange="this.form.submit()">
                            <option value="">-- Lọc theo sản phẩm --</option>
                            @foreach (var item in ViewBag.Products as SelectList)
                            {
                                if (item.Value == ViewBag.SelectedProductId?.ToString())
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                    </div>
                    
                    <div class="relative group min-w-[180px]">
                        <select name="groupName" class="w-full md:w-48 pl-4 pr-10 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 transition-all text-black appearance-none" onchange="this.form.submit()">
                            <option value="">-- Nhóm tùy chọn --</option>
                            <!option value="Màu sắc" @(ViewBag.SelectedGroupName?.ToString() == "Màu sắc" ? "selected" : "")>Màu sắc</!option>
                            <!option value="RAM" @(ViewBag.SelectedGroupName?.ToString() == "RAM" ? "selected" : "")>RAM</!option>
                            <!option value="Bộ nhớ trong" @(ViewBag.SelectedGroupName?.ToString() == "Bộ nhớ trong" ? "selected" : "")>Bộ nhớ trong</!option>
                            <!option value="Tùy chọn khác" @(ViewBag.SelectedGroupName?.ToString() == "Tùy chọn khác" ? "selected" : "")>Tùy chọn khác</!option>
                        </select>
                        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                    </div>

                    @if (ViewBag.SelectedProductId != null || ViewBag.SelectedGroupName != null)
                    {
                        <a href="@Url.Action("Index")" class="text-xs text-red-500 hover:text-red-700 underline whitespace-nowrap">Xóa lọc</a>
                    }
                </form>
                
                <a href="@Url.Action("Create")" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold text-sm transition-all shadow-sm">
                    <span class="material-symbols-outlined text-sm">add</span>
                    Thêm mới
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@TempData["Success"]</span>
        </div>
    }

    <!-- Main Content -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="optionsTable">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider">Sản phẩm</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider">Nhóm tùy chọn</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider">Tên tùy chọn</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider text-right">Giá phụ thêm</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider text-center">Thứ tự</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider text-center">Trạng thái</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-800 uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-orange-50/30 transition-colors">
                            <td class="px-6 py-4 align-middle">
                                <span class="font-bold text-gray-900 line-clamp-2">@(item.Product?.Name ?? "N/A")</span>
                            </td>
                            <td class="px-6 py-4 align-middle">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    @item.GroupName
                                </span>
                            </td>
                            <td class="px-6 py-4 align-middle text-gray-700 font-medium">
                                @item.OptionName
                            </td>
                            <td class="px-6 py-4 align-middle text-right font-medium text-emerald-600">
                                @if (item.AdditionalPrice > 0)
                                {
                                    <span>+@item.AdditionalPrice.ToString("N0")đ</span>
                                }
                                else if (item.AdditionalPrice < 0)
                                {
                                    <span class="text-red-500">@item.AdditionalPrice.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">0đ</span>
                                }
                            </td>
                            <td class="px-6 py-4 align-middle text-center text-gray-500">
                                @item.DisplayOrder
                            </td>
                            <td class="px-6 py-4 align-middle text-center">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                        Hiệu lực
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                        Đã tắt
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 align-middle text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="@Url.Action("Edit", new { id = item.ProductOptionId })" class="p-1 px-2 text-amber-700 bg-amber-100 hover:bg-amber-200 border border-amber-300 rounded text-xs font-bold uppercase transition-colors" title="Sửa">
                                        Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.ProductOptionId" method="post" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cấu hình này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1 px-2 text-red-700 bg-red-100 hover:bg-red-200 border border-red-300 rounded text-xs font-bold uppercase transition-colors" title="Xóa">
                                            Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300 inline-block">tune</span>
                                <p>Chưa có cấu hình sản phẩm nào. Hãy bấm "Thêm mới" để tạo một cấu hình.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
