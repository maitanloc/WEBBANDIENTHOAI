@model IEnumerable<WEBBANDIENTHOAI.Models.Customer>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý Khách hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
}

<div class="category-management">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Quản lý Khách hàng</h1>
                <p class="text-sm text-gray-500 mt-1">Quản lý và theo dõi thông tin khách hàng của bạn.</p>
            </div>
            
            <div class="relative group">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-emerald-500 transition-colors">search</span>
                <input type="text" id="searchInput" 
                       class="w-full md:w-64 pl-10 pr-4 py-2 bg-transparent border-b border-gray-300 focus:outline-none focus:border-emerald-500 transition-all text-black"
                       placeholder="Tìm kiếm khách hàng..." />
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="bg-white border border-gray-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-300" id="customersTable">
                <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider w-12 text-center border-r border-gray-300">
                            <input class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-gray-400 cursor-pointer" type="checkbox" id="selectAll" />
                        </th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Mã KH</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Họ và tên</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Email</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Số điện thoại</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Địa chỉ</th>
                        <th class="px-4 py-3 text-xs font-bold text-black uppercase tracking-wider border-r border-gray-300">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    @foreach (var item in Model)
                    {
                        <tr class="customer-row border-b border-gray-300 hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3 text-center border-r border-gray-300">
                                <input class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-gray-400 cursor-pointer customer-checkbox" type="checkbox" value="@item.CustomerId" />
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <span class="font-bold text-black">#KH@item.CustomerId</span>
                            </td>
                            <td class="px-4 py-3 text-black font-medium border-r border-gray-300">
                                @item.FullName
                            </td>
                            <td class="px-4 py-3 text-black text-sm border-r border-gray-300 max-w-xs truncate">
                                @item.Email
                            </td>
                            <td class="px-4 py-3 text-black text-sm border-r border-gray-300">
                                @item.Phone
                            </td>
                            <td class="px-4 py-3 text-black text-sm border-r border-gray-300 max-w-xs truncate">
                                @(item.Address ?? "-")
                            </td>
                            <td class="px-4 py-3 border-r border-gray-300">
                                <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full
                                           @(item.IsActive ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                    @(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-12 text-center text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">person</span>
                                <p>Chưa có khách hàng nào được tạo.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Tìm kiếm khách hàng
        $('#searchInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.customer-row').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    </script>
}
