@model List<WEBBANDIENTHOAI.Models.Customer>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
    }
</style>

<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary": "#f48c25",
              "background-light": "#f8f7f5",
              "background-dark": "#221910",
              "primary-darker": "#1F2937",
              "secondary-text": "#6B7280",
            },
            fontFamily: { "display": ["Inter", "sans-serif"] },
          }
        }
    }
</script>

<div class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-background-dark overflow-x-hidden">
    <div class="flex min-h-screen">
        <main class="flex-1 p-8 w-full">

            <div class="layout-content-container flex flex-col w-full">

                <!-- HEADER -->
                <header class="flex flex-wrap justify-between items-center gap-4 mb-6">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center rounded-lg bg-primary/20 size-12">
                            <span class="material-symbols-outlined text-primary text-3xl">storefront</span>
                        </div>
                        <p class="text-primary-darker dark:text-white text-4xl font-black">
                            Quản lý khách hàng
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <button class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700">
                            <span class="material-symbols-outlined">notifications</span>
                        </button>
                        <button class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700">
                            <span class="material-symbols-outlined">settings</span>
                        </button>
                        <div class="bg-center bg-no-repeat bg-cover rounded-full size-10 ml-2"
                             style='background-image: url("https://i.pravatar.cc/300");'></div>
                    </div>
                </header>

                <!-- SEARCH -->
                <div class="flex justify-between items-center gap-4 mb-6 bg-white p-4 rounded-xl shadow-sm">
                    <div class="flex-1">
                        <label class="flex flex-col w-full">
                            <div class="flex w-full items-stretch rounded-lg h-12">
                                <div class="text-secondary-text flex bg-background-light items-center justify-center pl-4 rounded-l-lg">
                                    <span class="material-symbols-outlined">search</span>
                                </div>
                                <input class="form-input flex w-full rounded-r-lg text-primary-darker border-none
                                    bg-background-light h-full px-4 text-base"
                                       placeholder="Tìm kiếm theo tên, CCCD hoặc số điện thoại..." />
                            </div>
                        </label>
                    </div>

                    <div>
                        <button class="flex items-center rounded-lg h-12 px-4 bg-gray-200 text-primary-darker gap-2 text-sm font-bold">
                            <span class="material-symbols-outlined text-lg">filter_list</span>
                            Bộ lọc
                        </button>
                    </div>
                </div>

                <!-- TABLE -->
                <div class="bg-white p-6 rounded-xl shadow-sm">

                    <h2 class="text-xl font-bold mb-6 text-primary-darker">Danh sách khách hàng</h2>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-background-light">
                                    <th class="p-4 text-sm font-bold text-primary-darker">Mã khách hàng</th>
                                    <th class="p-4 text-sm font-bold text-primary-darker">Họ và tên</th>
                                    <th class="p-4 text-sm font-bold text-primary-darker">Email</th>
                                    <th class="p-4 text-sm font-bold text-primary-darker">Số điện thoại</th>
                                    <th class="p-4 text-sm font-bold text-primary-darker">Địa chỉ</th>
                                    <th class="p-4 text-sm font-bold text-primary-darker">Trạng thái</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr class="border-b border-gray-200">
                                        <td class="p-4 text-sm text-secondary-text">KH@c.CustomerId</td>
                                        <td class="p-4 text-sm font-medium text-primary-darker">@c.FullName</td>
                                        <td class="p-4 text-sm text-secondary-text">@c.Email</td>
                                        <td class="p-4 text-sm text-secondary-text">@c.Phone</td>
                                        <td class="p-4 text-sm text-secondary-text">@c.Address</td>

                                        <td class="p-4 text-sm">
                                            @if (c.IsActive)
                                            {
                                                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    Đang hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                    Ngừng hoạt động
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </main>
    </div>
</div>
