@model IEnumerable<WEBBANDIENTHOAI.Models.Product>

@if (TempData["Success"] != null)
{
    <div id="panel-tempdata-alert"><div class="rounded-md bg-green-50 p-3 text-green-700">@TempData["Success"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div id="panel-tempdata-alert"><div class="rounded-md bg-red-50 p-3 text-red-700">@TempData["Error"]</div></div>
}

<div class="panel-inner">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold">Danh sách sản phẩm</h2>
        <div><a href="@Url.Action("Index","Products")" class="text-sm text-gray-500">Mở trang đầy đủ</a></div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            @foreach (var p in Model)
            {
                <div class="border rounded-lg overflow-hidden bg-white">
                    <a href="@Url.Action("Details","Products", new { id = p.ProductId })" class="panel-link" data-url="@Url.Action("Details","Products", new { id = p.ProductId })">
                        <img src="@(p.PrimaryImage != null ? Url.Action("Image","Products", new { id = p.PrimaryImage.ImageId }) : Url.Content("~/images/placeholder.png"))"
                             alt="@p.Name" class="w-full h-44 object-cover" loading="lazy" />
                    </a>
                    <div class="p-3">
                        <a href="@Url.Action("Details","Products", new { id = p.ProductId })" class="panel-link font-semibold" data-url="@Url.Action("Details","Products", new { id = p.ProductId })">@p.Name</a>
                        <div class="text-sm text-gray-500">@p.Brand</div>
                        <div class="mt-2 flex items-baseline justify-between">
                            <div class="text-lg font-bold">@p.Price.ToString("N0") đ</div>
                            <div>
                                <span class="px-2 py-1 rounded text-xs @( (p.StatusId == 1) ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                    @(p.ProductStatus?.StatusName ?? "Không rõ")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-6 text-center bg-white border rounded">
            <div class="text-gray-600">Không có sản phẩm.</div>
        </div>
    }
</div>

<script>
    // no-op inline script (kept light) - admin-panel-loader executes it
    (function () {
        // nothing heavy here
    })();
</script>
