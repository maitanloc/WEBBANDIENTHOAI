@model WEBBANDIENTHOAI.Models.Product

@if (TempData["Success"] != null)
{
    <div id="panel-tempdata-alert"><div class="rounded-md bg-green-50 p-3 text-green-700">@TempData["Success"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div id="panel-tempdata-alert"><div class="rounded-md bg-red-50 p-3 text-red-700">@TempData["Error"]</div></div>
}

<div class="panel-inner space-y-4">
    <a class="text-sm text-gray-500 panel-link" data-url="@Url.Action("Index","Products")" href="@Url.Action("Index","Products")">&larr; Quay lại</a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-white p-4 rounded-lg border">
        <div>
            <img id="mainProductImage" class="w-full h-96 object-contain bg-gray-50 p-4" src="@(Model.PrimaryImage != null ? Url.Action("Image","Products", new { id = Model.PrimaryImage.ImageId }) : Url.Content("~/images/placeholder.png"))" alt="@Model.Name" />
            <div class="mt-3 flex gap-2">
                @foreach (var img in Model.Images ?? new List<WEBBANDIENTHOAI.Models.ProductImage>())
                {
                    <button type="button" class="thumb-btn" data-src="@Url.Action("Image","Products", new { id = img.ImageId })" aria-label="Xem ảnh">
                        <img src="@Url.Action("Image","Products", new { id = img.ImageId })" class="w-20 h-20 object-cover rounded" alt="thumb" />
                    </button>
                }
            </div>
        </div>

        <div>
            <h2 class="text-2xl font-bold">@Model.Name</h2>
            <div class="text-sm text-gray-500 mt-1">SKU: @Model.SKU • Mã kho: @Model.StockCode</div>

            <div class="mt-4">
                <div class="text-2xl font-extrabold">@Model.Price.ToString("N0") đ</div>
                @if (Model.OldPrice.HasValue)
                {
                    <div class="text-sm line-through text-gray-400">@Model.OldPrice.Value.ToString("N0") đ</div>
                }
            </div>

            <div class="mt-4 text-gray-700">
                <h4 class="font-medium">Mô tả</h4>
                <div class="prose max-w-none">@Html.Raw(Model.ShortDescription ?? "<i>Không có mô tả</i>")</div>
            </div>

            <div class="mt-6 flex gap-3">
                <button class="btn btn-disabled" disabled>Thêm vào giỏ (demo)</button>
                <a class="text-sm text-gray-600" href="#">Báo lỗi / Yêu cầu</a>
            </div>
        </div>
    </div>
</div>

<script>
  (function () {
    const root = document.getElementById('panel-root');
    if (!root) return;
    root.querySelectorAll('.thumb-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        const src = btn.getAttribute('data-src');
        const main = document.getElementById('mainProductImage');
        if (src && main) main.src = src;
      });
    });
  })();
</script>
